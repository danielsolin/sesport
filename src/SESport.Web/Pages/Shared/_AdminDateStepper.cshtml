<div class="admin-date-stepper" data-admin-date-stepper>
   <button class="admin-date-stepper-button"
           type="button"
           data-admin-date-step="-1"
           aria-label="Previous day">
      &lt;&lt;
   </button>
   <button class="admin-date-stepper-button admin-date-stepper-clear"
           type="button"
           data-admin-date-clear
           aria-label="Clear date">
      clear
   </button>
   <button class="admin-date-stepper-button"
           type="button"
           data-admin-date-step="1"
           aria-label="Next day">
      &gt;&gt;
   </button>
</div>
