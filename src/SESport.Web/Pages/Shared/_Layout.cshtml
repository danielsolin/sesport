@{
   var requestPath = ViewContext.HttpContext.Request.Path.Value ?? "";
   var selectedDate = ViewContext.HttpContext.Request.Query[
      RouteKeys.Date
   ].ToString();
   var dateRouteValues = string.IsNullOrWhiteSpace(selectedDate)
      ? null
      : new Dictionary<string, string?>
      {
         [RouteKeys.Date] = selectedDate
      };
   var broadcastsHref = Url.Page(
      "/Admin/Broadcasts/Index",
      dateRouteValues
   ) ?? "/Admin/Broadcasts";
   var activitiesHref = Url.Page(
      "/Admin/Activities/Index",
      dateRouteValues
   ) ?? "/Admin/Activities";
   var isAdmin = requestPath.StartsWith(
      "/Admin",
      StringComparison.OrdinalIgnoreCase
   );
   var isRuns = requestPath.StartsWith(
      "/Admin/Runs",
      StringComparison.OrdinalIgnoreCase
   );
   var isBroadcasts = requestPath.StartsWith(
      "/Admin/Broadcasts",
      StringComparison.OrdinalIgnoreCase
   );
   var isActivities = requestPath.StartsWith(
      "/Admin/Activities",
      StringComparison.OrdinalIgnoreCase
   ) && !requestPath.StartsWith(
      "/Admin/Activities/Proposal",
      StringComparison.OrdinalIgnoreCase
   );
   var isEntities = requestPath.StartsWith(
      "/Admin/Entities",
      StringComparison.OrdinalIgnoreCase
   );
   var isActivityProposals = requestPath.StartsWith(
      "/Admin/Activities/Proposal",
      StringComparison.OrdinalIgnoreCase
   );
   var isConfig = requestPath.StartsWith(
      "/Admin/Config",
      StringComparison.OrdinalIgnoreCase
   );
   var adminMenuLink = "admin-top-menu-link";
   var runsClass = isRuns
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var broadcastsClass = isBroadcasts
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var activitiesClass = isActivities
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var entitiesClass = isEntities
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var configClass = isConfig
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
}
<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="utf-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   <title>@ViewData["Title"] - sesport</title>
   <script type="importmap"></script>
   <link rel="stylesheet"
         href="~/vendor/multi-select-dropdown-js/MultiSelect.min.css"
         asp-append-version="true" />
   <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   @if(!isAdmin)
   {
      <link rel="stylesheet"
            href="~/css/public.css"
            asp-append-version="true" />
   }
</head>
<body>
   <header class="site-header">
      <div class="site-header-main">
         <a class="brand" asp-page="/Index">sesport</a>
         @if(isAdmin)
         {
            <nav class="admin-top-menu" aria-label="Admin sections">
               <a class="@broadcastsClass"
                  href="@broadcastsHref">
                  Broadcasts
               </a>
               <a class="@activitiesClass"
                  href="@activitiesHref">
                  Activities
               </a>
               <a class="@entitiesClass"
                  asp-page="/Admin/Entities/Index">
                  Entities
               </a>
               <a class="@runsClass"
                  asp-page="/Admin/Runs/Index">
                  Runs
               </a>
               <a class="@configClass"
                  asp-page="/Admin/Config/Index">
                  Config
               </a>
            </nav>
         }
      </div>
      @if(isAdmin)
      {
         <nav class="site-nav">
            <a asp-page="/Index">Public</a>
            <a href="@broadcastsHref">Admin</a>
         </nav> 
      }
   </header>

   <main class="page-shell">
      @RenderBody()
   </main>

   @await RenderSectionAsync("Scripts", required: false)
   <script src="~/vendor/multi-select-dropdown-js/MultiSelect.min.js"
           asp-append-version="true"></script>
   <script src="~/js/broadcast-inline-edit.js"
           asp-append-version="true"></script>
   <script src="~/js/broadcast-organization-autocomplete.js"
           asp-append-version="true"></script>
   <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
