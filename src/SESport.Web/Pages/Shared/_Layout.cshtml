@{
   var requestPath = ViewContext.HttpContext.Request.Path.Value ?? "";
   var pageTitle = (ViewData["Title"] as string ?? string.Empty).Trim();
   var isRuns = requestPath.StartsWith(
      "/Admin/Runs",
      StringComparison.OrdinalIgnoreCase
   );
   var isMembers = requestPath.StartsWith(
      "/Admin/Members",
      StringComparison.OrdinalIgnoreCase
   );
   var isDashboard = requestPath.StartsWith(
      "/Admin/Dashboard",
      StringComparison.OrdinalIgnoreCase
   );
   var isBroadcasts = requestPath.StartsWith(
      "/Admin/Broadcasts",
      StringComparison.OrdinalIgnoreCase
   );
   var isActivities = requestPath.StartsWith(
      "/Admin/Activities",
      StringComparison.OrdinalIgnoreCase
   );
   var broadcastsHref = Url.Page(
      "/Admin/Broadcasts/Index"
   ) ?? "/Admin/Broadcasts";
   var dashboardHref = Url.Page(
      "/Admin/Dashboard/Index"
   ) ?? "/Admin/Dashboard";
   var activitiesHref = Url.Page(
      "/Admin/Activities/Index"
   ) ?? "/Admin/Activities";
   var isAdmin = requestPath.StartsWith(
      "/Admin",
      StringComparison.OrdinalIgnoreCase
   );
   var htmlLanguage = isAdmin ? "en" : "sv";
   var isMember = Context.User.Claims.Any(claim =>
      claim.Type == MemberClaimTypes.MemberId &&
      !string.IsNullOrWhiteSpace(claim.Value)
   );
   var isPublicIndex = requestPath == "/" ||
      requestPath.Equals("/Index", StringComparison.OrdinalIgnoreCase);
   var isPublicWatchedIndex = requestPath.Equals(
      PublicRoutePaths.Watched,
      StringComparison.OrdinalIgnoreCase
   );
   var isPublicStatistics = requestPath.Equals(
      PublicRoutePaths.Statistics,
      StringComparison.OrdinalIgnoreCase
   );
   var isPublicWatches = requestPath.Equals(
      PublicRoutePaths.Settings,
      StringComparison.OrdinalIgnoreCase
   );
   var isPublicLogin = requestPath.Equals(
      "/login",
      StringComparison.OrdinalIgnoreCase
   );
   var isPublicAbout = requestPath.Equals(
      "/om",
      StringComparison.OrdinalIgnoreCase
   );
   var publicScheduleHref = isPublicIndex
      ? PublicRoutePaths.Home + Context.Request.QueryString.Value
      : PublicFilterPreferenceStore.ReadScheduleUrl(
         Context.Request
      ) ?? PublicRoutePaths.Home;
   var publicWatchedHref = isPublicWatchedIndex
      ? PublicRoutePaths.Watched + Context.Request.QueryString.Value
      : PublicFilterPreferenceStore.ReadWatchedUrl(
         Context.Request
      ) ?? PublicRoutePaths.Watched;
   var publicStatisticsHref = isPublicStatistics
      ? PublicRoutePaths.Statistics + Context.Request.QueryString.Value
      : PublicFilterPreferenceStore.ReadStatisticsUrl(
         Context.Request
      ) ?? PublicRoutePaths.Statistics;
   var publicBrandHref = isPublicWatchedIndex
      ? publicWatchedHref
      : publicScheduleHref;
   var isEntities = requestPath.StartsWith(
      "/Admin/Entities",
      StringComparison.OrdinalIgnoreCase
   );
   var isConfig = requestPath.StartsWith(
      "/Admin/Config",
      StringComparison.OrdinalIgnoreCase
   );
   var adminMenuLink = "admin-top-menu-link";
   var dashboardClass = isDashboard
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var runsClass = isRuns
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var membersClass = isMembers
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var broadcastsClass = isBroadcasts
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var activitiesClass = isActivities
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var entitiesClass = isEntities
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var configClass = isConfig
      ? $"{adminMenuLink} is-active"
      : adminMenuLink;
   var publicStatisticsClass = isPublicStatistics
      ? "public-member-link is-active"
      : "public-member-link";
   var publicScheduleClass = isPublicIndex
      ? "public-member-link is-active"
      : "public-member-link";
   var publicWatchedIndexClass = isPublicWatchedIndex
      ? "public-member-link is-active"
      : "public-member-link";
   var publicWatchesClass = isPublicWatches
      ? "public-member-link is-active"
      : "public-member-link";
   var publicLoginClass = isPublicLogin
      ? "public-member-link is-active"
      : "public-member-link";
   var publicAboutClass = isPublicAbout
      ? "public-member-link is-active"
      : "public-member-link";
}
<!DOCTYPE html>
<html lang="@htmlLanguage">
<head>
   <meta charset="utf-8" />
   <meta name="viewport"
         content="width=device-width, initial-scale=1.0,
            viewport-fit=cover" />
   <script type="importmap"></script>
   @if(IsSectionDefined("Head"))
   {
      @RenderSection("Head", required: false)
   }
   else
   {
      <title>@(string.IsNullOrWhiteSpace(pageTitle)
         ? "sesport"
         : $"{pageTitle} - sesport")</title>
   }
   <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
   <link rel="icon" href="~/favicon-32x32.png"
         sizes="32x32" type="image/png" />
   <link rel="icon" href="~/favicon-16x16.png"
         sizes="16x16" type="image/png" />
   <link rel="apple-touch-icon"
         href="~/apple-touch-icon.png"
         sizes="180x180" />
   <link rel="manifest" href="~/site.webmanifest" />
   <meta name="theme-color" content="#006aa8" />
   @if(isAdmin)
   {
      <link rel="stylesheet"
            href="~/Admin/vendor/multi-select-dropdown-js/MultiSelect.min.css"
            asp-append-version="true" />
   }
   <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   @if(!isAdmin)
   {
      <link rel="stylesheet"
            href="~/css/public.css"
            asp-append-version="true" />

   }
</head>
<body data-member-authenticated="@(isMember ? "true" : "false")">
   <header class="site-header">
      <div class="site-header-main">
         <a class="brand" href="@publicBrandHref">sesport</a>
         @if(isAdmin)
         {
            <nav class="admin-top-menu" aria-label="Admin sections">
               <a class="@dashboardClass"
                  href="@dashboardHref">
                  Dashboard
               </a>
               <a class="@broadcastsClass"
                  href="@broadcastsHref">
                  Broadcasts
               </a>
               <a class="@activitiesClass"
                  href="@activitiesHref">
                  Activities
               </a>
               <a class="@entitiesClass"
                  asp-page="/Admin/Entities/Index">
                  Entities
               </a>
               <a class="@runsClass"
                  asp-page="/Admin/Runs/Index">
                  Runs
               </a>
               <a class="@membersClass"
                  asp-page="/Admin/Members/Index">
                  Members
               </a>
               <a class="@configClass"
                  asp-page="/Admin/Config/Index">
                  Config
               </a>
            </nav>
         }
         else
         {
            <div class="public-header-actions">
               <div class="public-header-primary-links">
                  <a class="@publicScheduleClass"
                     href="@publicScheduleHref"
                     aria-current="@(
                        isPublicIndex ? "page" : null
                     )">
                     TABLÅ
                  </a>
                  <a class="@publicWatchedIndexClass"
                     href="@publicWatchedHref"
                     aria-current="@(
                        isPublicWatchedIndex ? "page" : null
                     )">
                     BEVAKNINGAR
                  </a>
               </div>
               <details class="public-header-secondary-menu"
                        data-public-header-menu>
                  <summary class="public-header-menu-toggle">
                     MENY
                  </summary>
                  <div class="public-header-secondary-links">
                     <a class="@publicStatisticsClass"
                        href="@publicStatisticsHref"
                        aria-current="@(
                           isPublicStatistics ? "page" : null
                        )">
                        STATISTIK
                     </a>
                     @if(isMember)
                     {
                        <a class="@publicWatchesClass"
                           asp-page="/Account/Watches"
                           aria-current="@(
                              isPublicWatches ? "page" : null
                           )">
                           INSTÄLLNINGAR
                        </a>
                     }
                     else
                     {
                        <a class="@publicLoginClass"
                           asp-page="/Account/Login"
                           aria-current="@(
                              isPublicLogin ? "page" : null
                           )">
                           Logga in
                        </a>
                     }
                     <a class="@publicAboutClass"
                        href="/om"
                        aria-label="Om sesport"
                        aria-current="@(
                           isPublicAbout ? "page" : null
                     )">
                        Om sesport
                     </a>
                  </div>
               </details>
            </div>
         }
      </div>
      @if(isAdmin)
      {
         <nav class="site-nav">
            <a asp-page="/Index">Public</a>
            <a href="@dashboardHref">Admin</a>
         </nav> 
      }
   </header>

   <main class="page-shell">
      @RenderBody()
   </main>

<script src="~/Admin/js/partial-loader.js"
        asp-append-version="true"></script>
   @if(!isAdmin)
   {
      <script src="~/js/public-header-menu.js"
              asp-append-version="true"></script>
   }
   @await RenderSectionAsync("Scripts", required: false)
   @if(isAdmin)
   {
      <script src="~/Admin/vendor/multi-select-dropdown-js/MultiSelect.min.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/broadcast-inline-edit.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/broadcast-organization-autocomplete.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/broadcast-activity-group-autocomplete.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-shared.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-forms.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-activity-ai.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-broadcasts.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-runs.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/admin-entities.js"
              asp-append-version="true"></script>
      <script src="~/Admin/js/site.js"
              asp-append-version="true"></script>
   }
   else
   {
      <script src="~/js/site.js" asp-append-version="true"></script>
   }
</body>
</html>
