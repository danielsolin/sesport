@page "/statistik"
@model StatisticsModel
@{
   var selectedMonthOption = Model.MonthOptions.FirstOrDefault(
      option => option.IsSelected
   );
}
@section Head {
   <title>
      Månadens mesta utövare – @Model.SelectedMonthLabel – sesport
   </title>
   <link rel="canonical" href="@Model.CanonicalUrl" />
   @if(Model.ShouldNoIndex)
   {
      <meta name="robots" content="noindex,follow" />
   }
   <meta name="description"
         content="Månadens mesta svenska utövare i internationell sport." />
}

<section class="page-heading statistics-heading">
   <div class="statistics-heading-controls">
      <div class="date-select statistics-month-select">
         <div class="date-dropdown" data-date-dropdown>
            <button class="date-dropdown-toggle"
                    type="button"
                    aria-label="Välj månad"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="statistics-month-menu"
                    data-date-dropdown-toggle>
               <span class="date-option-content">
                  <span class="date-option-label">
                     <span class="date-option-date">
                        @(selectedMonthOption?.Label ??
                           Model.SelectedMonthLabel)
                     </span>
                  </span>
               </span>
               <span class="date-dropdown-chevron"
                     aria-hidden="true"></span>
            </button>
            <div id="statistics-month-menu"
                 class="date-dropdown-menu statistics-month-menu"
                 role="listbox"
                 aria-label="Månad"
                 hidden
                 data-date-dropdown-menu>
               @foreach(var month in Model.MonthOptions)
               {
                  <a class="date-dropdown-option
                     @(month.IsSelected ? "is-selected" : "")"
                     asp-page="/Statistics"
                     asp-route-month="@month.Value"
                     asp-route-sport="@Model.Sport"
                     role="option"
                     aria-selected="@(
                        month.IsSelected ? "true" : "false"
                     )">
                     <span class="date-option-content">
                        <span class="date-option-label">
                           @month.Label
                        </span>
                     </span>
                  </a>
               }
            </div>
         </div>
      </div>

      <div class="sport-select statistics-sport-select"
           data-sport-dropdown>
         <button class="sport-dropdown-toggle"
                 type="button"
                 aria-label="Välj sport"
                 aria-haspopup="true"
                 aria-expanded="false"
                 aria-controls="statistics-sport-dropdown-menu"
                 data-sport-dropdown-toggle>
            <span class="sport-option-content">
               <span class="sport-option-name">
                  @Model.SelectedSportLabel:
               </span>
               <span class="sport-option-count">
                  @Model.SelectedSportParticipantCount
               </span>
            </span>
            <span class="sport-dropdown-chevron"
                  aria-hidden="true"></span>
         </button>
         <div id="statistics-sport-dropdown-menu"
              class="sport-dropdown-menu"
              aria-label="Sportfilter"
              data-sport-dropdown-menu>
            <div class="index-participants">
               <a class="index-participants-info
                  index-participants-filter
                  @(Model.Sport is null ? "is-selected" : "")"
                  asp-page="/Statistics"
                  asp-route-month="@Model.SelectedMonthValue"
                  asp-route-sport="@string.Empty"
                  aria-current="@(
                     Model.Sport is null ? "true" : null
                  )"
                  aria-label="Visa alla sporter">
                  <span>Svenskar:</span>
                  <span class="index-participants-count
                     index-participants-value">
                     @Model.TotalParticipantCount
                  </span>
               </a>
            </div>
            @foreach(var sport in Model.SportOptions)
            {
               var isSelected = string.Equals(
                  Model.Sport,
                  sport.SportId,
                  StringComparison.OrdinalIgnoreCase
               );
               <div class="index-participants">
                  <a class="index-participants-info
                     index-participants-filter
                     @(isSelected ? "is-selected" : "")"
                     asp-page="/Statistics"
                     asp-route-month="@Model.SelectedMonthValue"
                     asp-route-sport="@sport.SportId"
                     aria-current="@(isSelected ? "true" : null)"
                     aria-label="Visa endast @sport.SportName">
                     <span>@sport.SportName:</span>
                     <span class="index-participants-count
                        index-participants-value">
                        @sport.ParticipantCount
                     </span>
                  </a>
               </div>
            }
         </div>
      </div>
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning statistics-notice">
      Ett problem uppstod. Vänligen försök igen.
   </div>
}
else if(Model.Statistics is not null)
{
   <section class="statistics-page"
            aria-label="Månadens mest aktiva">
      <div class="statistics-card-heading">
         <div class="statistics-participant-count">
            <span>MÅNADENS MEST AKTIVA AV TOTALT</span>
            <strong>@Model.SelectedSportParticipantCount</strong>
         </div>
      </div>

      @if(Model.Statistics.Leaders.Count == 0)
      {
         <div class="notice">
            Det finns ingen publicerad statistik för vald månad.
         </div>
      }
      else
      {
         <div class="statistics-table-wrap">
            <table class="statistics-table">
               <thead>
                  <tr>
                     <th scope="col">Plats</th>
                     <th scope="col">Utövare</th>
                     <th scope="col">Sport</th>
                     <th scope="col">Dagar aktiv</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach(var leader in Model.Statistics.Leaders)
                  {
                     <tr>
                        <td class="statistics-rank">@leader.Rank</td>
                        <th scope="row">@leader.Name</th>
                        <td>@leader.SportNames</td>
                        <td class="statistics-points">
                           @leader.Points
                        </td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      }
   </section>
}

@section Scripts {
   <script src="~/js/public-date-select.js"
           asp-append-version="true"></script>
   <script src="~/js/public-sport-select.js"
           asp-append-version="true"></script>
}
