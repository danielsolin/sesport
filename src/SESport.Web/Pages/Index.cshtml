@page
@model IndexModel
@{
   const string PageDescription =
      "TV-sändningar med svenskar som tävlar internationellt, " +
      "både individuellt och i lag.";
}
@section Head {
   <title>sesport</title>
   <meta name="description"
         content="@PageDescription" />
   <meta property="og:title" content="sesport" />
   <meta property="og:description"
         content="@PageDescription" />
   <meta name="twitter:title" content="sesport" />
   <meta name="twitter:description"
         content="@PageDescription" />
}

<section class="page-heading index-heading">
   <div class="index-heading-left">
      <div class="date-select">
         <div class="date-select-control">
            <form method="get">
               @if(!string.IsNullOrWhiteSpace(Model.Sport))
               {
                  <input type="hidden"
                         name="@RouteKeys.Sport"
                         value="@Model.Sport" />
               }
               <select id="date-select-input"
                       class="date-select-input"
                       name="@RouteKeys.Date"
                       aria-label="Date"
                       onchange="this.form.submit();">
                  @foreach(var dateOption in Model.DateOptions)
                  {
                     <option value="@dateOption.Value"
                             selected="@(
                                dateOption.IsSelected
                                   ? "selected"
                                   : null
                             )">
                        @dateOption.Label
                     </option>
                  }
               </select>
            </form>
         </div>
      </div>
      @if(Model.TotalParticipantsCount is not null)
      {
         <div class="index-participants">
            <a class="index-participants-info
               index-participants-filter
               @(Model.Sport is null ? "is-selected" : "")"
               asp-page="/Index"
               asp-route-date="@DateDisplay.Format(Model.SelectedDate)"
               aria-current="@(Model.Sport is null ? "true" : null)"
               aria-label="Visa alla sporter">
               <span>Svenskar:</span>
               <span class="index-participants-count
                  index-participants-value">
                  @Model.TotalParticipantsCount
               </span>
            </a>
         </div>
         @foreach(var sport in Model.SportParticipantCounts)
         {
            <div class="index-participants">
               <a class="index-participants-info
                  index-participants-filter
                  @(string.Equals(
                     Model.Sport,
                     sport.SportId,
                     StringComparison.OrdinalIgnoreCase
                  ) ? "is-selected" : "")"
                  asp-page="/Index"
                  asp-route-date="@DateDisplay.Format(Model.SelectedDate)"
                  asp-route-sport="@sport.SportId"
                  aria-current="@(
                     string.Equals(
                        Model.Sport,
                        sport.SportId,
                        StringComparison.OrdinalIgnoreCase
                     ) ? "true" : null
                  )"
                  aria-label="Visa endast @sport.SportName">
                  <span>@sport.SportName:</span>
                  <span class="index-participants-count
                     index-participants-value">
                     @sport.ParticipantCount
                  </span>
               </a>
            </div>
         }
      }
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @(Model.ShowLoadErrorDetails
         ? Model.LoadError
         : "Ett problem uppstod. Vänligen försök igen.")
   </div>
}
else if(Model.TimelineEntries.Count == 0 &&
   Model.UntimedActivities.Count == 0)
{
   <div class="notice">
      @(
         "Vi har inte lyckats identifiera några internationellt " +
         "sportande svenskar på valt datum... :-("
      )
   </div>
}
else
{
   <div class="activity-agenda">
      @foreach(var timelineEntry in Model.TimelineEntries)
      {
         var agendaSection = timelineEntry.Section;
         var activity = agendaSection.Activities[0];
         var isGrouped = agendaSection.ActivityGroupTitle is not null;
         var tvChannels = agendaSection.Activities
            .SelectMany(item => (item.TvChannelName ?? string.Empty).Split(
               ',',
               StringSplitOptions.TrimEntries |
                  StringSplitOptions.RemoveEmptyEntries
            ))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
         var dayPhaseClass = agendaSection.DayPhase switch
         {
            ActivityDayPhase.Morning =>
               "activity-day-phase-morning",
            ActivityDayPhase.Day => "activity-day-phase-day",
            ActivityDayPhase.Evening =>
               "activity-day-phase-evening",
            _ => "activity-day-phase-night"
         };
         var timingClass = agendaSection.IsOngoing
            ? "activity-is-ongoing"
            : agendaSection.HasEnded
               ? "activity-has-ended"
               : "activity-is-upcoming";

         <section class="activity-agenda-section
                            @dayPhaseClass
                            @timingClass
                            @(isGrouped
                               ? "activity-agenda-section-grouped"
                               : "")">
               <div class="activity-agenda-time">
                  @if(isGrouped)
                  {
                     var timelineSlot = agendaSection.TimelineSlot;
                     <div class="activity-group-time-item
                        @(timelineSlot.IsOngoing ? "is-ongoing" : "")
                        @(timelineSlot.HasEnded ? "has-ended" : "")">
                        <div class="activity-time-badge">
                           <time class="activity-time-value">
                              @timelineSlot.TimeLabel
                           </time>
                        </div>
                        <span class="activity-time-connector"
                              aria-hidden="true">
                           <span class="activity-time-point"></span>
                        </span>
                     </div>
                  }
                  else
                  {
                     <div class="activity-time-row">
                        <div class="activity-time-badge">
                           <time class="activity-time-value">
                              @agendaSection.TimeLabel
                           </time>
                        </div>
                        <span class="activity-time-connector"
                              aria-hidden="true">
                           <span class="activity-time-point"></span>
                        </span>
                     </div>
                  }
                  <div class="activity-analog-clock"
                       style="--clock-hour-angle:
                                 @agendaSection.ClockHourAngle;
                              --clock-minute-angle:
                                 @agendaSection.ClockMinuteAngle;"
                       aria-hidden="true">
                     <span class="activity-clock-hour-hand"></span>
                     <span class="activity-clock-minute-hand"></span>
                     <span class="activity-clock-center"></span>
                  </div>
                  @if(tvChannels.Count > 0)
                  {
                     <div class="activity-channel-list
                        activity-time-channel-list"
                        aria-label="TV-kanaler">
                        @foreach(var channel in tvChannels)
                        {
                           <span class="activity-channel-chip">
                              @channel
                           </span>
                        }
                     </div>
                  }
               </div>
               @if(!isGrouped && agendaSection.EndTimeLabel is not null)
               {
                  <div class="activity-duration-rail"
                       aria-label=
                          "Slutar @agendaSection.EndTimeLabel">
                     <span class="activity-duration-line"></span>
                     <span class="activity-duration-end-point"></span>
                     <time class="activity-duration-end-time">
                        @agendaSection.EndTimeLabel
                     </time>
                  </div>
               }
               <div class="activity-agenda-items">
                  <article class="activity-entry">
                     @if(agendaSection.IsOngoing)
                     {
                        <span class="activity-ongoing-badge">
                           Pågår
                        </span>
                     }
                     @if(activity.SportIconPath is not null)
                     {
                        <span class="activity-entry-sport-icon"
                              role="img"
                              aria-label="@activity.SportName"
                              style="--sport-icon-url:
                                        url('@activity.SportIconPath');">
                        </span>
                     }
                     <h3 class="activity-entry-organization">
                        #@(string.IsNullOrEmpty(
                           activity.RelatedOrganizationEntities)
                           ? string.Empty
                           : $"{activity.RelatedOrganizationEntities} ")
                     </h3>
                     <h2 class="activity-entry-title">
                        @(agendaSection.ActivityGroupTitle ?? activity.Title)
                     </h2>
                     @if(isGrouped)
                     {
                        <ol class="activity-group-schedule">
                           @foreach(var slot in agendaSection.Slots)
                           {
                              <li class="activity-group-schedule-item
                                 @(slot.IsOngoing ? "is-ongoing" : "")
                                 @(slot.HasEnded ? "has-ended" : "")">
                                 <span class="activity-group-slot-time">
                                    @slot.TimeLabel@(
                                       slot.EndTimeLabel is null
                                          ? ""
                                          : $"–{slot.EndTimeLabel}"
                                    )
                                 </span>
                                 <span class="activity-group-slot-content">
                                    <span class=
                                       "activity-group-slot-title">
                                       @slot.Activity.Title
                                    </span>
                                    @if(!string.IsNullOrWhiteSpace(
                                       slot.Activity.Description
                                    ))
                                    {
                                       <span class=
                                          "activity-group-slot-description">
                                          @slot.Activity.Description
                                       </span>
                                    }
                                 </span>
                                 @if(slot.IsOngoing)
                                 {
                                    <span class=
                                       "activity-group-slot-status">
                                       Pågår
                                    </span>
                                 }
                              </li>
                           }
                        </ol>
                     }
                     else if(!string.IsNullOrWhiteSpace(
                        activity.Description
                     ))
                     {
                        <p style="margin-bottom: 0px;">@activity.Description</p>
                     }
                     @if(activity.Participants.Count > 0)
                     {
                        <div class="activity-participant-table-wrap">
                           <table class="activity-participant-table"
                                  data-participant-table>
                              <thead>
                                 <tr>
                                    <th class=
                                           "activity-participant-col-name"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="name">
                                          Namn
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-age"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="age">
                                          Ålder
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-birthday"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort=
                                                  "birthdate">
                                          Födelsedag
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-club"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="club">
                                          Moderklubb/Klubb
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-country">
                                    </th>
                                 </tr>
                              </thead>
                              <tbody>
                                 @foreach(var participant in
                                    activity.Participants)
                                 {
                                    var age = IndexModel.CalculateAge(
                                       participant.Birthdate,
                                       Model.CurrentDate
                                    );
                                    <tr data-participant-name=
                                           "@participant.Name"
                                        data-participant-age="@age"
                                        data-participant-birthdate=
                                           "@participant.Birthdate?.ToString(
                                              DateDisplay.DateOnlyFormat
                                           )"
                                        data-participant-club=
                                           "@participant.Club">
                                       <td class="activity-participant-name
                                          activity-participant-col-name">
                                          @participant.Name
                                       </td>
                                       <td class=
                                              "activity-participant-col-age">
                                          @(age is null
                                          ? string.Empty
                                          : $"{age} år")
                                       </td>
                                       <td class=
                                          "activity-participant-col-birthday">
                                          @IndexModel.FormatBirthday(
                                          participant.Birthdate
                                          )
                                       </td>
                                       <td class=
                                              "activity-participant-col-club">
                                          @participant.Club
                                       </td>
                                       <td class=
                                          "activity-participant-col-country">
                                          <img class=
                                                  "participant-country-flag"
                                               src="~/images/flags/se.svg"
                                               alt="Sverige" />
                                       </td>
                                    </tr>
                                 }
                              </tbody>
                           </table>
                        </div>
                     }
                  </article>
               </div>
            </section>
      }
   </div>
}

@section Scripts {
   <script src="~/js/public-participant-table.js"
           asp-append-version="true"></script>
}
