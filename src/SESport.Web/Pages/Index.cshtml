@page
@model IndexModel
@{
   ViewData["Title"] = "sesport";
}

<section class="page-heading index-heading">
   <div class="index-heading-left">
      <div class="date-select">
         <div class="date-select-control">
            <form method="get">
               <select
                  id="date-select-input"
                  class="date-select-input"
                  name="@RouteKeys.Date"
                  aria-label="Date"
                  onchange="this.form.submit();"
               >
                  @foreach(var dateOption in Model.DateOptions)
                  {
                     <option
                        value="@dateOption.Value"
                        selected="@(dateOption.IsSelected ? "selected" : null)"
                     >
                        @dateOption.Label
                     </option>
                  }
               </select>
            </form>
         </div>
      </div>
      @if(Model.TotalParticipantsCount is not null)
      {
         <div class="index-participants date-select">
            <div class="index-participants-pill">
               <span>Svenskar:</span>
               <span class="index-participants-count index-participants-value">
                  @Model.TotalParticipantsCount
               </span>
            </div>
         </div>
      }
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @(Model.ShowLoadErrorDetails
         ? Model.LoadError
         : "The activity database is not available right now.")
   </div>
}
else if(Model.TimelineEntries.Count == 0 &&
   Model.UntimedActivities.Count == 0)
{
   <div class="notice">
      @(Model.IsSportToday
         ? "No upcoming activities yet."
         : "No published activities yet.")
   </div>
}
else
{
   <div class="activity-agenda">
      @foreach(var timelineEntry in Model.TimelineEntries)
      {
         @if(timelineEntry.IsCurrentMarker)
         {
            <div class="activity-now-marker" id="activity-now-marker">
               <span class="activity-now-marker-line"></span>
               <span class="activity-now-marker-badge">
                  @timelineEntry.CurrentMarkerLabel
               </span>
               <span class="activity-now-marker-line"></span>
            </div>
         }
         else if(timelineEntry.Section is not null)
         {
            var agendaSection = timelineEntry.Section;
            var activity = agendaSection.Activities[0];

            <section class="activity-agenda-section">
               <div class="activity-agenda-time">
                  <div class="activity-time-row">
                     <div class="activity-time-badge">
                        @agendaSection.TimeLabel
                     </div>
                     @if(!string.IsNullOrWhiteSpace(activity.TvChannelName))
                     {
                        <span class="activity-time-channel">
                           @activity.TvChannelName
                        </span>
                     }
                  </div>
                  @if(!string.IsNullOrWhiteSpace(
                     activity.RelatedPersonEntities))
                  {
                     var participantNames =
                        IndexModel.SplitParticipantNames(
                           activity.RelatedPersonEntities
                        );
                     <div class="activity-time-participants">
                        @if(participantNames.Count <= 5)
                        {
                           @for(var i = 0; i < participantNames.Count; i++)
                           {
                              <span>- @participantNames[i]</span>

                              @if(i < participantNames.Count - 1)
                              {
                                 <br />
                              }
                           }
                        }
                        else
                        {
                           <details class="activity-participants-toggle">
                              <summary class="activity-participants-summary">
                                 @for(var i = 0; i < 5; i++)
                                 {
                                    <span>- @participantNames[i]</span>

                                    @if(i < 4)
                                    {
                                       <br />
                                    }
                                 }
                                 <span class="activity-participants-more">
                                    + @(participantNames.Count - 5) till
                                 </span>
                              </summary>
                              <div class="activity-participants-expanded">
                                 @for(
                                    var i = 0;
                                    i < participantNames.Count;
                                    i++
                                 )
                                 {
                                    <span>- @participantNames[i]</span>

                                    @if(i < participantNames.Count - 1)
                                    {
                                       <br />
                                    }
                                 }
                              </div>
                           </details>
                        }
                     </div>
                  }
               </div>
               <div class="activity-agenda-items">
                  <article class="activity-entry">
                     <div class="activity-meta">
                        <span class="activity-sport">
                           @activity.SportName
                        </span>
                     </div>
                     <h2 class="activity-entry-title">
                        @activity.Title
                     </h2>
                     <h3 class="activity-entry-organization">
                        @(string.IsNullOrEmpty(
                           activity.RelatedOrganizationEntities)
                        ? string.Empty
                        : $"{activity.RelatedOrganizationEntities} ")
                     </h3>
                     @if(!string.IsNullOrWhiteSpace(activity.Description))
                     {
                        <p>@activity.Description</p>
                     }
                     @if(!string.IsNullOrWhiteSpace(activity.Teaser))
                     {
                        <p class="activity-teaser">
                           @activity.Teaser
                        </p>
                     }
                  </article>
               </div>
            </section>
         }
      }
   </div>
}
