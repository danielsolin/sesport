@page
@model IndexModel
@section Head {
   <title>sesport</title>
   <meta name="description"
         content="TV-sändningar med svenskar som tävlar internationellt, både individuellt och i lag." />
   <meta property="og:title" content="sesport" />
   <meta property="og:description"
         content="TV-sändningar med svenskar som tävlar internationellt, både individuellt och i lag." />
   <meta name="twitter:title" content="sesport" />
   <meta name="twitter:description"
         content="TV-sändningar med svenskar som tävlar internationellt, både individuellt och i lag." />
}

<section class="page-heading index-heading">
   <div class="index-heading-left">
      <div class="date-select">
         <div class="date-select-control">
            <form method="get">
               <select id="date-select-input"
                       class="date-select-input"
                       name="@RouteKeys.Date"
                       aria-label="Date"
                       onchange="this.form.submit();">
                  @foreach(var dateOption in Model.DateOptions)
                  {
                     <option value="@dateOption.Value"
                             selected="@(dateOption.IsSelected ? "selected" : null)">
                        @dateOption.Label
                     </option>
                  }
               </select>
            </form>
         </div>
      </div>
      @if(Model.TotalParticipantsCount is not null)
      {
         <div class="index-participants date-select">
            <div class="index-participants-pill">
               <span>Svenskar:</span>
               <span class="index-participants-count index-participants-value">
                  @Model.TotalParticipantsCount
               </span>
            </div>
         </div>
      }
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @(Model.ShowLoadErrorDetails
         ? Model.LoadError
         : "Ett problem uppstod. Vänligen försök igen.")
   </div>
}
else if(Model.TimelineEntries.Count == 0 &&
   Model.UntimedActivities.Count == 0)
{
   <div class="notice">
      @(Model.IsSportToday
         ? "Vi har inte lyckats identifiera några internationellt sportande svenskar på valt datum... :-("
         : "Vi har inte lyckats identifiera några internationellt sportande svenskar på valt datum... :-(")
   </div>
}
else
{
   <div class="activity-agenda">
      @foreach(var timelineEntry in Model.TimelineEntries)
      {
         @if(timelineEntry.IsCurrentMarker)
         {
            <div class="activity-now-marker" id="activity-now-marker">
               <span class="activity-now-marker-line"></span>
               <span class="activity-now-marker-badge">
                  @timelineEntry.CurrentMarkerLabel
               </span>
               <span class="activity-now-marker-line"></span>
            </div>
         }
         else if(timelineEntry.Section is not null)
         {
            var agendaSection = timelineEntry.Section;
            var activity = agendaSection.Activities[0];
            var dayPhaseClass = agendaSection.DayPhase switch
            {
               ActivityDayPhase.Day => "activity-time-point-day",
               _ => "activity-time-point-night"
            };

            <section class="activity-agenda-section">
               <div class="activity-agenda-time">
                  <div class="activity-time-row">
                     <div class="activity-time-badge">
                        @if(activity.SportIconPath is not null)
                        {
                           <span class="activity-time-icon"
                                 role="img"
                                 aria-label="@activity.SportName"
                                 style="--sport-icon-url: url('@activity.SportIconPath');">
                           </span>
                        }
                        <time class="activity-time-value">
                           @agendaSection.TimeLabel
                        </time>
                     </div>
                     <span class="activity-time-connector"
                           aria-hidden="true">
                        <span class=
                                 "activity-time-point @dayPhaseClass">
                        </span>
                     </span>
                  </div>
                  @if(!string.IsNullOrWhiteSpace(activity.TvChannelName))
                  {
                     <span class="activity-time-channel">
                        @activity.TvChannelName
                     </span>
                  }
                  @if(!string.IsNullOrWhiteSpace(
                     activity.RelatedPersonEntities))
                  {
                     var participantNames =
                        IndexModel.SplitParticipantNames(
                           activity.RelatedPersonEntities
                        );
                     <div class="activity-time-participants">
                        @for(var i = 0; i < participantNames.Count; i++)
                        {
                           <span>- @participantNames[i]</span>

                           @if(i < participantNames.Count - 1)
                           {
                              <br />
                           }
                        }
                     </div>
                  }
               </div>
               <div class="activity-agenda-items">
                  <article class="activity-entry">
                     <h3 class="activity-entry-organization">
                        #@(string.IsNullOrEmpty(
                           activity.RelatedOrganizationEntities)
                           ? string.Empty
                           : $"{activity.RelatedOrganizationEntities} ")
                     </h3>
                     <h2 class="activity-entry-title">
                        @activity.Title
                     </h2>
                     @if(!string.IsNullOrWhiteSpace(activity.Description))
                     {
                        <p style="margin-bottom: 0px;">@activity.Description</p>
                     }
                     @if(activity.Participants.Count > 0)
                     {
                        <div class="activity-participant-table-wrap">
                           <table class="activity-participant-table"
                                  data-participant-table>
                              <thead>
                                 <tr>
                                    <th aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="name">
                                          Namn
                                       </button>
                                    </th>
                                    <th aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="age">
                                          Ålder
                                       </button>
                                    </th>
                                    <th aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="height">
                                          Längd
                                       </button>
                                    </th>
                                    <th aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="club">
                                          Moderklubb/Klubb
                                       </button>
                                    </th>
                                    <th aria-sort="none">
                                       <button type="button"
                                               data-participant-sort=
                                                  "birthdate">
                                          Födelsedag
                                       </button>
                                    </th>
                                    <th></th>
                                 </tr>
                              </thead>
                              <tbody>
                                 @foreach(var participant in
                                    activity.Participants)
                                 {
                                    var age = IndexModel.CalculateAge(
                                       participant.Birthdate,
                                       Model.CurrentDate
                                    );
                                    <tr data-participant-name=
                                           "@participant.Name"
                                        data-participant-age="@age"
                                        data-participant-birthdate=
                                           "@participant.Birthdate?.ToString(
                                              DateDisplay.DateOnlyFormat
                                           )"
                                        data-participant-height=
                                           "@participant.Height"
                                        data-participant-club=
                                           "@participant.Club">
                                       <td>@participant.Name</td>
                                       <td>@(age is null
                                          ? string.Empty
                                          : $"{age} år")</td>
                                       <td>@(participant.Height is null
                                          ? string.Empty
                                          : $"{participant.Height} cm")</td>
                                       <td>@participant.Club</td>
                                       <td>@IndexModel.FormatBirthday(
                                          participant.Birthdate
                                       )</td>
                                       <td>
                                          <img class=
                                                  "participant-country-flag"
                                               src="~/images/flags/se.svg"
                                               alt="Sverige" />
                                       </td>
                                    </tr>
                                 }
                              </tbody>
                           </table>
                        </div>
                     }
                  </article>
               </div>
            </section>
         }
      }
   </div>
}

@section Scripts {
   <script src="~/js/public-participant-table.js"
           asp-append-version="true"></script>
}
