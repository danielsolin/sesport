@page
@model IndexModel
@{
   ViewData["Title"] = "SE Sport";
}

@{
   var todayButtonClass = Model.Day == IndexModel.TodayDay
      ? "button button-primary"
      : "button";
   var tomorrowButtonClass = Model.Day == IndexModel.TomorrowDay
      ? "button button-primary"
      : "button";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Internationell Sverige-relaterad Sport</p>
   </div>
   <div class="button-row">
      <a class="@todayButtonClass" asp-page="./Index" asp-route-day="Today">
         Idag
      </a>
      <a class="@tomorrowButtonClass"
         asp-page="./Index"
         asp-route-day="Tomorrow">
         Imorgon
      </a>
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}
else if(Model.Activities.Count == 0)
{
   <div class="notice">
      No published activities yet.
   </div>
}
else
{
   <div class="activity-list">
      @foreach(var activity in Model.Activities)
      {
         <article class="activity-row">
            <div class="activity-time">
               <div class="activity-time-row">
                  @if(activity.SportIconPath is not null)
                  {
                     <img class="activity-sport-icon"
                          src="@activity.SportIconPath"
                          alt="" />
                  }
                  @activity.TimeOnlyText
               </div>
               @if(!string.IsNullOrWhiteSpace(activity.EntitySummary))
               {
                  <div class="activity-entity-summary">
                     @{
                        var entitySummary = activity.EntitySummary
                           .Split(
                              ", ",
                              StringSplitOptions.RemoveEmptyEntries
                           );
                     }
                     @for(var i = 0; i < entitySummary.Length; i++)
                     {
                        <span>@entitySummary[i]</span>

                        @if(i < entitySummary.Length - 1)
                        {
                           <br />
                        }
                     }
                  </div>
               }
            </div>
            <div class="activity-main">
               <div class="activity-meta">
                  <span class="activity-sport">
                     @activity.SportName
                  </span>
                  <span>@activity.ActivityType</span>
               </div>
               <h2>@activity.Title</h2>
               @if(!string.IsNullOrWhiteSpace(
                  activity.RelatedEntitiesSummary))
               {
                  <p class="related-entity-line">
                     @{
                        var relatedEntities = activity.RelatedEntitiesSummary
                           .Split(
                              ", ",
                              StringSplitOptions.RemoveEmptyEntries
                           );
                     }
                     @for(var i = 0; i < relatedEntities.Length; i++)
                     {
                        <span>@relatedEntities[i]</span>

                        @if(i < relatedEntities.Length - 1)
                        {
                           <br />
                        }
                     }
                  </p>
               }
               @if(!string.IsNullOrWhiteSpace(activity.Description))
               {
                  <p>@activity.Description</p>
               }
               @if(!string.IsNullOrWhiteSpace(activity.Teaser))
               {
                  <p class="activity-teaser">
                     @activity.Teaser
                  </p>
               }
            </div>
         </article>
      }
   </div>
}
