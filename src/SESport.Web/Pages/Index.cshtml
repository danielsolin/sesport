@page
@model IndexModel
@{
   ViewData["Title"] = "SE Sport";
}

<section class="page-heading">
   <p class="eyebrow">Sweden-relevant sport</p>
   <h1>Dagens Svenskar</h1>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}
else if(Model.Activities.Count == 0)
{
   <div class="notice">
      No published activities yet.
   </div>
}
else
{
   <div class="activity-list">
      @foreach(var activity in Model.Activities)
      {
         <article class="activity-row">
            <div class="activity-time">
               @if(activity.SportIconPath is not null)
               {
                  <img class="activity-sport-icon"
                       src="@activity.SportIconPath"
                       alt="" />
               }
               @activity.TimeOnlyText
            </div>
            <div class="activity-main">
               <div class="activity-meta">
                  <span class="activity-sport">
                     @activity.SportName
                  </span>
                  <span>@activity.ActivityType</span>
               </div>
               <h2>@activity.EntitySummary</h2>
               <p class="entity-line">@activity.Title</p>
               @if(!string.IsNullOrWhiteSpace(
                  activity.RelatedEntitiesSummary))
               {
                  <p class="related-entity-line">
                     @activity.RelatedEntitiesSummary
                  </p>
               }
               @if(!string.IsNullOrWhiteSpace(activity.Description))
               {
                  <p>@activity.Description</p>
               }
            </div>
         </article>
      }
   </div>
}
