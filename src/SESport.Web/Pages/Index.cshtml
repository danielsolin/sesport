@page
@model IndexModel
@{
   ViewData["Title"] = "SE Sport";
}

@{
   var todayButtonClass = Model.Day == IndexModel.TodayDay
      ? "button button-primary"
      : "button";
   var tomorrowButtonClass = Model.Day == IndexModel.TomorrowDay
      ? "button button-primary"
      : "button";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Internationell Sverige-relaterad Sport</p>
   </div>
   <div class="button-row">
      <a class="@todayButtonClass" asp-page="./Index" asp-route-day="Today">
         Idag
      </a>
      <a class="@tomorrowButtonClass"
         asp-page="./Index"
         asp-route-day="Tomorrow">
         Imorgon
      </a>
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}
else if(Model.Activities.Count == 0)
{
   <div class="notice">
      No published activities yet.
   </div>
}
else
{
   <div class="activity-agenda">
      @foreach(var agendaSection in Model.AgendaSections)
      {
         <section class="activity-agenda-section">
            <div class="activity-agenda-time">
               <div class="activity-time-badge">
                  @agendaSection.TimeLabel
               </div>
               @if(agendaSection.Activities.Count > 1)
               {
                  <div class="activity-time-count">
                     @agendaSection.Activities.Count st
                  </div>
               }
               <div class="activity-time-summary-list">
                  @foreach(var activity in agendaSection.Activities)
                  {
                     if(string.IsNullOrWhiteSpace(
                        activity.RelatedOrganization) &&
                        string.IsNullOrWhiteSpace(
                           activity.RelatedPersonEntities))
                     {
                        continue;
                     }

                     var relatedOrganization = activity.RelatedOrganization;
                     var entitySummary = activity.RelatedPersonEntities
                        .Split(
                           ", ",
                           StringSplitOptions.RemoveEmptyEntries
                        );

                     <div class="activity-time-summary">
                        <div class="activity-time-summary-primary">
                           @if(!string.IsNullOrWhiteSpace(
                              relatedOrganization))
                           {
                              @relatedOrganization
                           }
                        </div>
                        <div class="activity-time-summary-entities">
                           @for(var i = 0; i < entitySummary.Length; i++)
                           {
                              <span>@entitySummary[i]</span>

                              @if(i < entitySummary.Length - 1)
                              {
                                 <br />
                              }
                           }
                        </div>
                     </div>
                  }
               </div>
               @if(!string.IsNullOrWhiteSpace(
                  agendaSection.RelatedOrganization))
               {
                  <div class="activity-time-related">
                     @agendaSection.RelatedOrganization
                  </div>
               }
            </div>
            <div class="activity-agenda-items">
               @foreach(var activity in agendaSection.Activities)
               {
                  <article class="activity-entry">
                     <div class="activity-meta">
                        <span class="activity-sport">
                           @activity.SportName
                        </span>
                        <span>@activity.ActivityType</span>
                     </div>
                     <h2>@activity.Title</h2>
                     @if(!string.IsNullOrWhiteSpace(activity.Description))
                     {
                        <p>@activity.Description</p>
                     }
                     @if(!string.IsNullOrWhiteSpace(activity.Teaser))
                     {
                        <p class="activity-teaser">
                           @activity.Teaser
                        </p>
                     }
                  </article>
               }
            </div>
         </section>
      }

      @if(Model.UntimedActivities.Count > 0)
      {
         <section class="activity-agenda-section activity-agenda-section-untimed">
            <div class="activity-agenda-time">
               <div class="activity-time-badge activity-time-badge-muted">
                  Utan tid
               </div>
               @if(Model.UntimedActivities.Count > 1)
               {
                  <div class="activity-time-count">
                     @Model.UntimedActivities.Count st
                  </div>
               }
            </div>
            <div class="activity-agenda-items">
               @foreach(var activity in Model.UntimedActivities)
               {
                  <article class="activity-entry">
                     <div class="activity-meta">
                        <span class="activity-sport">
                           @activity.SportName
                        </span>
                        <span>@activity.ActivityType</span>
                     </div>
                     <h2>@activity.Title</h2>
                     @if(!string.IsNullOrWhiteSpace(activity.Description))
                     {
                        <p>@activity.Description</p>
                     }
                     @if(!string.IsNullOrWhiteSpace(activity.Teaser))
                     {
                        <p class="activity-teaser">
                           @activity.Teaser
                        </p>
                     }
                  </article>
               }
            </div>
         </section>
      }
   </div>
}
