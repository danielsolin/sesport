@page
@inject BroadcastChannelLinkCatalog ChannelLinkCatalog
@using SESport.Core.Sources
@model IndexModel
@{
   var maxVisibleParticipants =
      Model.PublicSiteOptions.MaxVisibleParticipants;
   var blockedSourceHosts =
      Model.PublicSiteOptions.BlockedSourceHosts;
   var highestWatchPriorityLabel =
      "Högsta bevakningsprioritet";
    var isFilteredView =
       Request.Query.ContainsKey(RouteKeys.Date) ||
       Request.Query.ContainsKey(RouteKeys.Sport) ||
       Request.Query.ContainsKey(RouteKeys.Country) ||
       Request.Query.ContainsKey(RouteKeys.Watched) ||
       Model.IsWatchedActivitiesView;
   var publicActivityPath = Model.IsWatchedActivitiesView
      ? PublicRoutePaths.Watched
      : PublicRoutePaths.Home;
   var selectedDateQueryValue = Uri.EscapeDataString(
      DateDisplay.Format(Model.SelectedDate)
   );
   var publicActivityAllSportsUrl = Model.IsWatchedActivitiesView
      ? publicActivityPath
      : $"{publicActivityPath}?date={selectedDateQueryValue}";
    var allSportsLabel = Model.IsWatchedActivitiesView
       ? "Alla bevakade"
       : "Svenskar";
   var selectedDateOption = Model.DateOptions
      .First(option => option.IsSelected);
   var hasPastActivities = Model.TimelineEntries.Any(
      entry => entry.Section?.HasEnded == true
   );
   var hasActiveOrUpcomingActivities = Model.TimelineEntries.Any(
      entry => entry.Section?.HasEnded == false
   );
   var shouldAutoExpandPastActivities =
      !Model.IsWatchedActivitiesView &&
      IndexModel.ShouldAutoExpandPastActivities(
         Model.IsSportToday,
         hasPastActivities,
         hasActiveOrUpcomingActivities
      );
   var shouldHidePastActivities = Model.IsSportToday &&
      !Model.IsWatchedActivitiesView &&
      hasPastActivities &&
      !shouldAutoExpandPastActivities;
   var streamIconClass =
      "activity-channel-chip-stream-icon";
}
@section Head {
   <title>@Model.PublicSiteOptions.PageDescription – sesport</title>
   <link rel="canonical"
         href="@Model.PublicSiteOptions.CanonicalHomeUrl" />
   @if(isFilteredView)
   {
      <meta name="robots" content="noindex,follow" />
   }
   <meta name="description"
         content="@Model.PublicSiteOptions.PageDescription" />
   <meta property="og:title" content="sesport" />
   <meta property="og:description"
         content="@Model.PublicSiteOptions.PageDescription" />
   <meta name="twitter:title" content="sesport" />
   <meta name="twitter:description"
         content="@Model.PublicSiteOptions.PageDescription" />
}

<aside class="public-install-promotion"
       data-public-install-promotion
       hidden>
   <p class="public-install-message"
      data-public-install-message></p>
   <div class="public-install-actions">
      <button class="public-install-button"
              type="button"
              data-public-install-button>
         Installera sesport
      </button>
      <button class="public-install-dismiss"
              type="button"
              data-public-install-dismiss>
         Inte nu
      </button>
   </div>
</aside>

<section class="page-heading index-heading
   @(Model.IsWatchedActivitiesView ? "index-heading-watched" : "")">
   <div class="index-heading-left">
      @if(!Model.IsWatchedActivitiesView)
      {
      <div class="date-select">
         <div class="date-dropdown" data-date-dropdown>
            <button class="date-dropdown-toggle"
                    type="button"
                    aria-label="Välj datum"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="date-dropdown-menu"
                    data-date-dropdown-toggle>
               <span class="date-option-content"
                     data-date-option-fit>
                  <span class="date-option-day">
                     @selectedDateOption.DayLabel
                  </span>
                  <span class="date-option-date">
                     @selectedDateOption.DateLabel
                  </span>
               </span>
               <span class="date-dropdown-chevron"
                     aria-hidden="true"></span>
            </button>
            <div id="date-dropdown-menu"
                 class="date-dropdown-menu"
                 role="listbox"
                 aria-label="Datum"
                 hidden
                 data-date-dropdown-menu>
               @foreach(var dateOption in Model.DateOptions)
               {
                   var dateUrl = PublicRoutePaths.Home + "?date=" +
                      Uri.EscapeDataString(dateOption.Value);
                   var normalizedSport = Model.Sport?.Trim();
                   if(!string.IsNullOrWhiteSpace(normalizedSport))
                   {
                      dateUrl += "&sport=" + Uri.EscapeDataString(
                         normalizedSport
                      );
                      var normalizedCountry = Model.Country?.Trim();
                      if(!string.IsNullOrWhiteSpace(normalizedCountry))
                      {
                         dateUrl += "&country=" +
                            Uri.EscapeDataString(normalizedCountry);
                      }
                   }
                  <a class="date-dropdown-option
                     @(dateOption.IsSelected ? "is-selected" : "")"
                     href="@dateUrl"
                     role="option"
                     aria-selected="@(
                        dateOption.IsSelected ? "true" : "false"
                     )">
                     <span class="date-option-content"
                           data-date-option-fit>
                        <span class="date-option-label">
                           <span class="date-option-day">
                              @dateOption.DayLabel
                           </span>
                           <span class="date-option-date">
                              @dateOption.DateLabel
                           </span>
                        </span>
                        @if(!dateOption.IsSelected)
                        {
                           <span class="date-option-participant-count">
                              <img class="date-option-country-flag"
                                   src="~/images/flags/se.svg"
                                   alt="@(
                                      PrimaryCountry.LocalDisplayName
                                   )" /><span>x@(
                                dateOption.ParticipantCount)</span>
                           </span>
                        }
                     </span>
                  </a>
               }
            </div>
         </div>
      </div>
      }
      @if(Model.TotalParticipantsCount is not null)
      {
         var selectedSport = Model.SportParticipantCounts
            .FirstOrDefault(sport => string.Equals(
               Model.Sport,
               sport.SportId,
               StringComparison.OrdinalIgnoreCase
            ));
          var selectedSportName = selectedSport?.SportName ??
             (Model.IsWatchedActivitiesView
                ? "Alla bevakade"
                : "Svenskar");
          var selectedCountry = selectedSport?.Countries
             .FirstOrDefault(country => string.Equals(
                Model.Country,
                country.CountryId,
                StringComparison.OrdinalIgnoreCase
             ));
          var selectedCountryFlagPath =
             PublicCountryFlag.GetPath(selectedCountry?.CountryId);
          var selectedSportCount = selectedSport?.ParticipantCount ??
             Model.TotalParticipantsCount;
         <div class="sport-select" data-sport-dropdown>
            <button class="sport-dropdown-toggle"
                    type="button"
                    aria-label="Välj sport"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls="sport-dropdown-menu"
                    data-sport-dropdown-toggle>
               <span class="sport-option-content">
                  @if(Model.IsWatchedActivitiesView && selectedSport is null)
                  {
                     <span class="sport-option-name">
                        @selectedSportName
                     </span>
                  }
                   else
                   {
                       <span class="sport-option-name">
                          @selectedSportName
                       </span>
                      @if(selectedCountryFlagPath is not null)
                      {
                         <img class="sport-country-flag"
                              src="@selectedCountryFlagPath"
                              asp-append-version="true"
                              alt=""
                              aria-hidden="true" />
                      }
                      <span class="sport-option-count">
                         @(selectedCountry?.ParticipantCount ??
                            selectedSportCount)
                      </span>
                   }
               </span>
               <span class="sport-dropdown-chevron"
                     aria-hidden="true"></span>
            </button>
            <div id="sport-dropdown-menu"
                 class="sport-dropdown-menu"
                 aria-label="Sportfilter"
                 data-sport-dropdown-menu>
               <div class="index-participants">
                  <a class="index-participants-info
                     index-participants-filter
                     @(Model.Sport is null ? "is-selected" : "")"
                     href="@publicActivityAllSportsUrl"
                     aria-current="@(
                        Model.Sport is null ? "true" : null
                     )"
                     aria-label="Visa alla sporter">
                     <span>@allSportsLabel</span>
                     @if(!Model.IsWatchedActivitiesView)
                     {
                        <span class="index-participants-count
                           index-participants-value">
                           @Model.TotalParticipantsCount
                        </span>
                     }
                  </a>
               </div>
                @foreach(var sport in Model.SportParticipantCounts)
                {
                   var isSelected = string.Equals(
                      Model.Sport,
                      sport.SportId,
                      StringComparison.OrdinalIgnoreCase
                   );
                   var sportQuery = "sport=" + Uri.EscapeDataString(
                      sport.SportId
                   );
                   var publicActivitySportUrl =
                      Model.IsWatchedActivitiesView
                         ? $"{publicActivityPath}?{sportQuery}"
                         : $"{publicActivityPath}?date={
                            selectedDateQueryValue
                         }&{sportQuery}";
                   @if(sport.Countries.Count >= 2)
                   {
                      @foreach(var country in sport.Countries)
                      {
                         var isSelectedCountry = isSelected &&
                            string.Equals(
                               Model.Country,
                               country.CountryId,
                               StringComparison.OrdinalIgnoreCase
                            );
                         var countryFlagPath =
                            PublicCountryFlag.GetPath(
                               country.CountryId
                            );
                         var countryQuery = sportQuery +
                            "&country=" +
                            Uri.EscapeDataString(country.CountryId);
                         var publicActivitySportCountryUrl =
                            Model.IsWatchedActivitiesView
                               ? $"{publicActivityPath}?{countryQuery}"
                               : $"{publicActivityPath}?date={
                                  selectedDateQueryValue
                               }&{countryQuery}";
                         <div class="index-participants">
                            <a class="index-participants-info
                               index-participants-filter
                               sport-country-row
                               @(isSelectedCountry
                                  ? "is-selected" : "")"
                               href="@publicActivitySportCountryUrl"
                               aria-current="@(
                                  isSelectedCountry
                                     ? "true" : null
                               )"
                               aria-label="Visa endast @sport.SportName">
                               <span>@sport.SportName</span>
                               @if(countryFlagPath is not null)
                               {
                                  <img class="sport-country-flag"
                                       src="@countryFlagPath"
                                       asp-append-version="true"
                                       alt=""
                                       aria-hidden="true" />
                               }
                               <span class="index-participants-count
                                  index-participants-value">
                                  @country.ParticipantCount
                               </span>
                            </a>
                         </div>
                      }
                   }
                   else
                   {
                      <div class="index-participants">
                         <a class="index-participants-info
                            index-participants-filter
                            @(isSelected ? "is-selected" : "")"
                            href="@publicActivitySportUrl"
                            aria-current="@(isSelected ? "true" : null)"
                            aria-label="Visa endast @sport.SportName">
                            <span>@sport.SportName</span>
                            <span class="index-participants-count
                               index-participants-value">
                               @sport.ParticipantCount
                            </span>
                         </a>
                      </div>
                   }
                }
            </div>
         </div>
      }
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      Ett problem uppstod. Vänligen försök igen.
   </div>
}
else if(Model.TimelineEntries.Count == 0 &&
   Model.IsWatchedActivitiesView &&
   !Model.IsMember)
{
   <div class="notice">
      Logga in för att följa dina bevakningar.
      <br />
      <br />
      <a class="button button-primary"
         asp-page="/Account/Login">
         Logga in
      </a>
   </div>
}
else if(!Model.HasVisibleActivities)
{
   <div class="notice">
      @(Model.IsWatchedActivitiesView
         ? "Det finns inga publicerade framtida aktiviteter för dina " +
            "bevakningar just nu."
         : "Vi har inte lyckats identifiera några internationellt " +
            "sportande svenskar på valt datum... :-(")
   </div>
}
else
{
   <div class="activity-agenda
      @(shouldHidePastActivities
         ? "activity-past-activities-hidden"
         : "")"
        data-activity-agenda>
      @for(var timelineIndex = 0;
            timelineIndex < Model.TimelineEntries.Count;
            timelineIndex++)
      {
         var timelineEntry = Model.TimelineEntries[timelineIndex];
         if(timelineEntry.IsDateSeparator)
         {
            var dateSeparatorModifier = Model.IsWatchedActivitiesView
               ? "is-watched"
               : timelineEntry.IsTodayDateSeparator
                  ? "is-today"
                  : "";
            var dateSeparatorRowModifier =
               Model.IsWatchedActivitiesView && timelineIndex > 0
                  ? "is-watched"
                  : "";
            <div class="activity-date-separator-row
               @dateSeparatorRowModifier">
               <span class="activity-date-separator-line"></span>
               <span class="activity-date-separator-label
                  @dateSeparatorModifier">
                  @timelineEntry.DateSeparatorLabel
               </span>
               <span class="activity-date-separator-line"></span>
            </div>
            continue;
         }

         if(timelineEntry.IsCurrentMarker)
         {
            @if(shouldHidePastActivities)
            {
               <div class="activity-past-toggle-row">
                  <span class="activity-past-toggle-line"></span>
                  <button class="activity-past-toggle-button"
                          type="button"
                          data-activity-past-toggle
                          data-collapsed-label="Visa Tidigare"
                          data-expanded-label="Dölj Tidigare"
                          aria-expanded="@(
                             shouldHidePastActivities ? "false" : "true"
                          )">
                     @(shouldHidePastActivities
                        ? "Visa Tidigare"
                        : "Dölj Tidigare")
                  </button>
                  <span class="activity-past-toggle-line"></span>
               </div>
            }
            <div class="activity-now-marker">
               <span class="activity-now-marker-line"></span>
               <span class="activity-now-marker-badge">
                  @timelineEntry.CurrentMarkerLabel
               </span>
               <span class="activity-now-marker-line"></span>
            </div>
            continue;
         }

         if(timelineEntry.Section is null)
         {
            continue;
         }

         var agendaSection = timelineEntry.Section;
         var activity = agendaSection.Activities[0];
         var activityAnchorId = "activity-" + activity.Id.ToString("N");
         var isGrouped = agendaSection.ActivityGroupTitle is not null;
         var allActivitySources = agendaSection.Activities
            .SelectMany(item => item.Sources)
            .Where(source => SourceDisplay.IsPubliclyVisibleSourceUrl(
               source.Url,
               blockedSourceHosts
            ))
            .ToList();
         var streamSources = SourceDisplay.OrderDistinctByUrl(
            allActivitySources.Where(source =>
               string.Equals(
                  source.Kind,
                  SourceKinds.StreamLink,
                  StringComparison.OrdinalIgnoreCase
               )
            )
         );
         var tvChannels = agendaSection.Activities
            .SelectMany(item => (item.TvChannelName ?? string.Empty).Split(
               ',',
               StringSplitOptions.TrimEntries |
                  StringSplitOptions.RemoveEmptyEntries
            ))
            .Concat(
               streamSources
                  .Select(source => source.Title)
                  .Where(title => !string.IsNullOrWhiteSpace(title))
                  .Select(title => title!)
            )
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
         var activitySources = SourceDisplay.OrderDistinctByUrl(
            allActivitySources
         );
         var dayPhaseClass = agendaSection.DayPhase switch
         {
            ActivityDayPhase.Morning =>
               "activity-day-phase-morning",
            ActivityDayPhase.Day => "activity-day-phase-day",
            ActivityDayPhase.Evening =>
               "activity-day-phase-evening",
            _ => "activity-day-phase-night"
         };
         var timingClass = agendaSection.IsOngoing
            ? "activity-is-ongoing"
            : agendaSection.HasEnded
               ? "activity-has-ended"
               : "activity-is-upcoming";
         var pastActivityVisibilityClass = shouldHidePastActivities &&
            agendaSection.HasEnded
               ? "activity-past-activity-hidden"
               : "";

         <section class="activity-agenda-section
                            @dayPhaseClass
                            @timingClass
                            @pastActivityVisibilityClass
                            @(isGrouped
                               ? "activity-agenda-section-grouped"
                               : "")">
               <div class="activity-agenda-time">
                  @if(isGrouped)
                  {
                     var timelineSlot = agendaSection.TimelineSlot;
                     <div class="activity-group-time-item
                        @(timelineSlot.IsOngoing ? "is-ongoing" : "")
                        @(timelineSlot.HasEnded ? "has-ended" : "")">
                        <div class="activity-time-badge">
                           <time class="activity-time-value">
                              @agendaSection.TimeLabel
                           </time>
                        </div>
                        <span class="activity-time-connector"
                              aria-hidden="true">
                           <span class="activity-time-point"></span>
                        </span>
                     </div>
                  }
                  else
                  {
                     <div class="activity-time-row">
                        <div class="activity-time-badge">
                           <time class="activity-time-value">
                              @agendaSection.TimeLabel
                           </time>
                        </div>
                        <span class="activity-time-connector"
                              aria-hidden="true">
                           <span class="activity-time-point"></span>
                        </span>
                     </div>
                  }
                  @if(tvChannels.Count > 0)
                  {
                     <div class="activity-channel-list
                        activity-time-channel-list"
                        aria-label="TV-kanaler">
                        @foreach(var channel in tvChannels)
                        {
                           var channelUrl =
                              SourceDisplay.FindChannelLinkUrlForChannel(
                                 streamSources,
                                 channel,
                                 ChannelLinkCatalog
                              );
                           if(channelUrl is null)
                           {
                              <span class="activity-channel-chip">
                                 @channel
                              </span>
                           }
                           else
                           {
                              <a class="activity-channel-chip
                                 activity-channel-chip-link"
                                 href="@channelUrl"
                                 target="_blank"
                                 rel="noopener noreferrer"
                                 aria-label="Öppna stream hos @channel">
                                 @channel
                                 <svg class="@streamIconClass"
                                      viewBox="0 0 12 12"
                                      aria-hidden="true"
                                      focusable="false">
                                    <path d="M3 2v8l6-4-6-4Z"></path>
                                 </svg>
                              </a>
                           }
                        }
                     </div>
                  }
               </div>
               @if(isGrouped)
               {
                  var groupedEndTimeLabel =
                     agendaSection.EndTimeLabel;
                  <div class="activity-duration-rail"
                       aria-label="@(
                          groupedEndTimeLabel is null
                             ? null
                             : $"Slutar {groupedEndTimeLabel}"
                       )"
                       aria-hidden="@(
                          groupedEndTimeLabel is null ? "true" : null
                       )">
                     <span class="activity-duration-line"></span>
                     @if(groupedEndTimeLabel is not null)
                     {
                        <span class=
                           "activity-duration-end-point"></span>
                        <time class="activity-duration-end-time">
                           @groupedEndTimeLabel
                        </time>
                     }
                  </div>
               }
               else if(agendaSection.EndTimeLabel is not null)
               {
                  <div class="activity-duration-rail"
                       aria-label=
                          "Slutar @agendaSection.EndTimeLabel">
                     <span class="activity-duration-line"></span>
                     <span class="activity-duration-end-point"></span>
                     <time class="activity-duration-end-time">
                        @agendaSection.EndTimeLabel
                     </time>
                  </div>
               }
               <div class="activity-agenda-items">
                  <article id="@activityAnchorId"
                           class="activity-entry">
                     @if(agendaSection.IsOngoing)
                     {
                        <span class="activity-status-badge
                           activity-ongoing-badge"
                           aria-label="Pågår">
                           Pågår
                           <span class="activity-ongoing-dots"
                                 aria-hidden="true"></span>
                        </span>
                     }
                     else if(agendaSection.HasEnded)
                     {
                        <span class="activity-status-badge
                           activity-ended-badge">
                           Avslutad
                        </span>
                     }
                     @if(activity.SportIconPath is not null)
                     {
                        var sportIconCountryPath = PublicCountryFlag.GetPath(
                           activity.OrganizationCountryId
                        );
                        var sportIconCountryTagClass =
                           activity.OrganizationCountryId?.Trim()
                              .ToLowerInvariant() is
                              CountryIds.Europe or CountryIds.International
                           ? "activity-entry-sport-country-tag-symbol"
                           : null;
                        <span class="activity-entry-sport-icon"
                              role="img"
                              aria-label="@activity.SportName"
                              style="--sport-icon-url:
                                        url('@activity.SportIconPath');">
                        </span>
                        @if(sportIconCountryPath is not null)
                        {
                           <img class=
                              "activity-entry-sport-country-tag
                              @sportIconCountryTagClass"
                              src="@sportIconCountryPath"
                              asp-append-version="true"
                              alt=""
                              aria-hidden="true" />
                        }
                     }
                     <h3 class="activity-entry-organization">
                        <span class="activity-organization-portrait">
                           @activity.RelatedOrganizationEntities
                        </span>
                        <span class="activity-organization-landscape">
                           @activity.RelatedOrganizationEntities
                           @if(
                              !string.IsNullOrWhiteSpace(
                                 activity
                                    .RelatedOrganizationCanonicalEntities
                              ) &&
                              !string.Equals(
                                 activity.RelatedOrganizationEntities,
                                 activity
                                    .RelatedOrganizationCanonicalEntities,
                                 StringComparison.Ordinal
                              )
                           )
                           {
                              <span class=
                                 "activity-organization-canonical">
                                 – @(
                                    activity
                                       .RelatedOrganizationCanonicalEntities
                                 )
                              </span>
                           }
                        </span>
                     </h3>
                     <h2 class="activity-entry-title"
                         data-activity-title-fit>
                        @agendaSection.DisplayTitle
                     </h2>
                     @if(!string.IsNullOrWhiteSpace(
                        activity.Description
                     ))
                     {
                        <p class="@(
                           isGrouped ? "activity-group-description" : ""
                        )">
                           @activity.Description
                        </p>
                     }
                     @if(isGrouped)
                     {
                        <ol class="activity-group-schedule">
                           @foreach(var slot in agendaSection.Slots)
                           {
                              var slotStreamSources = slot.Activity.Sources
                                 .Where(source => string.Equals(
                                    source.Kind,
                                    SourceKinds.StreamLink,
                                    StringComparison.OrdinalIgnoreCase
                                 ))
                                 .Where(source =>
                                    SourceDisplay
                                       .IsPubliclyVisibleSourceUrl(
                                          source.Url,
                                          blockedSourceHosts
                                       )
                                 )
                                 .ToList();
                              var slotChannels = slot.TvChannels
                                 .Concat(
                                    slotStreamSources
                                       .Select(source => source.Title)
                                       .Where(title =>
                                          !string.IsNullOrWhiteSpace(title)
                                       )
                                       .Select(title => title!)
                                 )
                                 .Distinct(
                                    StringComparer.OrdinalIgnoreCase
                                 )
                                 .ToList();
                              string[] slotParticipantNames =
                                 slot.ShowParticipantNames
                                    ? slot.Activity
                                       .Participants
                                       .Where(
                                          participant =>
                                             participant.IsActive
                                       )
                                       .Select(
                                          participant => participant.Name
                                       )
                                       .ToArray()
                                    : [];
                              <li class="activity-group-schedule-item
                                 @(slot.IsOngoing ? "is-ongoing" : "")
                                 @(slot.HasEnded ? "has-ended" : "")
                                 @(slotChannels.Count > 0
                                    ? "has-tv-channels"
                                    : "")"
                                    data-activity-slot-fit="true">
                                 @if(slotChannels.Count > 0)
                                 {
                                    <div class="activity-channel-list
                                       activity-group-slot-channel-list"
                                       aria-label="TV-kanaler">
                                       @foreach(var channel in
                                          slotChannels)
                                       {
                                          var channelUrl =
                                             SourceDisplay
                                                .FindChannelLinkUrlForChannel(
                                                   slotStreamSources,
                                                   channel,
                                                   ChannelLinkCatalog
                                                );
                                          if(channelUrl is null)
                                          {
                                             <span class=
                                                "activity-channel-chip">
                                                @channel
                                             </span>
                                          }
                                          else
                                          {
                                             <a class=
                                                "activity-channel-chip
                                                activity-channel-chip-link"
                                                href="@channelUrl"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label="Öppna stream hos
                                                   @channel">
                                                @channel
                                                <svg class="@streamIconClass"
                                                   viewBox="0 0 12 12"
                                                   aria-hidden="true"
                                                   focusable="false">
                                                   <path d="M3 2v8l6-4-6-4Z">
                                                   </path>
                                                </svg>
                                             </a>
                                          }
                                       }
                                    </div>
                                 }
                                 <span class="activity-group-slot-time"
                                       data-activity-slot-time>
                                    @slot.StartTimeLabel
                                 </span>
                                 <span class="activity-group-slot-content">
                                    <span class=
                                       "activity-group-slot-title"
                                       data-activity-title-fit>
                                       @slot.Activity.Title
                                       @if(slotParticipantNames.Length > 0)
                                       {
                                          <span class=
                                             "activity-group-slot-participants">
                                             (@string.Join(", ",
                                                slotParticipantNames))
                                          </span>
                                       }
                                    </span>
                                 </span>
                              </li>
                           }
                        </ol>
                     }
                     @if(agendaSection.Participants.Count > 0)
                     {
                        var participants = agendaSection.Participants;
                        var showStartTimeColumn =
                           participants.Any(
                              participant =>
                                 !string.IsNullOrWhiteSpace(
                                    participant.StartTime
                                 )
                           );
                        var showDisciplineColumn =
                           IndexModel.ShouldShowDisciplineColumn(
                              participants
                           );
                        var hideRepresentedEntityColumn =
                           IndexModel.ShouldHideRepresentedEntityColumn(
                              participants
                           );
                        var showRepresentedEntityColumn =
                           participants.Any(
                              participant =>
                                 participant
                                    .HasNonNationalTeamRepresentation
                           ) && !hideRepresentedEntityColumn;
                        var representedEntityColumnClass =
                           "activity-participant-col-represented";
                        var representedTableClass =
                           "activity-participant-table-has-represented";
                        var participantTableClass =
                           showStartTimeColumn
                              ? "activity-participant-table " +
                                 "activity-participant-table-" +
                                 "has-start-time"
                              : "activity-participant-table";
                        const string startTimeLinkClass =
                           "activity-participant-start-time-link";
                        if(showDisciplineColumn)
                        {
                           participantTableClass +=
                              " activity-participant-table-has-discipline";
                        }
                        if(showRepresentedEntityColumn)
                        {
                           participantTableClass +=
                              " " + representedTableClass;
                        }
                        var activeParticipantCount = participants.Count(
                           participant => participant.IsActive
                        );
                        var hasCollapsibleInactiveParticipants =
                           participants.Any(
                              participant =>
                                 !participant.IsActive &&
                                 !participant.IsWatchedByMember
                           );
                        var shouldCollapseParticipants = participants
                           .Where(participant => participant.IsActive)
                           .Skip(maxVisibleParticipants)
                           .Any(
                              participant =>
                                 !participant.IsWatchedByMember
                           );
                        var shouldCollapseInactiveParticipants =
                           IndexModel.ShouldCollapseInactiveParticipants(
                              activeParticipantCount,
                              hasCollapsibleInactiveParticipants
                           );
                        var shouldCombineParticipantToggles =
                           IndexModel.ShouldCombineParticipantToggles(
                              shouldCollapseParticipants,
                              hasCollapsibleInactiveParticipants
                           );
                        if(shouldCollapseParticipants)
                        {
                           participantTableClass +=
                              " activity-participant-table-collapsed";
                        }
                        if(shouldCollapseInactiveParticipants)
                        {
                           participantTableClass +=
                              " activity-participant-table-inactive-" +
                              "collapsed";
                        }
                        var participantTableId =
                           $"participant-table-{activity.Id:N}";
                        var watchPriorityBadgeClass =
                           "activity-participant-watch-" +
                           "priority-badge";
                        var watchedParticipantBadgeClass =
                           "activity-participant-watched-badge";
                        <div class="activity-participant-table-wrap">
                           <div class="activity-participant-table-frame">
                              <table id="@participantTableId"
                                     class="@participantTableClass"
                                     data-participant-table>
                              <thead>
                                 <tr>
                                    <th class=
                                           "activity-participant-col-name"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="name">
                                          Namn
                                       </button>
                                    </th>
                                    @if(showStartTimeColumn)
                                    {
                                       <th class=
                                          "activity-participant-col-start-time"
                                           aria-sort="none">
                                          <button type="button"
                                                  data-participant-sort=
                                                     "start-time">
                                             Starttid
                                          </button>
                                       </th>
                                    }
                                    @if(showDisciplineColumn)
                                    {
                                       <th class=
                                          "activity-participant-col-discipline"
                                          aria-sort="none">
                                          <button type="button"
                                                  data-participant-sort=
                                                     "discipline">
                                             Disciplin
                                          </button>
                                       </th>
                                    }
                                    @if(showRepresentedEntityColumn)
                                    {
                                       <th class=
                                          "@representedEntityColumnClass">
                                          Lag
                                       </th>
                                    }
                                    <th class=
                                           "activity-participant-col-age"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="age">
                                          Ålder
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-club"
                                        aria-sort="none">
                                       <button type="button"
                                               data-participant-sort="club">
                                          Moderklubb/Klubb
                                       </button>
                                    </th>
                                    <th class=
                                           "activity-participant-col-country">
                                    </th>
                                 </tr>
                              </thead>
                              <tbody>
                                 @{ var activeParticipantCountBeforeRow = 0; }
                                 @for(var participantIndex = 0;
                                       participantIndex <
                                          participants.Count;
                                       participantIndex++)
                                 {
                                    var participant =
                                       participants[participantIndex];
                                    var representedEntityCanonicalName =
                                       participant
                                          .RepresentedEntityCanonicalName ??
                                       participant
                                          .RepresentedEntityName;
                                    var age = IndexModel.CalculateAge(
                                       participant.Birthdate,
                                       Model.CurrentDate
                                    );
                                    var isWatchedParticipant =
                                       participant.IsWatchedByMember;
                                    var activeParticipantIndex =
                                       activeParticipantCountBeforeRow;
                                    if(participant.IsActive)
                                    {
                                       activeParticipantCountBeforeRow++;
                                    }
                                    var rowClass = !participant.IsActive
                                       ? "activity-participant-inactive"
                                       : shouldCollapseParticipants &&
                                          !isWatchedParticipant &&
                                          activeParticipantIndex >=
                                             maxVisibleParticipants
                                          ? "activity-participant-row-" +
                                             "collapsed"
                                          : null;
                                    if(isWatchedParticipant)
                                    {
                                       rowClass = string.IsNullOrWhiteSpace(
                                          rowClass
                                       )
                                          ? "activity-participant-watched"
                                          : rowClass +
                                             " activity-participant-watched";
                                    }
                                    <tr class="@rowClass"
                                        data-participant-name=
                                           "@participant.Name"
                                        data-participant-start-time=
                                           "@participant.StartTime"
                                        data-participant-discipline=
                                           "@participant.DisciplineAliasName"
                                        data-participant-age="@age"
                                        data-participant-club=
                                           "@participant.Club">
                                       <td class="activity-participant-name
                                          activity-participant-col-name">
                                          @participant.Name
                                          @if(participant.WatchPriority == 0)
                                          {
                                             <span class=
                                                "@watchPriorityBadgeClass"
                                                   role="img"
                                                   aria-label="@(
                                                      highestWatchPriorityLabel
                                                   )">
                                                ★
                                             </span>
                                          }
                                          @if(isWatchedParticipant)
                                          {
                                             <span class=
                                                "@watchedParticipantBadgeClass"
                                                aria-label="Bevakad person">
                                                Bevakad
                                             </span>
                                          }
                                          @if(!participant.IsActive)
                                          {
                                             <span class=
                                       "activity-participant-out-badge">
                                                UTE
                                             </span>
                                          }
                                       </td>
                                       @if(showStartTimeColumn)
                                       {
                                          var participantStartTime =
                                             PublicTimeDisplay
                                                .FormatExactTimeText(
                                                   participant.StartTime
                                                );
                                          var sourceUrl =
                                             participant.StartTimeSourceUrl;
                                          var hasStartTimeSource =
                                             !string.IsNullOrWhiteSpace(
                                                participant.StartTime
                                             ) &&
                                             !string.IsNullOrWhiteSpace(
                                                sourceUrl
                                             ) &&
                                             SourceDisplay
                                                .IsPubliclyVisibleSourceUrl(
                                                   sourceUrl,
                                                   blockedSourceHosts
                                                );
                                          <td class=
                                         "activity-participant-col-start-time">
                                             @if(hasStartTimeSource)
                                             {
                                                <a class=
                                                   "@startTimeLinkClass"
                                                   href="@sourceUrl"
                                                   target="_blank"
                                                   rel="noopener noreferrer">
                                                   @participantStartTime
                                                </a>
                                             }
                                             else
                                             {
                                                @participantStartTime
                                             }
                                          </td>
                                       }
                                       @if(showDisciplineColumn)
                                       {
                                          <td class=
                                         "activity-participant-col-discipline">
                                             @participant.DisciplineAliasName
                                          </td>
                                       }
                                       @if(showRepresentedEntityColumn)
                                       {
                                          <td class=
                                             "@representedEntityColumnClass">
                                             <span class=
                                                "activity-team-name-portrait">
                                                @(
                                                   participant
                                                      .RepresentedEntityName
                                                )
                                             </span>
                                             <span class=
                                                "activity-team-name-landscape">
                                                @representedEntityCanonicalName
                                             </span>
                                          </td>
                                       }
                                       <td class=
                                              "activity-participant-col-age">
                                          @(age is null
                                          ? string.Empty
                                          : $"{age} år")
                                       </td>
                                       <td class=
                                              "activity-participant-col-club">
                                          @participant.Club
                                       </td>
                                       <td class=
                                          "activity-participant-col-country">
                                          <img class=
                                                  "participant-country-flag"
                                               src="~/images/flags/se.svg"
                                               alt="@(
                                                  PrimaryCountry
                                                     .LocalDisplayName
                                               )" />
                                       </td>
                                    </tr>
                                 }
                              </tbody>
                              </table>
                           </div>
                           @if(shouldCollapseParticipants)
                           {
                              <button type="button"
                                      class=
                                         "activity-participant-toggle"
                                      data-participant-toggle
                                      data-participant-toggle-full="@(
                                         shouldCombineParticipantToggles
                                            ? "true"
                                            : "false"
                                      )"
                                      data-collapsed-label="Visa alla"
                                      data-expanded-label="Visa färre"
                                      aria-controls="@participantTableId"
                                      aria-expanded="false">
                                 Visa alla
                              </button>
                           }
                           @if(hasCollapsibleInactiveParticipants &&
                              !shouldCombineParticipantToggles)
                           {
                              var inactiveParticipantsAreCollapsed =
                                 shouldCollapseInactiveParticipants;
                              <button type="button"
                                      class="activity-participant-toggle
                                         activity-participant-inactive-toggle"
                                      data-participant-inactive-toggle
                                      data-collapsed-label="Visa utslagna"
                                      data-expanded-label="Dölj utslagna"
                                      aria-controls="@participantTableId"
                                      aria-expanded="@(
                                         inactiveParticipantsAreCollapsed
                                            ? "false"
                                            : "true"
                                      )">
                                 @(inactiveParticipantsAreCollapsed
                                    ? "Visa utslagna"
                                    : "Dölj utslagna")
                              </button>
                           }
                        </div>
                     }
                     @if(activitySources.Count > 0)
                     {
                        <details class="activity-sources">
                           <summary class="activity-sources-toggle">
                              Källor
                           </summary>
                           <table class="activity-sources-table">
                              <tbody>
                                 @foreach(var source in activitySources)
                                 {
                                    <tr>
                                       <td class="activity-source-kind">
                                          @SourceDisplay.FormatKind(
                                             source.Kind
                                          )
                                       </td>
                                       <td>
                                          <a class="activity-source-link"
                                             href="@source.Url"
                                             target="_blank"
                                             rel="noopener noreferrer">
                                             @source.Url
                                          </a>
                                       </td>
                                    </tr>
                                 }
                              </tbody>
                           </table>
                        </details>
                     }
                  </article>
               </div>
            </section>
      }
      @if(Model.HasPublishedActivitiesTomorrow &&
         !Model.IsWatchedActivitiesView)
      {
         var tomorrowUrl = PublicRoutePaths.Home + "?date=" +
            Uri.EscapeDataString(
               DateDisplay.Format(Model.TomorrowDate)
            );
          var normalizedSport = Model.Sport?.Trim();
          if(!string.IsNullOrWhiteSpace(normalizedSport))
          {
             tomorrowUrl += "&sport=" + Uri.EscapeDataString(
                normalizedSport
             );
             var normalizedCountry = Model.Country?.Trim();
             if(!string.IsNullOrWhiteSpace(normalizedCountry))
             {
                tomorrowUrl += "&country=" +
                   Uri.EscapeDataString(normalizedCountry);
             }
          }
         <div class="activity-tomorrow-link-row">
            <span class="activity-tomorrow-link-line"></span>
            <a class="activity-tomorrow-link"
               href="@tomorrowUrl"
               aria-label="Visa aktiviteter @Model.NextDateLinkLabel">
               @Model.NextDateLinkLabel
            </a>
            <span class="activity-tomorrow-link-line"></span>
         </div>
      }
   </div>
}

@section Scripts {
   <script src="~/js/public-app-install.js"
           asp-append-version="true"></script>
   <script src="~/js/public-date-select.js"
           asp-append-version="true"></script>
   <script src="~/js/public-sport-select.js"
           asp-append-version="true"></script>
   <script src="~/js/public-participant-table.js"
           asp-append-version="true"></script>
   <script src="~/js/public-past-activities.js"
           asp-append-version="true"></script>
   <script src="~/js/public-activity-title-fit.js"
           asp-append-version="true"></script>
}
