@page "/login"
@model SESport.Web.Pages.Account.LoginModel
@{
   ViewData["Title"] = "Logga in";
}

<section class="login-panel member-login-panel">
   <p class="eyebrow">Logga in</p>

   @if(Model.LinkRequested)
   {
      <div class="notice">
         Vi har skickat en inloggningslänk.
         Öppna mejlet och klicka på länken för att logga in.
      </div>
   }
   else
   {
      <p>
         Ange din e-postadress så skickar vi en inloggningslänk. Det spelar
         ingen roll om du redan har konto eller är ny här.
      </p>

      <div asp-validation-summary="ModelOnly"
           class="notice notice-error"></div>

      <form method="post">
         <input asp-for="ReturnUrl" type="hidden" />
         <label class="member-login-email-field">
            <input asp-for="Email"
                   aria-label="E-postadress"
                   placeholder="e-post"
                   type="email"
                   autocomplete="email"
                   autofocus />
         </label>
         <span asp-validation-for="Email"></span>
         <button class="button button-primary member-login-submit"
                 type="submit">
            SKICKA
         </button>
      </form>
   }
</section>
