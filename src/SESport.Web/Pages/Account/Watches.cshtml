@page "/bevakningar"
@model SESport.Web.Pages.Account.WatchesModel
@{
   ViewData["Title"] = "Bevakningar";
   var searchUrl = Url.Page("/Account/Watches", "Search");
}

<section class="member-watches-page">
   <h1 class="member-watches-section-title">LÄGG TILL</h1>

   <div class="member-watches-search-container"
        data-member-watch-search
        data-member-watch-search-url="@searchUrl">
      <form class="member-watches-search"
            method="get"
            data-member-watch-search-form>
         <label class="member-watches-search-field">
            <input name="q"
                   id="member-watches-search-input"
                   placeholder="Sök person"
                   aria-label="Sök person"
                   aria-controls="member-watch-search-results"
                   aria-expanded="false"
                   aria-autocomplete="list"
                   autocomplete="off"
                   autofocus
                   data-member-watch-search-input />
         </label>
      </form>
      <div class="member-watches-search-results"
           id="member-watch-search-results"
           data-member-watch-search-results
           aria-live="polite"
           hidden></div>
   </div>

   @if(Model.WatchedEntities.Count > 0)
   {
      <h2 class="member-watches-section-title">Dina bevakningar</h2>
      <ul class="member-watch-results">
         @foreach(var watch in Model.WatchedEntities)
         {
            <li class="member-watch-result">
               <span class="member-watch-name">
                  @watch.Name
                  <span class="member-watch-information">
                     (@watch.DisplayInformation)
                  </span>
               </span>
               <form method="post"
                     asp-page-handler="Remove"
                     class="member-watch-action-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden"
                         name="entityId"
                         value="@watch.Id" />
                  <button class="member-watch-action-button
                     member-watch-remove-button"
                          type="submit">
                     Ta bort
                  </button>
               </form>
            </li>
         }
      </ul>
   }
</section>

@section Scripts {
   <script src="~/js/member-watches.js"
           asp-append-version="true"></script>
}
