@page "/bevakningar"
@model SESport.Web.Pages.Account.WatchesModel
@{
   ViewData["Title"] = "Bevakningar";
   var searchUrl = Url.Page("/Account/Watches", "Search");
}

<section class="member-watches-page">
   <div class="member-watches-push-status"
        data-member-watch-push-status
        data-member-watch-push-configured="@(
           Model.PushNotificationsConfigured ? "true" : "false"
        )"
        data-member-watch-vapid-public-key="@Model.PushPublicKey"
        aria-live="polite">
      <p data-member-watch-push-status-text>
         Kontrollerar notiser...
      </p>
      <button class="member-watch-action-button
         member-watches-push-action"
              type="button"
              data-member-watch-push-activate
              hidden>
         AKTIVERA NOTISER
      </button>
      <form method="post"
            asp-page-handler="RegisterPush"
            data-member-watch-push-registration-form
            hidden>
         @Html.AntiForgeryToken()
         <input type="hidden"
                name="pushSubscription"
                data-member-watch-push-subscription />
      </form>
   </div>

   <form class="member-watches-notification-settings"
         method="post"
         asp-page-handler="SetNotificationLeadTime"
         data-member-watch-notification-form
         data-member-watch-auto-submit-form>
      @Html.AntiForgeryToken()
      <select id="member-watch-notification-lead-time"
              name="notificationLeadTimeMinutes"
              aria-label="När ska notisen skickas?">
         @foreach(var option in Model.NotificationLeadTimeOptions)
         {
            <option value="@option.Minutes"
                    selected="@(option.Minutes ==
                       Model.NotificationLeadTimeMinutes)">
               @option.Label
            </option>
         }
      </select>
   </form>

   <h1 class="member-watches-section-title">LÄGG TILL</h1>

   <div class="member-watches-search-container"
        data-member-watch-search
        data-member-watch-search-url="@searchUrl"
        data-member-watch-push-configured="@(
           Model.PushNotificationsConfigured ? "true" : "false"
        )"
        data-member-watch-vapid-public-key="@Model.PushPublicKey">
      <form class="member-watches-search"
            method="get"
            data-member-watch-search-form>
         <label class="member-watches-search-field">
            <input name="q"
                   id="member-watches-search-input"
                   placeholder="Sök person"
                   aria-label="Sök person"
                   aria-controls="member-watch-search-results"
                   aria-expanded="false"
                   aria-autocomplete="list"
                   autocomplete="off"
                   data-member-watch-search-input />
         </label>
      </form>
      <div class="member-watches-search-results"
           id="member-watch-search-results"
           data-member-watch-search-results
           aria-live="polite"
           hidden></div>
   </div>

   @if(Model.WatchedEntities.Count > 0)
   {
      <div class="member-watches-list-header">
         <h2 class="member-watches-section-title">Dina bevakningar</h2>
         <form class="member-watches-sort-settings"
               method="get"
               data-member-watch-auto-submit-form>
            <select id="member-watch-sort"
                    aria-label="Sortering"
                    name="@WatchesModel.SortQueryParameter">
               @foreach(var option in Model.SortOptions)
               {
                  <option value="@option.Value"
                          selected="@(option.Value == Model.Sort)">
                     @option.Label
                  </option>
               }
            </select>
         </form>
      </div>
      <ul class="member-watch-results">
         @foreach(var watch in Model.WatchedEntities)
         {
            var nextActivity = watch.NextActivity;
            var primaryImageUrl = Url.Page(
               "/Account/Watches",
               "Image",
               new { entityId = watch.Id }
            );
            <li class="member-watch-result">
               @if(watch.HasPrimaryImage &&
                  watch.PrimaryImageSource is not null)
               {
                  var imageSource = watch.PrimaryImageSource;
                  var sourceTooltipId =
                     $"member-watch-image-source-{watch.Id:N}";
                  <span class="member-watch-image-container">
                     <a class="member-watch-avatar
                        member-watch-image-link"
                        href="@imageSource.SourceUrl"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Bildkälla för @watch.Name"
                        aria-describedby="@sourceTooltipId">
                        <img class="member-watch-image"
                             src="@primaryImageUrl"
                             alt=""
                             loading="lazy"
                             decoding="async"
                             aria-hidden="true" />
                     </a>
                     <span class="member-watch-image-tooltip"
                           id="@sourceTooltipId">
                        @if(!string.IsNullOrWhiteSpace(
                           imageSource.CreatorName
                        ))
                        {
                           <span>Foto: @imageSource.CreatorName</span>
                        }
                        @if(!string.IsNullOrWhiteSpace(
                           imageSource.LicenseUrl
                        ))
                        {
                           <a href="@imageSource.LicenseUrl"
                              target="_blank"
                              rel="noopener noreferrer">
                              @imageSource.LicenseName
                           </a>
                        }
                        else
                        {
                           <span>@imageSource.LicenseName</span>
                        }
                        <span>Wikimedia Commons</span>
                     </span>
                  </span>
               }
               else if(watch.HasPrimaryImage)
               {
                  <span class="member-watch-avatar"
                        aria-hidden="true">
                     <img class="member-watch-image"
                          src="@primaryImageUrl"
                          alt=""
                          loading="lazy"
                          decoding="async" />
                  </span>
               }
               else
               {
                  <span class="member-watch-avatar"
                        aria-hidden="true">
                     <svg viewBox="0 0 24 24"
                          focusable="false"
                          aria-hidden="true">
                        <path fill="currentColor"
                              d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4
                                 1.79-4 4 1.79 4 4 4Zm0 2c-4.42 0-8 1.79-8
                                 4v2h16v-2c0-2.21-3.58-4-8-4Z" />
                     </svg>
                  </span>
               }
               <div class="member-watch-name">
                  @watch.Name
                  <span class="member-watch-information">
                     (@watch.DisplayInformation)
                  </span>
                  @if(nextActivity is not null)
                  {
                     <span class="member-watch-next-activity">
                        NÄSTA:
                        @TimeDisplay.FormatLocalTimestampWithoutSeconds(
                           nextActivity.StartsAt
                        ), @nextActivity.Title
                        @if(!string.IsNullOrWhiteSpace(
                           nextActivity.RelatedOrganizationName
                        ))
                        {
                           <text>, @nextActivity.RelatedOrganizationName</text>
                        }
                     </span>
                  }
               </div>
               <form method="post"
                     asp-page-handler="Remove"
                     class="member-watch-action-form">
                  @Html.AntiForgeryToken()
                  <input type="hidden"
                         name="entityId"
                         value="@watch.Id" />
                  <button class="member-watch-action-button
                     member-watch-remove-button"
                          type="submit">
                     Ta bort
                  </button>
               </form>
            </li>
         }
      </ul>
   }
</section>

@section Scripts {
   <script src="~/js/member-watches.js"
           asp-append-version="true"></script>
}
