@using SESport.Data.Models
@model IReadOnlyList<MemberPersonListItem>

<div data-member-watch-search-partial>
   <p class="member-watches-search-status"
      data-member-watch-search-status
      hidden></p>
   @if(Model.Count == 0)
   {
      <p class="member-watches-empty">Inga personer hittades.</p>
   }
   else
   {
      <ul class="member-watch-results">
         @foreach(var person in Model)
         {
            <li class="member-watch-result member-watch-search-result
               @(person.IsWatched ? "member-watch-search-result-added" : "")"
                data-member-watch-add-row="@(
                   person.IsWatched ? null : "true"
                )">
               @await Html.PartialAsync("_WatchPersonAvatar", person)
               <span class="member-watch-name">
                  @person.Name
                  <span class="member-watch-information">
                     (@person.DisplayInformation)
                  </span>
               </span>
               @if(person.IsWatched)
               {
                  <span class="member-watch-already-added-label">
                     Redan tillagd
                  </span>
               }
               else
               {
                  <form method="post"
                        asp-page-handler="Add"
                        class="member-watch-action-form"
                        data-member-watch-add-form>
                     @Html.AntiForgeryToken()
                     <input type="hidden"
                            name="entityId"
                            value="@person.Id" />
                     <input type="hidden"
                            name="pushSubscription"
                            value="" />
                     <button class="member-watch-action-button"
                             type="submit"
                             aria-label="Bevaka @person.Name">
                        Bevaka
                     </button>
                  </form>
               }
            </li>
         }
      </ul>
   }
</div>
