@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using SESport.Data.Models
@using SESport.Web.Formatting
@model IReadOnlyList<MemberWatchListItem>

<div data-member-watch-search-partial>
   <p class="member-watches-search-status"
      data-member-watch-search-status
      hidden></p>
   @if(Model.Count == 0)
   {
      <p class="member-watches-empty">
         Inga personer, lag eller landslag hittades.
      </p>
   }
   else
   {
      <ul class="member-watch-results">
         @foreach(var entity in Model)
         {
            <li class="member-watch-result member-watch-search-result
               @(entity.IsWatched ? "member-watch-search-result-added" : "")"
                data-member-watch-add-row="@(
                   entity.IsWatched ? null : "true"
                )">
               @await Html.PartialAsync("_WatchEntityAvatar", entity,
                  new ViewDataDictionary(ViewData)
                  {
                     ["DisableImageSourceLink"] = true
                  })
               <span class="member-watch-name">
                  @entity.Name
                  @if(!string.IsNullOrWhiteSpace(entity.AliasName))
                  {
                     <span class="member-watch-information">
                        (@entity.AliasName)
                     </span>
                  }
                  <span class="member-watch-information">
                     (@MemberWatchEntityFormatter.GetTypeLabel(
                        entity.EntityTypeId
                     ), @entity.DisplayInformation)
                  </span>
               </span>
               @if(entity.IsWatched)
               {
                  <span class="member-watch-already-added-label">
                     Redan tillagd
                  </span>
               }
               else
               {
                  <form method="post"
                        asp-page-handler="Add"
                        class="member-watch-action-form"
                        data-member-watch-add-form>
                     @Html.AntiForgeryToken()
                     <input type="hidden"
                            name="entityId"
                            value="@entity.Id" />
                     <input type="hidden"
                            name="pushSubscription"
                            value="" />
                     <button class="member-watch-action-button"
                             type="submit"
                             aria-label="Bevaka @entity.Name">
                        Bevaka
                     </button>
                  </form>
               }
            </li>
         }
      </ul>
   }
</div>
