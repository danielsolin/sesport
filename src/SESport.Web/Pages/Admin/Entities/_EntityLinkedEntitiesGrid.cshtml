@model SESport.Web.Pages.Admin.Entities.EntityLinkedEntitiesGridViewModel

<div data-entity-linked-entities-grid>
   @if(Model.Options.Count == 0)
   {
      <div class="notice" data-entity-linked-entities-empty>
         No linked entities.
      </div>
   }
   else
   {
      <div class="admin-table-wrap">
         <table class="admin-table admin-table-compact
                       entity-linked-entities-table">
            <thead>
               <tr>
                  <th>Name</th>
                  <th>Entity Type</th>
                  <th>Sport</th>
                  <th></th>
               </tr>
            </thead>
            <tbody data-entity-linked-entities-rows>
               @foreach(var option in Model.Options)
               {
                  <tr data-entity-linked-entities-row
                      data-entity-id="@option.Id">
                     <td>
                        <a asp-page="/Admin/Entities/Edit"
                           asp-route-id="@option.Id">
                           @option.Name
                        </a>
                     </td>
                     <td>@option.EntityType</td>
                     <td>@option.Sport</td>
                     <td class="table-actions">
                        <input type="hidden"
                               name="Entity.LinkedEntityIds"
                               value="@option.Id"
                               data-entity-linked-entities-hidden-id />
                        <button type="button"
                                data-entity-linked-entities-remove
                                aria-label="Remove @option.Name">
                           Delete
                        </button>
                     </td>
                  </tr>
               }
            </tbody>
         </table>
      </div>
   }
</div>
