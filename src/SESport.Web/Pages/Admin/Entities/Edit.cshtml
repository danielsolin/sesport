@page "{id:guid?}"
@model SESport.Web.Pages.Admin.Entities.EditModel
@{
   ViewData["Title"] = Model.Entity.Id is null ? "New Entity" : "Edit Entity";
   var entitySearchUrl = Url.Page("/Admin/Ajax/Search/Entity");
   var entityLinkUpdateUrl = Url.Page("/Admin/Ajax/Update/EntityLink");
   var isPersonEntity = string.Equals(
      Model.Entity.EntityTypeId,
      "Person",
      StringComparison.OrdinalIgnoreCase
   );
}

<section class="page-heading page-heading-row">
   <div>
      <h1>@ViewData["Title"]</h1>
   </div>
   @if(Model.Entity.Id is not null)
   {
      <a class="button"
         asp-page="./Merge"
         asp-route-sourceId="@Model.Entity.Id">
         Merge duplicate
      </a>
   }
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">@Model.LoadError</div>
}

<form method="post" class="edit-form">
   <input asp-for="Entity.Id" type="hidden" />
   <div asp-validation-summary="ModelOnly" class="notice notice-error"></div>

   <section class="form-section">
      <h2>Entity</h2>
      <div class="form-grid">
         <label>
            <span>Canonical name</span>
            <input asp-for="Entity.CanonicalName" />
            <span asp-validation-for="Entity.CanonicalName"></span>
         </label>
         <label>
            <span>Alias name</span>
            <input asp-for="Entity.AliasName" />
            <span asp-validation-for="Entity.AliasName"></span>
         </label>
         <label>
            <span>Type</span>
            <select asp-for="Entity.EntityTypeId"
                    data-entity-type-select>
               <option value="">Select entity type</option>
               @foreach (var type in Model.EntityTypes)
               {
                  <option value="@type.Id">@type.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.EntityTypeId"></span>
         </label>
         <label>
            <span>Sport</span>
            <select asp-for="Entity.SportId">
               <option value="">Select sport</option>
               @foreach (var sport in Model.Sports)
               {
                  <option value="@sport.Id">@sport.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.SportId"></span>
         </label>
         <label>
            <span>Watch priority</span>
            <select asp-for="Entity.WatchPriorityId">
               <option value="">Select watch priority</option>
               @foreach (var priority in Model.WatchPriorities)
               {
                  <option value="@priority.Id">@priority.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.WatchPriorityId"></span>
         </label>
         <label>
            <span>Expected stability</span>
            <select asp-for="Entity.ExpectedStabilityId">
               <option value="">Select stability</option>
               @foreach (var stability in Model.StabilityKinds)
               {
                  <option value="@stability.Id">@stability.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.ExpectedStabilityId"></span>
         </label>
         <label data-person-gender-field
                style="@(isPersonEntity ? "" : "display: none;")">
            <span>Gender</span>
            <select asp-for="Entity.PersonGenderId">
               <option value="">Select gender</option>
               @foreach (var gender in Model.PersonGenders)
               {
                  <option value="@gender.Id">@gender.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.PersonGenderId"></span>
         </label>
         <label data-person-birthdate-field
                style="@(isPersonEntity ? "" : "display: none;")">
            <span>Birthdate</span>
            <input asp-for="Entity.Birthdate" type="date" />
            <span asp-validation-for="Entity.Birthdate"></span>
         </label>
         <label data-person-height-field
                style="@(isPersonEntity ? "" : "display: none;")">
            <span>Height (cm)</span>
            <input asp-for="Entity.Height" type="number" min="0" />
            <span asp-validation-for="Entity.Height"></span>
         </label>
         <label data-person-weight-field
                style="@(isPersonEntity ? "" : "display: none;")">
            <span>Weight (kg)</span>
            <input asp-for="Entity.Weight" type="number" min="0" />
            <span asp-validation-for="Entity.Weight"></span>
         </label>
      </div>
   </section>

   <section class="form-section">
      <h2>Linked entities</h2>
      <div class="entity-linked-entities-field">
         <span>Connections</span>
         <div class="entity-linked-entities-picker broadcast-org-autocomplete"
              data-entity-linked-entities-picker
              data-entity-linked-entities-search-url="@entitySearchUrl"
              data-entity-linked-entities-update-url="@entityLinkUpdateUrl"
              data-entity-id="@(Model.Entity.Id?.ToString() ?? string.Empty)"
              data-organization-only="false"
              data-max-results="20">
            <div class="entity-linked-entities-input-wrap">
               <input class="broadcast-org-entity-input
                            entity-linked-entities-input"
                      type="text"
                      placeholder="Search linked entities"
                      autocomplete="off"
                      spellcheck="false"
                      aria-label="Search linked entities"
                      data-entity-linked-entities-input />
               <div class="broadcast-org-entity-suggestions"
                    hidden
                    data-entity-linked-entities-suggestions></div>
            </div>
            <div class="entity-linked-entities-selected"
                 data-entity-linked-entities-selected>
               @foreach(var option in Model.LinkedEntityOptions)
               {
                  <span class="entity-linked-entities-chip"
                        data-entity-linked-entities-chip
                        data-entity-id="@option.Id">
                     <input type="hidden"
                            name="Entity.LinkedEntityIds"
                            value="@option.Id"
                            data-entity-linked-entities-hidden-id />
                     <span>
                        @option.Name (@option.EntityType, @option.Sport)
                     </span>
                     <button type="button"
                             class="entity-linked-entities-chip-remove"
                             data-entity-linked-entities-chip-remove
                             aria-label="@($"Remove {option.Name}")">
                        ×
                     </button>
                  </span>
               }
            </div>
         </div>
      </div>

      <h3 class="subgrid-heading">Activities</h3>
      @if(Model.Activities.Count == 0)
      {
         <div class="notice">
            No linked activities.
         </div>
      }
      else
      {
         <div class="admin-table-wrap">
            <table class="admin-table admin-table-compact
                          entity-activities-table">
               <thead>
                  <tr>
                     <th>Activity Date/Time</th>
                     <th>Activity Title</th>
                     <th>Org</th>
                     <th>Sport / Activity Type</th>
                     <th>Activity Status</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach(var activity in Model.Activities)
                  {
                     <tr>
                        <td>
                           @DateDisplay.Format(
                              activity.ActivityDate,
                              activity.LocalStartTime
                           )
                        </td>
                        <td>
                           <a asp-page="/Admin/Activities/Edit"
                              asp-route-id="@activity.Id">
                              @activity.Title
                           </a>
                        </td>
                        <td>@activity.Organization</td>
                        <td>@activity.Sport / @activity.ActivityType</td>
                        <td>@activity.PublicationStatus</td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      }
   </section>

   <section class="form-section">
      <h2>Country relevance</h2>
      <div class="form-grid">
         <label>
            <span>Country</span>
            <select asp-for="Entity.CountryId">
               <option value="">Select country</option>
               @foreach (var country in Model.Countries)
               {
                  <option value="@country.Id">@country.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.CountryId"></span>
         </label>
         <label>
            <span>Relevance kind</span>
            <select asp-for="Entity.CountryRelevanceKindId">
               <option value="">Select relevance kind</option>
               @foreach (var kind in Model.CountryRelevanceKinds)
               {
                  <option value="@kind.Id">@kind.Label</option>
               }
            </select>
            <span asp-validation-for="Entity.CountryRelevanceKindId"></span>
         </label>
      </div>
      <label>
         <span>Relevance reason</span>
         <textarea asp-for="Entity.CountryRelevanceReason" rows="3"></textarea>
         <span asp-validation-for="Entity.CountryRelevanceReason"></span>
      </label>
   </section>

   <section class="form-actions">
      <button class="button button-primary" type="submit">Save</button>
   </section>
</form>

@section Scripts {
   <script src="~/js/entity-linked-entities.js"
           asp-append-version="true"></script>
}
