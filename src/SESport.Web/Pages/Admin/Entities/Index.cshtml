@page
@model SESport.Web.Pages.Admin.Entities.IndexModel
@{
   ViewData["Title"] = "Entities";
   var entityFieldUrl = Url.Page("/Admin/Ajax/Update/EntityField");
   var entitySearchUrl = Url.Page("/Admin/Ajax/Search/Entity");
   var personFactsUrl = Url.Page("/Admin/Ajax/Create/PersonFacts");
   var entityEditUrl = Url.Page("./Edit");
   var entityDeleteUrl = Url.Page("./Index");
   var searchUrlBase = ViewData["SearchUrl"] as string ?? string.Empty;
   var todoReturnUrl = $"{Request.Path}{Request.QueryString}";
}

@Html.AntiForgeryToken()

<section class="page-heading page-heading-row">
   <div class="page-heading-title-row">
      <h1>Entities</h1>
   </div>
   <div class="button-row">
      <a class="button button-primary" asp-page="./Edit">New entity</a>
      <details class="todo-composer">
         <summary class="button">Todo</summary>
         <form method="post"
               asp-page-handler="AddTodo"
               class="todo-composer-form">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="returnUrl"
                   value="@todoReturnUrl" />
            <label>
               <span>Todo</span>
               <textarea name="text"
                         rows="3"
                         maxlength="2000"
                         required></textarea>
            </label>
            <button class="button button-primary" type="submit">
               Save
            </button>
         </form>
      </details>
   </div>
</section>

<section class="form-section">
   <form method="get"
         class="entity-filter-grid"
         data-preserve-get-form-state>
      <label>
         <span>Filter</span>
         <input type="text"
            class="entity-name-filter"
            placeholder="name"
            autofocus
            value="@Model.Filter"
            aria-label="Filter entities by name"
            data-entity-name-filter
         />
      </label>
      <label>
         <span>Activity Date</span>
         <input type="date"
                name="@RouteKeys.Date"
                value="@Model.DateText"
                data-entity-date-filter
                onchange="this.form.submit();" />
         @await Html.PartialAsync("/Pages/Shared/_AdminDateStepper.cshtml")
      </label>
      <label>
         <span>Type</span>
         <div class="multi-select-row">
            <select asp-items="Model.GetEntityTypeOptions()"
                    multiple
                    class="ses-multiselect entity-type-filter"
                    data-multi-select
                    data-theme="light"
                    data-placeholder="All"
                    data-list-all="false"
                    data-entity-type-filter>
            </select>
         </div>
      </label>
      <label>
         <span>Sport</span>
         <div class="multi-select-row">
            <select asp-items="Model.GetSportOptions()"
                    multiple
                    class="ses-multiselect entity-sport-filter"
                    data-multi-select
                    data-theme="light"
                    data-placeholder="All"
                    data-list-all="false"
                    data-entity-sport-filter>
            </select>
         </div>
      </label>
      <span class="entity-filter-count">
         Entities: <strong data-entity-count>0</strong>
      </span>
   </form>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}
else
{
   <div data-entity-list-container
        data-entity-search-url="@entitySearchUrl"
        data-person-facts-url="@personFactsUrl"
        data-entity-edit-url="@entityEditUrl"
        data-entity-delete-url="@entityDeleteUrl"
        data-entity-filter-cookie-name=
           "@IndexModel.FilterCookieName"
        data-entity-type-filter-cookie-name=
           "@IndexModel.TypeFilterCookieName"
        data-entity-sport-filter-cookie-name=
           "@IndexModel.SportFilterCookieName"
        data-entity-sort-column="@Model.SortColumn"
        data-entity-sort-asc="@Model.SortAsc.ToString().ToLowerInvariant()"
        data-entity-date="@Model.DateText"
        data-person-gender-female="@PersonGenderIds.Female"
        data-person-gender-male="@PersonGenderIds.Male"
        data-entity-search-url-base="@searchUrlBase">
      <div class="notice" data-entity-empty-state hidden>
         No matching entities.
      </div>
      <div class="admin-table-wrap"
           data-entity-inline-edit-url="@entityFieldUrl">
         <table class="admin-table admin-table-hover entities-table">
            <colgroup>
               <col class="entities-col-name" />
               <col class="entities-col-related" />
               <col class="entities-col-sport" />
               <col class="entities-col-gender" />
               <col class="entities-col-age" />
               <col class="entities-col-height" />
               <col class="entities-col-weight" />
               <col class="entities-col-first-club" />
               <col class="entities-col-watch-priority" />
               <col class="entities-col-actions" />
            </colgroup>
            <thead>
               <tr>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Name"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Name")'>
                        Name @Model.GetSortIndicator("Name")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Related"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Related")'>
                        RELATED @Model.GetSortIndicator("Related")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Sport"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Sport")'>
                        Sport @Model.GetSortIndicator("Sport")
                     </a>
                  </th>
                  <th>Gender</th>
                  <th>Age</th>
                  <th>Height</th>
                  <th>Weight</th>
                  <th>First Club</th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Watch"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Watch")'>
                        WP @Model.GetSortIndicator("Watch")
                     </a>
                  </th>
                  <th></th>
               </tr>
            </thead>
            @await Html.PartialAsync(
               "/Pages/Admin/Entities/_EntityRows.cshtml",
               new EntityRowsViewModel(
                  Model.Entities,
                  searchUrlBase,
                  personFactsUrl ?? string.Empty,
                  Model.WatchPriorities,
                  PersonGenderIds.Female,
                  PersonGenderIds.Male
               )
            )
         </table>
      </div>
   </div>
}

@section Scripts {
   <script src="~/Admin/js/entities-index.js"
           asp-append-version="true"></script>
}
