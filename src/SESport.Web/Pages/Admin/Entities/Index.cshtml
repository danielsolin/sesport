@page
@model SESport.Web.Pages.Admin.Entities.IndexModel
@{
   ViewData["Title"] = "Entities";
   var entityFieldUrl = Url.Page("/Admin/Ajax/Update/EntityField");
   var entitySearchUrl = Url.Page("/Admin/Ajax/Search/Entity");
   var personBioUrl = Url.Page("/Admin/Ajax/Create/PersonBio");
   var entityEditUrl = Url.Page("./Edit");
   var entityDeleteUrl = Url.Page("./Index");
   var searchUrlBase = ViewData["SearchUrl"] as string ?? string.Empty;
}

@Html.AntiForgeryToken()

<section class="page-heading page-heading-row">
   <div class="page-heading-title-row">
      <h1>Entities</h1>
   </div>
   <div class="button-row">
      <a class="button button-primary" asp-page="./Edit">New entity</a>
   </div>
</section>

<section class="form-section">
   <div class="entity-filter-grid">
      <label>
         <span>Filter</span>
         <input type="text"
            class="entity-name-filter"
            placeholder="name"
            autofocus
            value="@Model.Filter"
            aria-label="Filter entities by name"
            data-entity-name-filter
         />
      </label>
      <label>
         <span>Type</span>
         <div class="multi-select-row">
            <select asp-items="Model.GetEntityTypeOptions()"
                    multiple
                    class="ses-multiselect entity-type-filter"
                    data-multi-select
                    data-placeholder="All"
                    data-list-all="false"
                    data-entity-type-filter>
            </select>
         </div>
      </label>
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}
else
{
   <div data-entity-list-container
        data-entity-search-url="@entitySearchUrl"
        data-person-bio-url="@personBioUrl"
        data-entity-edit-url="@entityEditUrl"
        data-entity-delete-url="@entityDeleteUrl"
        data-entity-filter-cookie-name=
           "@IndexModel.FilterCookieName"
        data-entity-type-filter-cookie-name=
           "@IndexModel.TypeFilterCookieName"
        data-entity-sort-column="@Model.SortColumn"
        data-entity-sort-asc="@Model.SortAsc.ToString().ToLowerInvariant()"
        data-entity-search-url-base="@searchUrlBase">
      <div class="notice" data-entity-empty-state hidden>
         No matching entities.
      </div>
      <div class="admin-table-wrap"
           data-entity-inline-edit-url="@entityFieldUrl">
         <select hidden aria-hidden="true"
                 data-entity-watch-priority-template>
            @foreach(var option in Model.GetWatchPriorityOptions(null))
            {
               <option value="@option.Value">@option.Text</option>
            }
         </select>
         <table class="admin-table admin-table-hover entities-table">
            <colgroup>
               <col class="entities-col-name" />
               <col class="entities-col-bio" />
               <col class="entities-col-related" />
               <col class="entities-col-type" />
               <col class="entities-col-sport" />
               <col class="entities-col-watch-priority" />
               <col class="entities-col-country" />
               <col class="entities-col-actions" />
            </colgroup>
            <thead>
               <tr>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Name"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Name")'>
                        Name @Model.GetSortIndicator("Name")
                     </a>
                  </th>
                  <th>Bio</th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Related"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Related")'>
                        RELATED @Model.GetSortIndicator("Related")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Type"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Type")'>
                        Type @Model.GetSortIndicator("Type")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Sport"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Sport")'>
                        Sport @Model.GetSortIndicator("Sport")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Watch"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Watch")'>
                        Watch priority @Model.GetSortIndicator("Watch")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Country"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Country")'>
                        Country @Model.GetSortIndicator("Country")
                     </a>
                  </th>
                  <th></th>
               </tr>
            </thead>
            <tbody data-entity-list-body></tbody>
         </table>
      </div>
   </div>
}

@section Scripts {
   <script src="~/js/entities-index.js"
           asp-append-version="true"></script>
}
