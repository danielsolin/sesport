@page
@model SESport.Web.Pages.Admin.Entities.IndexModel
@{
   ViewData["Title"] = "Entities";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Entities</h1>
   </div>
   <div class="button-row">
      <a class="button" asp-page="/Admin/Index">Back</a>
      <a class="button button-primary" asp-page="./Edit">New entity</a>
   </div>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The entity table is not available right now.
   </div>
}
else if(Model.Entities.Count == 0)
{
   <div class="notice">No entities have been created yet.</div>
}
else
{
   <div class="admin-table-wrap">
      <table class="admin-table">
         <thead>
            <tr>
               <th>
                  <a asp-page="./Index"
                     asp-route-sortColumn="@IndexModel.NameSortColumn"
                     asp-route-sortAsc="@Model.GetNextSortAsc(IndexModel.NameSortColumn)">Name @Model.GetSortIndicator(IndexModel.NameSortColumn)</a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-route-sortColumn="@IndexModel.TypeSortColumn"
                     asp-route-sortAsc="@Model.GetNextSortAsc(IndexModel.TypeSortColumn)">Type @Model.GetSortIndicator(IndexModel.TypeSortColumn)</a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-route-sortColumn="@IndexModel.SportSortColumn"
                     asp-route-sortAsc="@Model.GetNextSortAsc(IndexModel.SportSortColumn)">Sport @Model.GetSortIndicator(IndexModel.SportSortColumn)</a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-route-sortColumn="@IndexModel.WatchSortColumn"
                     asp-route-sortAsc="@Model.GetNextSortAsc(IndexModel.WatchSortColumn)">Watch @Model.GetSortIndicator(IndexModel.WatchSortColumn)</a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-route-sortColumn="@IndexModel.StabilitySortColumn"
                     asp-route-sortAsc="@Model.GetNextSortAsc(IndexModel.StabilitySortColumn)">Stability @Model.GetSortIndicator(IndexModel.StabilitySortColumn)</a>
               </th>
               <th></th>
            </tr>
         </thead>
         <tbody>
            @foreach(var entity in Model.Entities)
            {
               <tr>
                  <td>
                     <a asp-page="./Edit" asp-route-id="@entity.Id">
                        <strong>@entity.Name</strong>
                     </a>
                     
                  </td>
                  <td>@entity.EntityType</td>
                  <td>@entity.Sport</td>
                  <td>@entity.WatchPriority</td>
                  <td>@entity.Stability</td>
                  <td class="table-actions">
                     <form method="post"
                           asp-page-handler="Delete"
                           asp-route-id="@entity.Id">
                        <button type="submit">Delete</button>
                     </form>
                  </td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}
