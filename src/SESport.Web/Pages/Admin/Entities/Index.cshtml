@page
@model SESport.Web.Pages.Admin.Entities.IndexModel
@{
   ViewData["Title"] = "Entities";
}

<section class="page-heading page-heading-row">
   <div class="page-heading-title-row">
      <h1>Entities</h1>
   </div>
   <div class="button-row">
      <a class="button button-primary" asp-page="./Edit">New entity</a>
   </div>
</section>

<section class="form-section">
   <label>
      <span>Filter</span>
   </label>
   <input type="text"
      class="entity-name-filter"
      placeholder="name"
      autofocus
      aria-label="Filter entities by name"
      data-entity-name-filter
   />
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The entity table is not available right now.
   </div>
}
else if(Model.Entities.Count == 0)
{
   <div class="notice">No entities have been created yet.</div>
}
else
{
   <div data-entity-list-container>
      <div class="notice" data-entity-empty-state hidden>
         No matching entities.
      </div>
      <div class="admin-table-wrap">
         <table class="admin-table">
            <thead>
               <tr>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Name"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Name")'>
                        Name @Model.GetSortIndicator("Name")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Related"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Related")'>
                        RELATED @Model.GetSortIndicator("Related")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Type"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Type")'>
                        Type @Model.GetSortIndicator("Type")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Sport"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Sport")'>
                        Sport @Model.GetSortIndicator("Sport")
                     </a>
                  </th>
                  @* <th>
                     <a asp-page="./Index" asp-route-sortColumn="Watch"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Watch")'>
                        Watch @Model.GetSortIndicator("Watch")
                     </a>
                  </th> *@
                  <th>
                     <a asp-page="./Index" asp-route-sortColumn="Country"
                        asp-route-sortAsc='@Model.GetNextSortAsc("Country")'>
                        Country @Model.GetSortIndicator("Country")
                     </a>
                  </th>
                  <th></th>
               </tr>
            </thead>
            <tbody>
               @foreach(var entity in Model.Entities)
               {
                  <tr data-entity-row-name="@entity.Name"
                      data-entity-row-related=
                         "@entity.RelatedEntityNames">
                     <td>
                        <a asp-page="./Edit" asp-route-id="@entity.Id">
                           <strong>@entity.Name</strong>
                        </a>
                        <a class="ses-entity-search-link"
                           href=
                              "@ViewData["SearchUrl"]@entity.Name @entity.Sport"
                           target="_blank">
                           <span class="ses-icon-search"></span>
                        </a>
                     </td>
                     <td>@entity.RelatedEntityNames</td>
                     <td>@entity.EntityType</td>
                     <td>@entity.Sport</td>
                     @* <td>@entity.WatchPriority</td> *@
                     <td>@entity.Country</td>
                     <td class="table-actions">
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@entity.Id"
                              onsubmit='return confirm("Sure?");'>
                           <button type="submit">Delete</button>
                        </form>
                     </td>
                  </tr>
               }
            </tbody>
         </table>
      </div>
   </div>
}
