@page
@model SESport.Web.Pages.Admin.Config.StatsModel
@{
   ViewData["Title"] = "Web statistics";
}

@if(Model.Reports.Count == 0)
{
   <div class="notice notice-warning">
      No report has been generated yet.
   </div>
}
else
{
   <form method="get" class="filter-form stats-report-picker">
      <label>
         <span>Date</span>
         <input type="date"
                name="@RouteKeys.Date"
                value="@Model.SelectedDateText"
                onchange="this.form.submit();" />
      </label>
   </form>

   @if(Model.SelectedReport is null)
   {
      <div class="notice notice-warning">
         No report is available for the selected date.
      </div>
   }
   else
   {
      <iframe class="stats-report-frame"
              title="@Model.SelectedReport.Title"
              src="@Url.Page(
                 "./Stats",
                 "Report",
                 new { file = Model.SelectedReport.FileName }
              )">
      </iframe>
   }
}
