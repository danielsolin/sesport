@page
@model SESport.Web.Pages.Admin.Config.StatsModel
@{
   ViewData["Title"] = "Web statistics";
}

<div class="page-heading compact-heading">
   <h2>Web statistics</h2>
   <p>
      Anonymized statistics generated from the Caddy access log.
   </p>
</div>

@if(Model.Reports.Count == 0)
{
   <div class="notice notice-warning">
      No report has been generated yet.
   </div>
}
else
{
   <nav class="stats-report-list" aria-label="Available reports">
      @foreach(var report in Model.Reports)
      {
         <a class="button"
            asp-page="./Stats"
            asp-route-report="@report.FileName">
            @report.Title
         </a>
      }
   </nav>

   <iframe class="stats-report-frame"
           title="@Model.SelectedReport!.Title"
           src="@Url.Page(
              "./Stats",
              "Report",
              new { file = Model.SelectedReport.FileName }
           )">
   </iframe>
}
