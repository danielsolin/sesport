@page
@model SESport.Web.Pages.Admin.Config.Ai.Jobs.IndexModel
@{
   ViewData["Title"] = "AI jobs";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Config</p>
      <h1>AI jobs</h1>
   </div>
   <a class="button button-primary" asp-page="./Edit">New job</a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<div class="admin-table-wrap">
   <table class="admin-table">
      <thead>
         <tr>
            <th>ID</th>
            <th>Provider</th>
            <th>QP</th>
            <th>PROMPT</th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach (var job in Model.Jobs)
         {
            <tr>
               <td><code>@job.Id</code></td>
               <td><code>@job.ProviderId</code></td>
               <td>@job.QueuePriority</td>
               <td>
                  @(job.ActivePromptVersion is null
                     ? "-"
                     : $"V{job.ActivePromptVersion}")
               </td>
               <td class="table-actions">
                  <a asp-page="./Edit" asp-route-id="@job.Id">Edit</a>
                  <form method="post"
                        asp-page-handler="Delete"
                        asp-route-id="@job.Id"
                        onsubmit="return confirm('Are you sure?');">
                     <button type="submit">Delete</button>
                  </form>
               </td>
            </tr>
         }
      </tbody>
   </table>
</div>
