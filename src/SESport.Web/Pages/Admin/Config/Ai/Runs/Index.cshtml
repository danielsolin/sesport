@page
@model SESport.Web.Pages.Admin.Config.Ai.Runs.IndexModel
@{
   ViewData["Title"] = "AI runs";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Config</p>
      <h1>AI runs</h1>
   </div>
</section>

<form method="get" class="edit-form">
   <section class="form-section">
      <h2>Filters</h2>
      <div class="form-grid ai-runs-filter-grid">
         <label>
            <span>Date</span>
            <input type="date"
                   name="@RouteKeys.Date"
                   value="@Model.DateText"
                   onchange="this.form.submit();" />
         </label>
         <label>
            <span>Job</span>
            <select asp-for="JobId">
               <option value="">All jobs</option>
               @foreach (var job in Model.Jobs)
               {
                  <option value="@job.Id">@job.Label</option>
               }
            </select>
         </label>
         <label>
            <span>Status</span>
            <select asp-for="StatusId">
               @foreach (var status in Model.StatusOptions)
               {
                  <option value="@status.Value">@status.Text</option>
               }
            </select>
         </label>
      </div>
      <div class="form-actions">
         <button class="button button-primary" type="submit">Apply</button>
         <a class="button" asp-page="./Index">Reset</a>
      </div>
   </section>
</form>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<div class="admin-table-wrap">
   <table class="admin-table admin-table-hover ai-runs-table">
      <colgroup>
         <col class="ai-runs-col-started" />
         <col class="ai-runs-col-job" />
         <col class="ai-runs-col-event" />
         <col class="ai-runs-col-provider" />
         <col class="ai-runs-col-status" />
         <col class="ai-runs-col-rounds" />
         <col class="ai-runs-col-duration" />
         <col class="ai-runs-col-actions" />
      </colgroup>
      <thead>
         <tr>
            <th>Started</th>
            <th>Job</th>
            <th>Event</th>
            <th>Provider</th>
            <th>Status</th>
            <th>Rounds</th>
            <th>Duration</th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach (var run in Model.Runs)
         {
            <tr data-ai-run-status="@run.StatusId">
               <td>
                  <div class="ai-runs-cell-stack">
                     <span>@TimeDisplay.FormatLocalDate(run.StartedAt)</span>
                     <span class="ai-runs-cell-secondary">
                        @TimeDisplay.FormatLocalTime(run.StartedAt)
                     </span>
                  </div>
               </td>
               <td>@run.JobLabel</td>
               <td>@run.EventName</td>
               <td>
                  <div class="ai-runs-cell-stack">
                     <span>@run.ProviderLabel</span>
                     @if(!string.IsNullOrWhiteSpace(run.ProviderModel))
                     {
                        <span class="ai-runs-cell-secondary">
                           @run.ProviderModel
                        </span>
                     }
                  </div>
               </td>
               <td><code>@run.StatusId</code></td>
               <td>
                  @DetailsModel.GetToolRoundCount(
                     run.ToolRoundCount,
                     run.ToolTraceJson
                  )
               </td>
               <td>
                  @DetailsModel.FormatDuration(run)
               </td>
               <td class="table-actions">
                  <a asp-page="./Details"
                     asp-route-id="@run.Id"
                     asp-route-date="@Model.DateText"
                     asp-route-jobId="@Model.JobId"
                     asp-route-statusId="@Model.StatusId">
                     View
                  </a>
                  <form method="post"
                        asp-page-handler="Delete"
                        asp-route-id="@run.Id"
                        asp-route-date="@Model.DateText"
                        asp-route-jobId="@Model.JobId"
                        asp-route-statusId="@Model.StatusId"
                        onsubmit="return confirm('Sure?');">
                     <button type="submit">Delete</button>
                  </form>
               </td>
            </tr>
         }
      </tbody>
   </table>
</div>
