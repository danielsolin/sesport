@page "{id:guid}"
@model SESport.Web.Pages.Admin.Config.Ai.Runs.DetailsModel
@{
   ViewData["Title"] = "AI run";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Config</p>
      <h1>AI run</h1>
   </div>
   <a class="button"
      asp-page="./Index"
      asp-route-jobId="@Model.JobId"
      asp-route-statusId="@Model.StatusId">
      Back
   </a>
</section>

@if (Model.Run is not null)
{
   <section class="form-section">
      <h2>Summary</h2>
      <dl class="detail-grid">
         <div>
            <dt>Run ID</dt>
            <dd><code>@Model.Run.Id</code></dd>
         </div>
         <div>
            <dt>Status</dt>
            <dd><code>@Model.Run.StatusId</code></dd>
         </div>
         <div>
            <dt>Job</dt>
            <dd>@Model.Run.JobLabel</dd>
         </div>
         <div>
            <dt>Provider</dt>
            <dd>@Model.Run.ProviderLabel</dd>
         </div>
         <div>
            <dt>Model</dt>
            <dd>@Model.Run.ProviderModel</dd>
         </div>
         <div>
            <dt>Started</dt>
            <dd>@TimeDisplay.FormatLocalTimestamp(Model.Run.StartedAt)</dd>
         </div>
         <div>
            <dt>Completed</dt>
            <dd>
               @(
                  Model.Run.CompletedAt is null
                     ? ""
                     : TimeDisplay.FormatLocalTimestamp(
                        Model.Run.CompletedAt.Value
                     )
               )
            </dd>
         </div>
         <div>
            <dt>Duration</dt>
            <dd>
               @(Model.Run.DurationSeconds?.ToString("0.000") ?? "")
            </dd>
         </div>
         <div>
            <dt>Tool rounds</dt>
            <dd>@Model.Run.ToolRoundCount</dd>
         </div>
         <div>
            <dt>Conversation chars</dt>
            <dd>@Model.Run.ConversationCharacterCount</dd>
         </div>
         <div>
            <dt>Correlation</dt>
            <dd>@Model.Run.CorrelationId</dd>
         </div>
         @if (Model.Run.InputTokens is not null)
         {
            <div>
               <dt>Input tokens</dt>
               <dd>@Model.Run.InputTokens</dd>
            </div>
         }
         @if (Model.Run.OutputTokens is not null)
         {
            <div>
               <dt>Output tokens</dt>
               <dd>@Model.Run.OutputTokens</dd>
            </div>
         }
         @if (Model.Run.ReasoningTokens is not null)
         {
            <div>
               <dt>Reasoning tokens</dt>
               <dd>@Model.Run.ReasoningTokens</dd>
            </div>
         }
      </dl>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Raw request</summary>
         <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.RawRequestJson)
         </pre>
      </details>
   </section>

   <section class="form-section">
      <h2>Input payload</h2>
      <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.InputPayloadJson)
      </pre>
   </section>

   <section class="form-section">
      <h2>Rendered prompt</h2>
      <pre class="prompt-details-pre">@Model.Run.RenderedPrompt</pre>
   </section>

   <section class="form-section">
      <h2>Output</h2>
      <pre class="prompt-details-pre">
@((Model.Run.OutputText ?? string.Empty).Trim())
      </pre>
   </section>

   @if (!string.IsNullOrWhiteSpace(Model.Run.RawResponseJson))
   {
      <section class="form-section">
         <details class="run-data-details">
            <summary>Raw response</summary>
            <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.RawResponseJson)
            </pre>
         </details>
      </section>
   }

   <section class="form-section">
      <details class="run-data-details">
         <summary>Tool trace</summary>
         @if (string.Equals(Model.Run.StatusId, "running",
               StringComparison.Ordinal))
         {
            <div class="notice">
               This run is still in progress. Tool trace updates as rounds
               complete.
            </div>
         }

         @if (Model.ToolTraceTurns.Count == 0)
         {
            <div class="notice">No tool trace recorded yet.</div>
         }
         else
         {
            <div class="tool-trace-list">
               @foreach (var turn in Model.ToolTraceTurns)
               {
                  <article class="tool-trace-turn">
                     <header class="tool-trace-turn-header">
                        <div>
                           <span class="tool-trace-turn-label">
                              Round @turn.Turn
                           </span>
                           @if (!string.IsNullOrWhiteSpace(
                              turn.FinishReason))
                           {
                              <span class="tool-trace-turn-meta">
                                 Finish: @turn.FinishReason
                              </span>
                           }
                        </div>
                     </header>

                     @if (!string.IsNullOrWhiteSpace(
                        turn.AssistantContent))
                     {
                        <div class="tool-trace-block">
                           <div class="tool-trace-block-label">
                              Assistant
                           </div>
                           <pre class="prompt-details-pre">
@turn.AssistantContent
                           </pre>
                        </div>
                     }

                     @if (turn.ToolCalls.Count > 0)
                     {
                        <div class="tool-trace-block">
                           <div class="tool-trace-block-label">
                              Tool calls
                           </div>
                           <div class="tool-trace-items">
                              @foreach (var toolCall in turn.ToolCalls)
                              {
                                 <div class="tool-trace-item">
                                    <div class="tool-trace-item-title">
                                       <code>@toolCall.Name</code>
                                       <span>@toolCall.Id</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(
                                       toolCall.Arguments))
                                    {
                                       <pre class="prompt-details-pre">
@toolCall.Arguments
                                       </pre>
                                    }
                                 </div>
                              }
                           </div>
                        </div>
                     }

                     @if (turn.ToolResults.Count > 0)
                     {
                        <div class="tool-trace-block">
                           <div class="tool-trace-block-label">
                              Tool results
                           </div>
                           <div class="tool-trace-items">
                              @foreach (var toolResult in turn.ToolResults)
                              {
                                 <div class="tool-trace-item">
                                    <div class="tool-trace-item-title">
                                       <code>@toolResult.Name</code>
                                       <span>@toolResult.ToolCallId</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(
                                       toolResult.Query))
                                    {
                                       <div>Query: @toolResult.Query</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(
                                       toolResult.Id))
                                    {
                                       <div>Id: @toolResult.Id</div>
                                    }
                                    <pre class="prompt-details-pre">
@toolResult.Result
                                    </pre>
                                 </div>
                              }
                           </div>
                        </div>
                     }
                  </article>
               }
            </div>
         }
      </details>
   </section>

   @if (!string.IsNullOrWhiteSpace(Model.Run.ToolTraceJson))
   {
      <section class="form-section">
         <details class="run-data-details">
            <summary>Raw tool trace JSON</summary>
            <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.ToolTraceJson)
            </pre>
         </details>
      </section>
   }

   @if (!string.IsNullOrWhiteSpace(Model.Run.ErrorMessage))
   {
      <section class="form-section">
         <h2>Error</h2>
         <pre class="prompt-details-pre">@Model.Run.ErrorMessage</pre>
      </section>
   }
}
