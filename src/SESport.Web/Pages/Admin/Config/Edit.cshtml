@page "{table}/{id?}"
@model SESport.Web.Pages.Admin.Config.EditModel
@{
   ViewData["Title"] = Model.CurrentTable?.Title ?? "Config";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>@ViewData["Title"]</h1>
   </div>
   <a class="button" asp-page="./Index" asp-route-table="@Model.CurrentTable?.Id">
      Back
   </a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<form method="post" class="edit-form">
   @if (Model.CurrentTable?.Kind == ReferenceTableKind.Countries)
   {
      <section class="form-section">
         <h2>Country</h2>
         <div class="form-grid">
            <label>
               <span>ID</span>
               <input asp-for="Country.Id" />
               <span asp-validation-for="Country.Id"></span>
            </label>
            <label>
               <span>Code</span>
               <input asp-for="Country.Code" />
               <span asp-validation-for="Country.Code"></span>
            </label>
            <label>
               <span>Name</span>
               <input asp-for="Country.Name" />
               <span asp-validation-for="Country.Name"></span>
            </label>
         </div>
      </section>
   }
   else if (Model.CurrentTable?.Kind == ReferenceTableKind.Sports)
   {
      <section class="form-section">
         <h2>Sport</h2>
         <div class="form-grid">
            <label>
               <span>ID</span>
               <input asp-for="Sport.Id" />
               <span asp-validation-for="Sport.Id"></span>
            </label>
            <label>
               <span>Name</span>
               <input asp-for="Sport.Name" />
               <span asp-validation-for="Sport.Name"></span>
            </label>
            <label>
               <span>Icon ID</span>
               <input asp-for="Sport.IconId" />
            </label>
         </div>
      </section>
   }
   else
   {
      <section class="form-section">
         <h2>Row</h2>
         <div class="form-grid">
            <label>
               <span>ID</span>
               <input asp-for="Row.Id" />
               <span asp-validation-for="Row.Id"></span>
            </label>
            <label>
               <span>Label</span>
               <input asp-for="Row.Label" />
               <span asp-validation-for="Row.Label"></span>
            </label>
            <label>
               <span>Sort order</span>
               <input asp-for="Row.SortOrder" type="number" />
            </label>
            <label class="check-row">
               <input asp-for="Row.IsActive" type="checkbox" />
               <span>Active</span>
            </label>
         </div>
      </section>
   }

   <section class="form-actions">
      <button class="button button-primary" type="submit">Save</button>
   </section>
</form>
