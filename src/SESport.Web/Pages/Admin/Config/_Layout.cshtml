@using SESport.Data.Admin
@inject AdminRepository AdminRepository
@{
   Layout = "/Pages/Shared/_Layout.cshtml";
   var requestPath = ViewContext.HttpContext.Request.Path.Value ?? "";
   var groups = AdminNavigationBuilder.BuildConfigNavigationGroups(
      AdminRepository.GetReferenceTables()
   );
   var adminMenuLink = "admin-sidebar-link";
   string GetLinkClass(string href)
   {
      var isActive = string.Equals(
         href,
         requestPath,
         StringComparison.OrdinalIgnoreCase
      );

      return isActive
         ? $"{adminMenuLink} is-active"
         : adminMenuLink;
   }
}

<div class="admin-layout">
   <aside class="admin-sidebar">
      @foreach (var group in groups)
      {
         <div class="admin-sidebar-group">
            <h2>@group.Title</h2>
            @foreach (var item in group.Items)
            {
               <a class="@GetLinkClass(item.Href)"
                  href="@item.Href">
                  @item.Title
               </a>
            }
         </div>
      }
   </aside>

   <section>
      @RenderBody()
   </section>
</div>

@await RenderSectionAsync("Scripts", required: false)
