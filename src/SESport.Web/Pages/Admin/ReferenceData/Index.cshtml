@page "{table?}"
@model SESport.Web.Pages.Admin.ReferenceData.IndexModel
@{
   ViewData["Title"] = "Reference Data";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Reference data</h1>
   </div>
   <a class="button" asp-page="/Admin/Index">Back</a>
</section>

<div class="admin-layout">
   <aside class="admin-sidebar">
      @foreach (var item in Model.NavigationItems)
      {
         <a href="@item.Href">@item.Title</a>
      }
   </aside>

   <section>
      @if (Model.CurrentTable is null)
      {
         <div class="notice">Select a reference table to edit.</div>
      }
      else if (Model.LoadError is not null)
      {
         <div class="notice notice-warning">
            The reference data table is not available right now.
         </div>
      }
      else
      {
         <div class="page-heading page-heading-row compact-heading">
            <div>
               <h2>@Model.CurrentTable.Title</h2>
               <p>@Model.CurrentTable.Description</p>
            </div>
            @if (Model.CurrentSpecialView is null)
            {
               <a class="button button-primary"
                  asp-page="./Edit"
                  asp-route-table="@Model.CurrentTable.Id">
                  New row
               </a>
            }
         </div>

         @if (Model.CurrentSpecialView == "activity-audit")
         {
            <section class="form-section">
               <h2>Activity entity links</h2>
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>Activity</th>
                        <th>Entity</th>
                        <th>Entity type</th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var link in Model.ActivityLinks)
                     {
                        <tr>
                           <td>
                              <strong>@link.ActivityTitle</strong>
                              <span>@link.TimeText</span>
                              <span class="audit-id">@link.ActivityId</span>
                           </td>
                           <td>@link.EntityName</td>
                           <td>@link.EntityType</td>
                        </tr>
                     }
                  </tbody>
               </table>
            </section>

            <section class="form-section">
               <h2>Activity evidence</h2>
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>Activity</th>
                        <th>Source</th>
                        <th>Title</th>
                        <th>URI</th>
                        <th>Comment</th>
                        <th>Proposal</th>
                        <th>Observed</th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var evidence in Model.ActivityEvidence)
                     {
                        <tr>
                           <td>
                              <strong>@evidence.ActivityTitle</strong>
                              <span>@evidence.TimeText</span>
                              <span class="audit-id">@evidence.ActivityId</span>
                           </td>
                           <td>@evidence.Source</td>
                           <td>@evidence.Title</td>
                           <td>
                              @if (!string.IsNullOrWhiteSpace(evidence.Uri))
                              {
                                 <a href="@evidence.Uri">@evidence.Uri</a>
                              }
                           </td>
                           <td>@evidence.Comment</td>
                           <td>@evidence.ProposalId</td>
                           <td>@evidence.ObservedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                     }
                  </tbody>
               </table>
            </section>
         }
         else if (Model.CurrentSpecialView == "proposal-groups")
         {
            <div class="admin-table-wrap">
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>Group</th>
                        <th>Fingerprint</th>
                        <th>Activity</th>
                        <th>Proposals</th>
                        <th>Updated</th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var group in Model.ProposalGroups)
                     {
                        <tr>
                           <td>@group.Id</td>
                           <td>@group.Fingerprint</td>
                           <td>@group.ActivityId</td>
                           <td>@group.ProposalCount</td>
                           <td>@group.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
         else
         {
            <div class="admin-table-wrap">
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>ID</th>
                        <th>Label</th>
                        <th>Sort</th>
                        <th>Active</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var row in Model.Rows)
                     {
                        <tr>
                           <td><code>@row.Id</code></td>
                           <td>@row.Label</td>
                           <td>@row.SortOrder</td>
                           <td>@(row.IsActive?.ToString() ?? "")</td>
                           <td class="table-actions">
                              <a asp-page="./Edit"
                                 asp-route-table="@Model.CurrentTable.Id"
                                 asp-route-id="@row.Id">
                                 Edit
                              </a>
                              <form method="post"
                                    asp-page-handler="Delete"
                                    asp-route-table="@Model.CurrentTable.Id"
                                    asp-route-id="@row.Id"
                                    onsubmit="return confirm('Are you sure?');">
                                 <button type="submit">Delete</button>
                              </form>
                           </td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
      }
   </section>
</div>
