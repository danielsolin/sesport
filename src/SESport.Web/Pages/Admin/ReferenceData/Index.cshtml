@page "{table?}"
@using SESport.Data.Models
@model SESport.Web.Pages.Admin.ReferenceData.IndexModel
@{
   ViewData["Title"] = "Reference Data";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Reference data</h1>
   </div>
   <a class="button" asp-page="/Admin/Broadcasts/Index">Back</a>
</section>

<div class="admin-layout">
   <aside class="admin-sidebar">
      @foreach (var item in Model.NavigationItems)
      {
         <a href="@item.Href">@item.Title</a>
      }
   </aside>

   <section>
      @if (Model.CurrentTable is null)
      {
         <div class="notice">Select a reference table to edit.</div>
      }
      else if (Model.LoadError is not null)
      {
         <div class="notice notice-warning">
            @Model.LoadError
         </div>
      }
      else
      {
      <div class="page-heading page-heading-row compact-heading">
         <div>
            <h2>@Model.CurrentTable.Title</h2>
            <p>@Model.CurrentTable.Description</p>
         </div>
         <a class="button button-primary"
            asp-page="./Edit"
            asp-route-table="@Model.CurrentTable.Id">
            New row
         </a>
      </div>
         if(Model.CurrentTable.Kind == ReferenceTableKind.Countries)
         {
            <div class="admin-table-wrap">
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Name</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach(var row in Model.CountryRows)
                     {
                        <tr>
                           <td><code>@row.Id</code></td>
                           <td><code>@row.Code</code></td>
                           <td>@row.Name</td>
                           <td class="table-actions">
                              <a asp-page="./Edit"
                                 asp-route-table="@Model.CurrentTable.Id"
                                 asp-route-id="@row.Id">
                                 Edit
                              </a>
                              <form method="post"
                                    asp-page-handler="Delete"
                                    asp-route-table="@Model.CurrentTable.Id"
                                    asp-route-id="@row.Id"
                                    onsubmit="return confirm('Sure?');">
                                 <button type="submit">Delete</button>
                              </form>
                           </td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
         else if (Model.CurrentTable.Kind == ReferenceTableKind.Sports)
         {
            <div class="admin-table-wrap">
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Icon</th>
                        <th>Requires Start Time</th>
                        <th>Is Team Sport</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var row in Model.SportRows)
                     {
                        <tr>
                           <td><code>@row.Id</code></td>
                           <td>@row.Name</td>
                           <td><code>@row.IconId</code></td>
                           <td>@(row.RequiresStartTime ? "Yes" : "No")</td>
                           <td>@(row.IsTeamSport ? "Yes" : "No")</td>
                           <td class="table-actions">
                              <a asp-page="./Edit"
                                 asp-route-table="@Model.CurrentTable.Id"
                                 asp-route-id="@row.Id">
                                 Edit
                              </a>
                              <form method="post"
                                    asp-page-handler="Delete"
                                    asp-route-table="@Model.CurrentTable.Id"
                                    asp-route-id="@row.Id"
                                    onsubmit="return confirm('Sure?');">
                                 <button type="submit">Delete</button>
                              </form>
                           </td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
         else
         {
            <div class="admin-table-wrap">
               <table class="admin-table">
                  <thead>
                     <tr>
                        <th>ID</th>
                        <th>Label</th>
                        <th>Sort</th>
                        <th>Active</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach (var row in Model.Rows)
                     {
                        <tr>
                           <td><code>@row.Id</code></td>
                           <td>@row.Label</td>
                           <td>@row.SortOrder</td>
                           <td>@(row.IsActive?.ToString() ?? "")</td>
                           <td class="table-actions">
                              <a asp-page="./Edit"
                                 asp-route-table="@Model.CurrentTable.Id"
                                 asp-route-id="@row.Id">
                                 Edit
                              </a>
                              <form method="post"
                                    asp-page-handler="Delete"
                                    asp-route-table="@Model.CurrentTable.Id"
                                    asp-route-id="@row.Id"
                                    onsubmit="return confirm('Sure?');">
                                 <button type="submit">Delete</button>
                              </form>
                           </td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
      }
   </section>
</div>
