@page "{table?}"
@model SESport.Web.Pages.Admin.ReferenceData.IndexModel
@{
   ViewData["Title"] = "Reference Data";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Reference data</h1>
   </div>
   <a class="button" asp-page="/Admin/Index">Back</a>
</section>

<div class="admin-layout">
   <aside class="admin-sidebar">
      @foreach (var table in Model.Tables)
      {
         <a asp-page="./Index" asp-route-table="@table.Id">
            @table.Title
         </a>
      }
   </aside>

   <section>
      @if (Model.CurrentTable is null)
      {
         <div class="notice">Select a reference table to edit.</div>
      }
      else if (Model.LoadError is not null)
      {
         <div class="notice notice-warning">
            The reference data table is not available right now.
         </div>
      }
      else
      {
         <div class="page-heading page-heading-row compact-heading">
            <div>
               <h2>@Model.CurrentTable.Title</h2>
               <p>@Model.CurrentTable.Description</p>
            </div>
            <a class="button button-primary"
               asp-page="./Edit"
               asp-route-table="@Model.CurrentTable.Id">
               New row
            </a>
         </div>

         <div class="admin-table-wrap">
            <table class="admin-table">
               <thead>
                  <tr>
                     <th>ID</th>
                     <th>Label</th>
                     <th>Sort</th>
                     <th>Active</th>
                     <th></th>
                  </tr>
               </thead>
               <tbody>
                  @foreach (var row in Model.Rows)
                  {
                     <tr>
                        <td><code>@row.Id</code></td>
                        <td>@row.Label</td>
                        <td>@row.SortOrder</td>
                        <td>@(row.IsActive?.ToString() ?? "")</td>
                        <td class="table-actions">
                           <a asp-page="./Edit"
                              asp-route-table="@Model.CurrentTable.Id"
                              asp-route-id="@row.Id">
                              Edit
                           </a>
                           <form method="post"
                                 asp-page-handler="Delete"
                                 asp-route-table="@Model.CurrentTable.Id"
                                 asp-route-id="@row.Id"
                                 onsubmit="return confirm('Are you sure?');">
                              <button type="submit">Delete</button>
                           </form>
                        </td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      }
   </section>
</div>
