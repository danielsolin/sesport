@page
@model SESport.Web.Pages.Admin.Audit.GroupsModel
@{
   ViewData["Title"] = "Proposal Group Audit";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Reference data</p>
      <h1>Proposal groups</h1>
   </div>
   <a class="button" asp-page="/Admin/ReferenceData/Index">Back</a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}

<section class="form-section">
   <h2>Groups</h2>
   <table class="admin-table">
      <thead>
         <tr>
            <th>Group</th>
            <th>Fingerprint</th>
            <th>Activity</th>
            <th>Proposals</th>
            <th>Updated</th>
         </tr>
      </thead>
      <tbody>
         @foreach (var group in Model.Groups)
         {
            <tr>
               <td>@group.Id</td>
               <td>@group.Fingerprint</td>
               <td>@group.ActivityId</td>
               <td>@group.ProposalCount</td>
               <td>@group.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
         }
      </tbody>
   </table>
</section>
