@page
@model SESport.Web.Pages.Admin.Audit.ProposalsModel
@{
   ViewData["Title"] = "Activity Proposal Audit";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Audit</p>
      <h1>Activity proposals</h1>
   </div>
   <a class="button" asp-page="./Index">Back</a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<section class="form-section">
   <h2>Proposals</h2>
   <table class="admin-table">
      <thead>
         <tr>
            <th>Activity</th>
            <th>Producer</th>
            <th>Source</th>
            <th>Status</th>
            <th>Reject reason</th>
            <th>Reject comment</th>
            <th>Type</th>
            <th>Sport</th>
            <th>Links</th>
            <th>Evidence</th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach (var proposal in Model.Proposals)
         {
            <tr>
               <td>
                  <strong>@proposal.Title</strong>
                  <span>@proposal.TimeText</span>
                  <span class="audit-id">@proposal.Id</span>
               </td>
               <td>@proposal.Producer</td>
               <td>@proposal.Source</td>
               <td>@proposal.Status</td>
               <td>@proposal.RejectReason</td>
               <td>@proposal.RejectComment</td>
               <td>@proposal.ActivityType</td>
               <td>@proposal.Sport</td>
               <td>@proposal.EntityLinkCount</td>
               <td>@proposal.EvidenceCount</td>
               <td class="table-actions">
                  <a asp-page="./Proposal" asp-route-id="@proposal.Id">
                     Review
                  </a>
               </td>
            </tr>
         }
      </tbody>
   </table>
</section>
