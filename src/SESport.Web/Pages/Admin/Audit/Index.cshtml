@page
@model SESport.Web.Pages.Admin.Audit.IndexModel
@{
   ViewData["Title"] = "Audit";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Audit</h1>
   </div>
   <a class="button" asp-page="/Admin/Index">Back</a>
</section>

<div class="admin-card-grid">
   @foreach (var area in Model.Areas)
   {
      <a class="admin-card" href="@area.Href">
         <strong>@area.Title</strong>
         <span>@area.Description</span>
      </a>
   }
</div>
