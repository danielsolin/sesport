@page
@model SESport.Web.Pages.Admin.Audit.ActivitiesModel
@{
   ViewData["Title"] = "Activity Audit";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Audit</p>
      <h1>Activity audit</h1>
   </div>
   <a class="button" asp-page="./Index">Back</a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}

<section class="form-section">
   <h2>Activity entity links</h2>
   <table class="admin-table">
      <thead>
         <tr>
            <th>Activity</th>
            <th>Entity</th>
            <th>Entity type</th>
         </tr>
      </thead>
      <tbody>
         @foreach (var link in Model.Links)
         {
            <tr>
               <td>
                  <strong>@link.ActivityTitle</strong>
                  <span>@link.TimeText</span>
                  <span class="audit-id">@link.ActivityId</span>
               </td>
               <td>@link.EntityName</td>
               <td>@link.EntityType</td>
            </tr>
         }
      </tbody>
   </table>
</section>

<section class="form-section">
   <h2>Activity evidence</h2>
   <table class="admin-table">
      <thead>
         <tr>
            <th>Activity</th>
            <th>Source</th>
            <th>Title</th>
            <th>URI</th>
            <th>Comment</th>
            <th>Proposal</th>
            <th>Observed</th>
         </tr>
      </thead>
      <tbody>
         @foreach (var evidence in Model.Evidence)
         {
            <tr>
               <td>
                  <strong>@evidence.ActivityTitle</strong>
                  <span>@evidence.TimeText</span>
                  <span class="audit-id">@evidence.ActivityId</span>
               </td>
               <td>@evidence.Source</td>
               <td>@evidence.Title</td>
               <td>
                  @if (!string.IsNullOrWhiteSpace(evidence.Uri))
                  {
                     <a href="@evidence.Uri">@evidence.Uri</a>
                  }
               </td>
               <td>@evidence.Comment</td>
               <td>@evidence.ProposalId</td>
               <td>@evidence.ObservedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
         }
      </tbody>
   </table>
</section>
