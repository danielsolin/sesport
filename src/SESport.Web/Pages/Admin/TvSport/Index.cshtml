@page
@model SESport.Web.Pages.Admin.TvSport.IndexModel
@{
   ViewData["Title"] = "TV Sport Broadcasts";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>TV sport broadcasts</h1>
   </div>
   <a class="button" asp-page="/Admin/Index">Back</a>
</section>

<section class="form-section">
   <form method="get"
         class="filter-form"
         data-ajax-replace-target="[data-tv-sport-results]">
      <label>
         <span>Date</span>
         <input type="date"
                name="date"
                value="@Model.DateText"
                onchange="this.form.submit();" />
      </label>
      <div class="filter-sports">
         <label asp-for="SelectedSports">
            <span>Sporter</span>
            <select asp-for="SelectedSports"
                    asp-items="Model.SportOptions"
                    multiple="multiple"
                    size="1"
                    data-empty-option="exclusive"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
      </div>
      <label class="check-row filter-checkbox">
         <input type="checkbox"
                name="hideReplays"
                value="true"
                checked="@Model.HideReplays"
                onchange="this.form.submit();" />
         @* <span>Hide reruns (broken)</span> *@
      </label>
   </form>
</section>

<div data-tv-sport-results>
   @if(Model.LoadError is not null)
   {
      <div class="notice notice-warning">
         The TV sport broadcast database is not available right now.
      </div>
   }
   else if(Model.Broadcasts.Count == 0)
   {
      <div class="notice">
         No TV sport broadcasts for @Model.DateText.
      </div>
   }
   else
   {
      <section class="form-section">
         <div class="ses-table-header">
            <div>
               <span data-tv-sport-broadcast-count>
                  @Model.Broadcasts.Count
               </span>
               broadcasts
            </div>
         </div>
         <div class="admin-table-wrap">
            <table class="admin-table">
               <thead>
                  <tr>
                     <th>
                        <button type="button"
                                class="button button-primary ses-button-small"
                                data-checkbox-toggle="tv-sport-broadcasts"
                                data-select-label="Select all"
                                data-unselect-label="Unselect all">
                           Select all
                        </button>
                     </th>
                     <th>Channel</th>
                     <th>Time</th>
                     <th>Broadcast</th>
                     <th>Categories</th>
                     <th>Actions</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach(var broadcast in Model.Broadcasts)
                  {
                     DateOnly? airDate = null;
                     if(broadcast.IsReplay
                        && broadcast.OriginalAirDate != null)
                     {
                        airDate = broadcast.OriginalAirDate.Value;
                     }
                     <tr>
                        <td class="ses-center">
                           <input
                              type="checkbox"
                              value="@broadcast.Id"
                              class="ses-checkbox"
                              data-checkbox-group="tv-sport-broadcasts"
                           />
                        </td>
                        <td>
                           <div class="ses-nowrap">
                              <small>@broadcast.ChannelName</small>
                           </div>
                        </td>
                        <td>
                           <div class="ses-timetext ses-nowrap">
                              @broadcast.TimeOnlyText
                           </div>
                        </td>
                        <td>
                           <strong>@broadcast.Title</strong>
                           @if(!string.IsNullOrWhiteSpace(
                              broadcast.Description))
                           {
                              <span>@broadcast.Description</span>
                           }
                           @if(airDate != null)
                           {
                              <span>
                                 Repris från @airDate
                              </span>
                           }
                        </td>
                        <td>
                           <small>@broadcast.Categories</small>
                        </td>
                        <td class="table-actions">
                           <form method="post"
                                 asp-page-handler="Hide"
                                 asp-route-id="@broadcast.Id"
                                 data-ajax-success="remove"
                                 data-ajax-remove-target="tr"
                                 data-ajax-decrement-target=
                                    "[data-tv-sport-broadcast-count]">
                              <input type="hidden"
                                     name="date"
                                     value="@Model.DateText" />
                              @if(Model.HideReplays)
                              {
                                 <input type="hidden"
                                        name="hideReplays"
                                        value="true" />
                              }
                              @foreach(var sport in Model.SelectedSports
                                 .Where(value =>
                                    !string.IsNullOrWhiteSpace(value)))
                              {
                                 <input type="hidden"
                                        name="SelectedSports"
                                        value="@sport" />
                              }
                              <button type="submit" class="ses-button-small">
                                 Hide
                              </button>
                           </form>
                        </td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      </section>
   }
</div>
