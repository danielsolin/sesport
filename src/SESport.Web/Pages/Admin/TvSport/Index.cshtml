@page
@model SESport.Web.Pages.Admin.TvSport.IndexModel
@{
   ViewData["Title"] = "TV Sport Broadcasts";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Broadcasts</h1>
   </div>
   <a class="button" asp-page="/Admin/Index">Back</a>
</section>

<section class="form-section">
   <form method="get"
         class="filter-form"
         data-ajax-replace-target="[data-tv-sport-results]">
      <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
      <input type="hidden"
             name="sortAsc"
             value="@Model.SortAsc.ToString()" />
      <label>
         <span>Date</span>
         <input type="date"
                name="date"
                value="@Model.DateText"
                onchange="this.form.submit();" />
      </label>
      <div class="filter-sports">
         <label asp-for="SelectedSports">
            <span>Sporter</span>
            <select asp-for="SelectedSports"
                    asp-items="Model.SportOptions"
                    multiple="multiple"
                    size="1"
                    data-empty-option="exclusive"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
      </div>
      @* <label class="check-row filter-checkbox">
         <input type="checkbox"
                name="hideReplays"
                value="true"
                checked="@Model.HideReplays"
                onchange="this.form.submit();" />
         <span>Hide reruns (broken)</span>
      </label> *@
      <label class="check-row filter-checkbox">
         <input type="checkbox"
                name="showHidden"
                value="true"
                checked="@Model.ShowHidden"
                onchange="this.form.submit();" />
         <span>Show hidden</span>
      </label>
   </form>
</section>

<div data-tv-sport-results>
   @if(Model.LoadError is not null)
   {
      <div class="notice notice-warning">
         The TV sport broadcast database is not available right now.
      </div>
   }
   else if(Model.Broadcasts.Count == 0)
   {
      <div class="notice">
         No TV sport broadcasts for @Model.DateText.
      </div>
   }
   else
   {
      <section class="form-section">
         <form id="generate-activity-form"
               method="post"
               asp-page-handler="GenerateActivity">
            <input type="hidden" name="date" value="@Model.DateText" />
            <input type="hidden"
                   name="sortColumn"
                   value="@Model.SortColumn" />
            <input type="hidden"
                   name="sortAsc"
                   value="@Model.SortAsc.ToString()" />
            <input type="hidden"
                   name="returnUrl"
                   value="@(Request.Path + Request.QueryString)" />
            @if(Model.HideReplays)
            {
               <input type="hidden" name="hideReplays" value="true" />
            }
            @foreach(var sport in Model.SelectedSports
               .Where(value => !string.IsNullOrWhiteSpace(value)))
            {
               <input type="hidden"
                      name="SelectedSports"
                      value="@sport" />
            }
         </form>
         <div class="ses-table-header">
            <div>
               <span data-tv-sport-broadcast-count>
                  @Model.Broadcasts.Count
               </span>
               broadcasts
            </div>
         </div>
         <div class="admin-table-wrap">
            <table class="admin-table">
               <thead>
                  <tr>
                     <th>
                        <button type="button"
                                class="button button-primary"
                                data-checkbox-toggle="tv-sport-broadcasts"
                                data-select-label="Select all"
                                data-unselect-label="Unselect all">
                           Select all
                        </button>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Channel")'>
                           Channel @Model.GetSortIndicator("Channel")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Time")'>
                           Time @Model.GetSortIndicator("Time")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Broadcast")'>
                           Broadcast @Model.GetSortIndicator("Broadcast")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Categories")'>
                           Categories @Model.GetSortIndicator("Categories")
                        </a>
                     </th>
                     <th>Actions</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach(var broadcast in Model.Broadcasts)
                  {
                     DateOnly? airDate = null;
                     if(broadcast.IsReplay
                        && broadcast.OriginalAirDate != null)
                     {
                        airDate = broadcast.OriginalAirDate.Value;
                     }
                     <tr>
                        <td class="table-select">
                           <input
                              type="checkbox"
                              name="tvSportBroadcastIds"
                              value="@broadcast.Id"
                              form="generate-activity-form"
                              data-checkbox-group="tv-sport-broadcasts"
                           />
                        </td>
                        <td>
                           <div class="ses-nowrap">
                              @broadcast.ChannelName
                           </div>
                        </td>
                        <td>
                           <strong class="ses-nowrap">
                              @broadcast.TimeOnlyText
                           </strong>
                        </td>
                        <td>
                           <strong>@broadcast.Title</strong>
                           @if(!string.IsNullOrWhiteSpace(
                              broadcast.Description))
                           {
                              <span>@broadcast.Description</span>
                           }
                           @if(airDate != null)
                           {
                              <span>
                                 Repris från @airDate
                              </span>
                           }
                        </td>
                        <td>
                           @broadcast.Categories
                        </td>
                        <td class="table-actions">
                           <form method="post"
                                 asp-page-handler="Hide"
                                 asp-route-id="@broadcast.Id"
                                 data-ajax-success=
                                    "@(broadcast.isHidden ? null : "remove")"
                                 data-ajax-remove-target=
                                    "@(broadcast.isHidden ? null : "tr")"
                                 data-ajax-decrement-target=
                                    "@(
                                       broadcast.isHidden
                                          ? null
                                          : "[data-tv-sport-broadcast-count]"
                                    )">
                              <input type="hidden"
                                     name="date"
                                     value="@Model.DateText" />
                              <input type="hidden"
                                     name="isHidden"
                                     value="@broadcast.isHidden.ToString()" />
                              <input type="hidden"
                                     name="sortColumn"
                                     value="@Model.SortColumn" />
                              <input type="hidden"
                                     name="sortAsc"
                                     value="@Model.SortAsc.ToString()" />
                              @if(Model.HideReplays)
                              {
                                 <input type="hidden"
                                        name="hideReplays"
                                        value="true" />
                              }
                              @foreach(var sport in Model.SelectedSports
                                 .Where(value =>
                                    !string.IsNullOrWhiteSpace(value)))
                              {
                                 <input type="hidden"
                                        name="SelectedSports"
                                        value="@sport" />
                              }
                              <button type="submit">
                                 @(broadcast.isHidden ? "Show" : "Hide")
                              </button>
                           </form>
                        </td>
                     </tr>
                  }
               </tbody>
               <tfoot hidden
                      data-visible-when-checkbox-group="tv-sport-broadcasts">
                  <tr>
                     <td colspan="6">
                        <button type="submit"
                                class="button button-primary"
                                form="generate-activity-form"
                                id="generate-activity-button">
                           Generate Activity
                        </button>
                     </td>
                  </tr>
               </tfoot>
            </table>
         </div>
      </section>
   }
</div>
