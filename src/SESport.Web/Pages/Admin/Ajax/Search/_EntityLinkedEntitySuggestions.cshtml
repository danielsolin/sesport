@using SESport.Data.Models
@model IReadOnlyList<EntityListItem>

<div data-partial-content>
   @if(Model.Count == 0)
   {
      <div class="broadcast-org-entity-empty">No matches</div>
   }
   else
   {
      @foreach(var entity in Model)
      {
         <button type="button"
                 class="broadcast-org-entity-option"
                 data-entity-id="@entity.Id"
                 data-entity-text="@entity.Name"
                 data-entity-type="@entity.EntityType"
                 data-entity-sport="@entity.Sport">
            <span>
               @entity.Name (@entity.EntityType, @entity.Sport)
            </span>
            @if(!string.IsNullOrWhiteSpace(entity.RelatedEntityNames))
            {
               <span class="broadcast-org-entity-related">
                  Related: @entity.RelatedEntityNames
               </span>
            }
         </button>
      }
   }
</div>
