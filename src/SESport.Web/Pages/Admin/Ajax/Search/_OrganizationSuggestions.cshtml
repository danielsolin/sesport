@using SESport.Data.Models
@model IReadOnlyList<EntityListItem>

<div data-partial-content>
   @if(Model.Count == 0)
   {
      <div class="broadcast-org-entity-empty">No matches</div>
   }
   else
   {
      @foreach(var entity in Model)
      {
         var label = string.IsNullOrWhiteSpace(entity.Sport)
            ? entity.Name
            : $"{entity.Name} ({entity.Sport})";
         <button type="button"
                 class="broadcast-org-entity-option"
                 data-entity-id="@entity.Id"
                 data-entity-text="@entity.Name"
                 data-entity-label="@label">
            @label
         </button>
      }
   }
</div>
