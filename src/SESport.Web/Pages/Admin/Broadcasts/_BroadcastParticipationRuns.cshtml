@model SESport.Web.Pages.Admin.Broadcasts.BroadcastParticipationRunsViewModel
@{
   var broadcast = Model.Broadcast;
   var baseActivityUrl = Url.Page(
      "/Admin/Activities/Edit",
      Model.PageModel.GetActivityRouteValues(broadcast.Id)
   );
   var participationChecks = broadcast.ParticipationChecks.Count > 0
      ? broadcast.ParticipationChecks
      : broadcast.ParticipationCheck is null
         ? []
         : [broadcast.ParticipationCheck];
   var summaryCheck = participationChecks.FirstOrDefault(check =>
      string.Equals(
         check.Participation,
         "Yes",
         StringComparison.OrdinalIgnoreCase
      ))
      ?? participationChecks.FirstOrDefault(check =>
         string.Equals(
            check.Participation,
            "No",
            StringComparison.OrdinalIgnoreCase
         ))
      ?? participationChecks.FirstOrDefault(check =>
         string.Equals(
            check.Participation,
            "Unknown",
            StringComparison.OrdinalIgnoreCase
         ))
      ?? participationChecks.FirstOrDefault();
   var summaryText = summaryCheck is null
      ? "Not checked yet"
      : !string.IsNullOrWhiteSpace(summaryCheck.ErrorMessage)
         ? summaryCheck.ErrorMessage
         : summaryCheck.BadgeText;
   var hasRunningCheck = participationChecks.Any(check =>
      string.Equals(
         check.StatusId,
         "running",
         StringComparison.OrdinalIgnoreCase
      ));
   var summaryBadgeClass = summaryCheck is null ||
      string.IsNullOrWhiteSpace(summaryCheck.Participation)
         ? string.Empty
         : summaryCheck.IsPositive
            ? "tool-trace-badge tool-trace-badge-result"
            : summaryCheck.Participation.Trim()
               .Equals("Unknown", StringComparison.OrdinalIgnoreCase)
               ? "tool-trace-badge tool-trace-badge-count"
               : "tool-trace-badge tool-trace-badge-temperature";
}

<div class="broadcast-ai-check-runs">
   <table class="broadcast-ai-check-runs-table">
      <thead class="broadcast-ai-check-runs-head">
         <tr>
            <th colspan="5">
               <div class="broadcast-ai-check-runs-summary-bar">
                  <span class="broadcast-ai-check-runs-summary-text
                     @summaryBadgeClass">
                     @summaryText
                  </span>
                  <div class="broadcast-ai-check-runs-summary-actions">
                     @if(!hasRunningCheck)
                     {
                        <button class="button broadcast-ai-check-action"
                                type="button"
                                data-check-participation-row
                                data-check-participation-url=
                                   "@Model.CheckParticipationUrl"
                                data-broadcast-id="@broadcast.Id">
                           Check
                        </button>
                     }
                     <button class="button broadcast-ai-check-toggle"
                             type="button"
                             data-participation-runs-toggle
                             aria-expanded="false">
                        Show
                     </button>
                  </div>
               </div>
            </th>
         </tr>
      </thead>
      <tbody class="broadcast-ai-check-runs-body" hidden>
         @if(participationChecks.Count == 0)
         {
               <tr class="broadcast-ai-check-row">
                  <td class="broadcast-ai-check-summary-cell">
                     <span class="broadcast-ai-check-empty">
                        Not checked yet
                     </span>
                  </td>
               <td class="broadcast-ai-check-view-run-cell"></td>
               <td class="broadcast-ai-check-sources-cell"></td>
               <td class="broadcast-ai-check-activity-cell">
                  @if(!string.IsNullOrWhiteSpace(baseActivityUrl))
                     {
                        <a href="@baseActivityUrl"
                        target="_blank"
                        rel="noreferrer noopener">
                        Create Activity
                     </a>
                  }
               </td>
            </tr>
         }
         else
         {
            @foreach(var check in participationChecks)
            {
               <tr class="broadcast-ai-check-row">
                  <td class="broadcast-ai-check-summary-cell">
                     @if(!string.IsNullOrWhiteSpace(check.ErrorMessage))
                     {
                        <div class="broadcast-ai-check-line">
                           <span class="status-pill status-pill-warning">
                              Error
                           </span>
                        </div>
                        <span class="broadcast-ai-check-error">
                           @check.ErrorMessage
                        </span>
                     }
                     else if(string.IsNullOrWhiteSpace(check.Participation))
                     {
                        <div class="broadcast-ai-check-line">
                           <span class="broadcast-ai-check-pending">
                              @check.StatusId
                           </span>
                           @if(check.StatusId == "running")
                           {
                              <span class="broadcast-ai-check-rounds">
                                 Rounds: @check.ToolRoundCount
                              </span>
                           }
                        </div>
                     }
                     else
                     {
                        var positiveClass = check.IsPositive
                           ? "status-pill-positive"
                           : "status-pill-neutral";
                        <div class="broadcast-ai-check-line">
                           <span class="status-pill @positiveClass">
                              @check.BadgeText
                           </span>
                        </div>
                     }
                  </td>
                  <td class="broadcast-ai-check-view-run-cell">
                     @if(check.RunId != Guid.Empty)
                     {
                        <a asp-page="/Admin/Runs/Details"
                           asp-route-id="@check.RunId"
                           asp-route-jobId=
                              "decide-swedish-participation"
                           target="_blank"
                           rel="noreferrer noopener"
                           data-run-link="true">
                           View run
                        </a>
                     }
                  </td>
                  @if(check.Participants.Count > 0)
                  {
                     <td class="broadcast-ai-check-participants-cell">
                        @{
                           var participantItems = Model.PageModel
                              .GetParticipantDisplayItems(
                                 check.Participants
                              );
                        }
                        <div class="broadcast-ai-check-participants">
                           @foreach(var participant in participantItems)
                           {
                              <div class="broadcast-ai-check-participant-row">
                                 @if(participant.EditUrl is not null)
                                 {
                                    <a class="broadcast-ai-check-participant-link"
                                       href="@participant.EditUrl"
                                       target="_blank"
                                       rel="noreferrer noopener"
                                       title="Edit entity">
                                       @participant.Name
                                    </a>
                                 }
                                 else
                                 {
                                    <span>@participant.Name</span>
                                 }

                                 @if(participant.TemplateEntityId is not null)
                                 {
                                    <form method="post"
                                          action=
                                             "@Model.CreateParticipantEntityUrl"
                                          class=
                                             "broadcast-ai-check-participant-create-form"
                                          data-ajax-success="replace">
                                       @Html.AntiForgeryToken()
                                       <input type="hidden"
                                              name="participantName"
                                              value="@participant.Name" />
                                       <input type="hidden"
                                              name="templateEntityId"
                                              value=
                                                 "@participant.TemplateEntityId" />
                                       <button type="submit"
                                               class=
                                                  "broadcast-ai-check-participant-create-button"
                                               title="Create entity"
                                               aria-label=
                                                  "Create entity for @participant.Name">
                                          +
                                       </button>
                                    </form>
                                 }
                              </div>
                           }
                        </div>
                     </td>
                  }
                  <td class="broadcast-ai-check-sources-cell">
                     @if(check.SourceUrls.Count > 0)
                     {
                        <div class="broadcast-ai-check-sources">
                           <div class="broadcast-ai-check-sources-list">
                              @foreach(var sourceUrl in check.SourceUrls)
                              {
                                 <a href="@sourceUrl"
                                    target="_blank"
                                    rel="noreferrer noopener"
                                    title="@sourceUrl">
                                    @sourceUrl
                                 </a>
                              }
                           </div>
                        </div>
                     }
                  </td>
                  <td class="broadcast-ai-check-activity-cell">
                     @{
                        var activityUrl = Url.Page(
                           "/Admin/Activities/Edit",
                           Model.PageModel.GetActivityRouteValues(
                              broadcast.Id,
                              check.RunId
                           )
                        );
                     }
                     @if(!string.IsNullOrWhiteSpace(activityUrl))
                     {
                        <div class="broadcast-ai-check-activity-link">
                           <a href="@activityUrl"
                              target="_blank"
                              rel="noreferrer noopener">
                              Create Activity
                           </a>
                        </div>
                     }
                  </td>
               </tr>
            }
         }
      </tbody>
   </table>
</div>
