@page
@model SESport.Web.Pages.Admin.Broadcasts.IndexModel
@{ 
   ViewData["Title"] = "Broadcasts";
   var checkParticipationStatusUrl = Url.Page(
      "/Admin/Ajax/Poll/ParticipationStatus"
   );
   var editBroadcastFieldUrl = Url.Page(
      "/Admin/Ajax/Update/BroadcastField"
   );
   var broadcastRowUrl = Url.Page("/Admin/Ajax/List/Broadcast");
   var runFieldUrl = Url.Page("/Admin/Ajax/Update/RunField");
   var searchEntityUrl = Url.Page(
      "/Admin/Ajax/Search/Entity"
   );
   var todoReturnUrl = $"{Request.Path}{Request.QueryString}";
}

@Html.AntiForgeryToken()

<section class="page-heading page-heading-row">
   <div>
      <h1>Broadcasts</h1>
   </div>
   <div class="button-row">
      <details class="todo-composer">
         <summary class="button">Todo</summary>
         <form method="post"
               asp-page-handler="AddTodo"
               class="todo-composer-form">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="returnUrl"
                   value="@todoReturnUrl" />
            <label>
               <span>Todo</span>
               <textarea name="text"
                         rows="3"
                         maxlength="2000"
                         required></textarea>
            </label>
            <button class="button button-primary" type="submit">
               Save
            </button>
         </form>
      </details>
   </div>
</section>

<section class="form-section">
      <form method="get"
         class="filter-form broadcast-filter-form"
         data-ajax-count-target="[data-broadcast-count]"
         data-ajax-replace-target="[data-broadcast-results]">
      <input type="hidden"
             name="@RouteKeys.SortColumn"
             value="@Model.SortColumn" />
      <input type="hidden"
             name="@RouteKeys.SortAsc"
             value="@Model.SortAsc.ToString()" />
      <label>
         <span>Titel</span>
         <input type="search"
                name="@RouteKeys.TitleFilter"
                value="@Model.TitleFilter"
                autocomplete="off"
                oninput="submitFilterForm(this);" />
      </label>
      <label>
         <span>Date</span>
         <input type="date"
                name="@RouteKeys.Date"
                value="@Model.DateText"
                onchange="this.form.submit();" />
         @await Html.PartialAsync("/Pages/Shared/_AdminDateStepper.cshtml")
      </label>
      <div class="filter-sports">
         <label asp-for="SelectedSports">
            <span>Sporter</span>
            <select asp-for="SelectedSports"
                    asp-items="Model.SportOptions"
                    multiple="multiple"
                    size="1"
                    data-empty-option="exclusive"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
      </div>
      @* <label class="check-row filter-checkbox">
            <input type="checkbox"
                name="@RouteKeys.HideReplays"
                value="true"
                checked="@Model.HideReplays"
                onchange="this.form.submit();" />
         <span>Hide reruns (broken)</span>
      </label> *@
      <label class="check-row filter-checkbox">
            <input type="checkbox"
                name="@RouteKeys.ShowHidden"
                value="true"
                checked="@Model.ShowHidden"
                onchange="this.form.submit();" />
         <input type="hidden"
                name="@RouteKeys.ShowHidden"
                value="false" />
         <span>Show hidden</span>
      </label>
      <span class="entity-filter-count filter-form-count">
         Broadcasts:
         <strong data-broadcast-count>@Model.Broadcasts.Count</strong>
      </span>
   </form>
</section>

<div data-broadcast-results
     data-ajax-count-value="@Model.Broadcasts.Count"
     data-broadcast-date="@Model.DateText"
     data-broadcast-sort-column="@Model.SortColumn"
     data-broadcast-sort-asc="@Model.SortAsc.ToString()"
     data-broadcast-show-hidden="@Model.ShowHidden.ToString()"
     data-broadcast-hide-replays="@Model.HideReplays.ToString()"
     data-broadcast-selected-sports="@System.Text.Json.JsonSerializer.Serialize(Model.SelectedSports)"
     data-broadcast-inline-edit-url="@editBroadcastFieldUrl"
     data-broadcast-row-url="@broadcastRowUrl"
     data-run-inline-edit-url="@runFieldUrl"
     data-org-entity-search-url="@searchEntityUrl"
     data-search-url-base="@ViewData["SearchUrl"]"
     data-check-participation-status-url=
        "@checkParticipationStatusUrl">
   @if(Model.LoadError is not null)
   {
      <div class="notice notice-warning">
         @Model.LoadError
      </div>
   }
   else if(Model.Broadcasts.Count == 0)
   {
      <div class="notice">
         No broadcasts for @Model.DateText.
      </div>
   }
   else
   {
      <div class="admin-table-wrap">
            <table class="admin-table admin-table-hover broadcasts-table">
            <thead>
                  <tr>
                     <th class="broadcasts-col-source"
                         aria-hidden="true"></th>
                     <th class="broadcasts-col-channel">
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Channel")'>
                           Channel @Model.GetSortIndicator("Channel")
                        </a>
                     </th>
                     <th class="broadcasts-col-time">
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Time")'>
                           Time @Model.GetSortIndicator("Time")
                        </a>
                     </th>
                     <th class="broadcasts-col-broadcast">
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Broadcast")'>
                           Broadcast @Model.GetSortIndicator("Broadcast")
                        </a>
                     </th>
                     <th class="broadcasts-col-organization">
                        Organization
                     </th>
                     <th class="broadcasts-col-group">
                        Group
                     </th>
                     <th class="broadcasts-col-categories">
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Categories")'>
                           Categories @Model.GetSortIndicator("Categories")
                        </a>
                     </th>
                     <th class="broadcasts-col-actions">Actions</th>
                  </tr>
            </thead>
            @foreach(var broadcast in Model.Broadcasts)
            {
               @await Html.PartialAsync(
                  "_BroadcastRow",
                  SESport.Web.Pages.Admin.Broadcasts.BroadcastRowViewModel.Create(
                     broadcast,
                     Url,
                     Request,
                     Model.SelectedDate,
                     Model.SortColumn,
                     Model.SortAsc,
                     Model.ShowHidden,
                     Model.HideReplays,
                     Model.SelectedSports,
                     ViewData["SearchUrl"] as string
                  )
               )
            }
         </table>
      </div>
   }
</div>
