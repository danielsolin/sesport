@page
@model SESport.Web.Pages.Admin.Broadcasts.IndexModel
@{ 
   ViewData["Title"] = "Broadcasts";
   var checkParticipationUrl = Url.Page(
      "/Admin/Ajax/Create/ParticipationCheck"
   );
   var checkParticipationStatusUrl = Url.Page(
      "/Admin/Ajax/Poll/ParticipationStatus"
   );
   var createParticipantEntityUrl = Url.Page(
      "/Admin/Ajax/Create/ParticipantEntity"
   );
   var editBroadcastFieldUrl = Url.Page(
      "/Admin/Ajax/Update/BroadcastField"
   );
   var hideBroadcastUrl = Url.Page(
      "/Admin/Ajax/Toggle/BroadcastVisibility"
   );
}

@Html.AntiForgeryToken()

<section class="page-heading page-heading-row">
   <div>
      <h1>Broadcasts</h1>
   </div>
</section>

<section class="form-section">
      <form method="get"
         class="filter-form"
         data-ajax-replace-target="[data-broadcast-results]">
      <input type="hidden" name="@RouteKeys.SortColumn" value="@Model.SortColumn" />
      <input type="hidden"
             name="@RouteKeys.SortAsc"
             value="@Model.SortAsc.ToString()" />
      <label>
         <span>Date</span>
         <input type="date"
                name="@RouteKeys.Date"
                value="@Model.DateText"
                onchange="this.form.submit();" />
      </label>
      <div class="filter-sports">
         <label asp-for="SelectedSports">
            <span>Sporter</span>
            <select asp-for="SelectedSports"
                    asp-items="Model.SportOptions"
                    multiple="multiple"
                    size="1"
                    data-empty-option="exclusive"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
      </div>
      @* <label class="check-row filter-checkbox">
            <input type="checkbox"
                name="@RouteKeys.HideReplays"
                value="true"
                checked="@Model.HideReplays"
                onchange="this.form.submit();" />
         <span>Hide reruns (broken)</span>
      </label> *@
      <label class="check-row filter-checkbox">
            <input type="checkbox"
                name="@RouteKeys.ShowHidden"
                value="true"
                checked="@Model.ShowHidden"
                onchange="this.form.submit();" />
         <span>Show hidden</span>
      </label>
   </form>
</section>

<div data-broadcast-results
     data-create-participant-url="@createParticipantEntityUrl"
     data-broadcast-inline-edit-url="@editBroadcastFieldUrl"
     data-search-url-base="@ViewData["SearchUrl"]"
     data-check-participation-status-url=
        "@checkParticipationStatusUrl">
   @if(Model.LoadError is not null)
   {
      <div class="notice notice-warning">
         @Model.LoadError
      </div>
   }
   else if(Model.Broadcasts.Count == 0)
   {
      <div class="notice">
         No broadcasts for @Model.DateText.
      </div>
   }
   else
   {
      <section class="form-section">
         <div class="ses-table-header">
            <div>
               <span data-broadcast-count>
                  @Model.Broadcasts.Count
               </span>
               broadcasts
            </div>
         </div>
         <div class="admin-table-wrap">
            <table class="admin-table admin-table-hover broadcasts-table">
               <thead>
                  <tr>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Channel")'>
                           Channel @Model.GetSortIndicator("Channel")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Time")'>
                           Time @Model.GetSortIndicator("Time")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Broadcast")'>
                           Broadcast @Model.GetSortIndicator("Broadcast")
                        </a>
                     </th>
                     <th>
                        <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Categories")'>
                           Categories @Model.GetSortIndicator("Categories")
                        </a>
                     </th>
                     <th>AI check</th>
                     <th>Actions</th>
                  </tr>
               </thead>
               <tbody>
                 @foreach(var broadcast in Model.Broadcasts)
                     {
                     DateOnly? airDate = null;
                     if(broadcast.IsReplay
                        && broadcast.OriginalAirDate != null)
                     {
                        airDate = broadcast.OriginalAirDate.Value;
                     }
                     <tr data-participation-status=
                            "@broadcast.ParticipationCheck?.StatusId">
                        <td class="se-no-bottom-border">
                           <div class="ses-nowrap">
                              @broadcast.ChannelName
                           </div>
                        </td>
                        <td class="se-no-bottom-border">
                           <strong class="ses-nowrap">
                              @broadcast.TimeOnlyText
                           </strong>
                        </td>
                        <td class="broadcast-inline-editable se-no-bottom-border"
                            data-broadcast-id="@broadcast.Id"
                            data-broadcast-inline-edit-field="title"
                            data-broadcast-inline-edit-value=
                               "@broadcast.Title"
                            title="Double-click to edit">
                           <div data-broadcast-inline-edit-display>
                              <strong data-broadcast-title-text>
                                 @broadcast.Title
                              </strong>
                              <a class="ses-entity-search-link"
                                 data-broadcast-title-search-link
                                 href="@ViewData["SearchUrl"]@broadcast.Title"
                                 target="_blank">
                                 <span class="ses-icon-search"></span>
                              </a>
                              @if(!string.IsNullOrWhiteSpace(
                                 broadcast.Description))
                              {
                                 <span>@broadcast.Description</span>
                              }
                              @if(airDate != null)
                              {
                                 <span>
                                    Repris från @airDate
                                 </span>
                              }
                           </div>
                           <input class="broadcast-inline-edit-input"
                                  data-broadcast-inline-edit-input
                                  type="text"
                                  value="@broadcast.Title"
                                  autocomplete="off"
                                  spellcheck="false"
                                  aria-label="Edit broadcast title"
                                  hidden />
                        </td>
                        <td class="broadcast-inline-editable se-no-bottom-border"
                            data-broadcast-id="@broadcast.Id"
                            data-broadcast-inline-edit-field="categories"
                            data-broadcast-inline-edit-value=
                               "@broadcast.Categories"
                            title="Double-click to edit">
                           <div data-broadcast-inline-edit-display>
                              <div class="broadcast-categories-list"
                                   data-broadcast-categories-list>
                                 @foreach(var category in broadcast.Categories
                                    .Split(
                                       ',',
                                       StringSplitOptions.RemoveEmptyEntries
                                       | StringSplitOptions.TrimEntries
                                    ))
                                 {
                                    <span>@category</span>
                                 }
                              </div>
                           </div>
                           <input class="broadcast-inline-edit-input"
                                  data-broadcast-inline-edit-input
                                  type="text"
                                  value="@broadcast.Categories"
                                  autocomplete="off"
                                  spellcheck="false"
                                  aria-label="Edit categories"
                                  hidden />
                        </td>
                           <td data-participation-cell
                               data-broadcast-id="@broadcast.Id"
                               data-participation-run-id=
                                  "@broadcast.ParticipationCheck?.RunId"
                               data-participation-status=
                                  "@broadcast.ParticipationCheck?.StatusId"
                               data-check-participation-url=
                                  "@checkParticipationUrl">
                              @{
                                 var participationChecks =
                                    broadcast.ParticipationChecks.Count > 0
                                       ? broadcast.ParticipationChecks
                                       : broadcast.ParticipationCheck is null
                                          ? []
                                          : [broadcast.ParticipationCheck];
                                 var latestCheck = participationChecks.FirstOrDefault();
                              }
                              @if(latestCheck is null)
                              {
                                 <button class="button broadcast-ai-check-action"
                                         type="button"
                                         data-check-participation-row
                                         data-check-participation-url=
                                            "@checkParticipationUrl"
                                         data-broadcast-id="@broadcast.Id">
                                    Check
                                 </button>
                              }
                              else
                              {
                                 <details class="broadcast-ai-check-runs">
                                    <summary>
                                       <span class="broadcast-ai-check-runs-summary-text">
                                          @latestCheck.SummaryText
                                       </span>
                                       @if(participationChecks.Count > 1)
                                       {
                                          <span class="broadcast-ai-check-runs-summary-count">
                                             +@(participationChecks.Count - 1) more
                                          </span>
                                       }
                                    </summary>
                                    <div class="broadcast-ai-check-runs-body">
                                       @foreach(var check in participationChecks)
                                       {
                                          <div class="broadcast-ai-check">
                                             @if(!string.IsNullOrWhiteSpace(
                                                check.ErrorMessage))
                                             {
                                                <div class="broadcast-ai-check">
                                                   <div class="broadcast-ai-check-line">
                                                      <span class="status-pill
                                                         status-pill-warning">
                                                         Error
                                                      </span>
                                                      <button class="button
                                                         broadcast-ai-check-action
                                                         broadcast-ai-check-retry"
                                                              type="button"
                                                              data-check-participation-row
                                                              data-check-participation-url=
                                                                 "@checkParticipationUrl"
                                                              data-broadcast-id=
                                                                 "@broadcast.Id">
                                                         Retry
                                                      </button>
                                                   </div>
                                                   <span class="broadcast-ai-check-error">
                                                      @check.ErrorMessage
                                                   </span>
                                                   @if(check.SourceUrls.Count > 0)
                                                   {
                                                      <details class="broadcast-ai-check-sources"
                                                         data-source-count=
                                                            "@check.SourceUrls.Count">
                                                         <summary>
                                                            <button type="button"
                                                                    class="broadcast-ai-check-participants-more"
                                                                    data-sources-toggle="true">
                                                               Sources (@(
                                                                  check.SourceUrls.Count
                                                               ))
                                                            </button>
                                                         </summary>
                                                         <div class="broadcast-ai-check-sources-list">
                                                            @foreach(
                                                               var sourceUrl in check.SourceUrls
                                                            )
                                                            {
                                                               <a href="@sourceUrl"
                                                                  target="_blank"
                                                                  rel="noreferrer noopener"
                                                                  title="@sourceUrl">
                                                                  @sourceUrl
                                                               </a>
                                                            }
                                                         </div>
                                                      </details>
                                                   }
                                                </div>
                                             }
                                             else if(string.IsNullOrWhiteSpace(
                                                check.SwedishParticipation))
                                             {
                                                <div class="broadcast-ai-check-line">
                                                   <span class="broadcast-ai-check-pending">
                                                      @check.StatusId
                                                   </span>
                                                   @if(check.StatusId == "running")
                                                   {
                                                      <span class="broadcast-ai-check-rounds">
                                                         Rounds: @check.ToolRoundCount
                                                      </span>
                                                   }
                                                   @if(check.RunId != Guid.Empty)
                                                   {
                                                      <a asp-page=
                                                            "/Admin/Runs/Details"
                                                         asp-route-id=
                                                            "@check.RunId"
                                                         asp-route-jobId=
                                                            "decide-swedish-participation"
                                                         target="_blank"
                                                         rel="noreferrer noopener"
                                                         data-run-link="true">
                                                         View run
                                                      </a>
                                                   }
                                                </div>
                                             }
                                             else
                                             {
                                                <div class="broadcast-ai-check-line">
                                                   <span class="status-pill
                                                      @(check.IsPositive
                                                         ? "status-pill-positive"
                                                         : "status-pill-neutral")">
                                                      @check.BadgeText
                                                   </span>
                                                   <button class="button
                                                      broadcast-ai-check-action
                                                      broadcast-ai-check-retry"
                                                           type="button"
                                                           data-check-participation-row
                                                           data-check-participation-url=
                                                              "@checkParticipationUrl"
                                                           data-broadcast-id=
                                                              "@broadcast.Id">
                                                      Retry
                                                   </button>
                                                   @if(check.RunId != Guid.Empty)
                                                   {
                                                      <a asp-page=
                                                            "/Admin/Runs/Details"
                                                         asp-route-id=
                                                            "@check.RunId"
                                                         asp-route-jobId=
                                                            "decide-swedish-participation"
                                                         target="_blank"
                                                         rel="noreferrer noopener"
                                                         data-run-link="true">
                                                         View run
                                                      </a>
                                                   }
                                                </div>
                                                @if(!string.IsNullOrWhiteSpace(
                                                   check.ParticipantsPreview))
                                                {
                                                   var participantItems =
                                                      Model.GetParticipantDisplayItems(
                                                         check.SwedishParticipants
                                                      );
                                                   if(check.HasMoreParticipants)
                                                   {
                                                      <div class="broadcast-ai-check-participants"
                                                           data-participants-json=
                                                              "@System.Text.Json.JsonSerializer.Serialize(
                                                                 participantItems
                                                              )">
                                                         <div class="broadcast-ai-check-participants-preview">
                                                            @foreach(
                                                               var participant in participantItems.Take(3)
                                                            )
                                                            {
                                                               <div class="broadcast-ai-check-participant-row">
                                                                  @if(participant.EditUrl is not null)
                                                                  {
                                                                     <a class="broadcast-ai-check-participant-link"
                                                                        href="@participant.EditUrl"
                                                                        title="Edit entity">
                                                                        @participant.Name
                                                                     </a>
                                                                  }
                                                                  else
                                                                  {
                                                                     <span>@participant.Name</span>
                                                                  }

                                                                  @if(participant.TemplateEntityId is not null)
                                                                  {
                                                                        <form method="post"
                                                                           action="@createParticipantEntityUrl"
                                                                           class="broadcast-ai-check-participant-create-form"
                                                                           data-ajax-success=
                                                                              "replace">
                                                                           @Html.AntiForgeryToken()
                                                                           <input type="hidden"
                                                                                  name="participantName"
                                                                                  value="@participant.Name" />
                                                                           <input type="hidden"
                                                                                  name="templateEntityId"
                                                                                  value="@participant.TemplateEntityId" />
                                                                           <button type="submit"
                                                                                   class="broadcast-ai-check-participant-create-button"
                                                                                   title="Create entity"
                                                                                   aria-label="Create entity for @participant.Name">
                                                                              +
                                                                           </button>
                                                                        </form>
                                                                  }
                                                               </div>
                                                            }
                                                         </div>
                                                      </div>
                                                   }
                                                   else
                                                   {
                                                      <div class="broadcast-ai-check-participants"
                                                           data-participants-json=
                                                              "@System.Text.Json.JsonSerializer.Serialize(
                                                                 participantItems
                                                              )">
                                                         @foreach(var participant in participantItems)
                                                         {
                                                            <div class="broadcast-ai-check-participant-row">
                                                               @if(participant.EditUrl is not null)
                                                               {
                                                                  <a class="broadcast-ai-check-participant-link"
                                                                     href="@participant.EditUrl"
                                                                     title="Edit entity">
                                                                     @participant.Name
                                                                  </a>
                                                               }
                                                               else
                                                               {
                                                                  <span>@participant.Name</span>
                                                               }

                                                               @if(participant.TemplateEntityId is not null)
                                                               {
                                                                     <form method="post"
                                                                        action="@createParticipantEntityUrl"
                                                                        class="broadcast-ai-check-participant-create-form"
                                                                        data-ajax-success=
                                                                           "replace">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden"
                                                                               name="participantName"
                                                                               value="@participant.Name" />
                                                                        <input type="hidden"
                                                                               name="templateEntityId"
                                                                               value="@participant.TemplateEntityId" />
                                                                        <button type="submit"
                                                                                class="broadcast-ai-check-participant-create-button"
                                                                                title="Create entity"
                                                                                aria-label="Create entity for @participant.Name">
                                                                           +
                                                                        </button>
                                                                     </form>
                                                               }
                                                            </div>
                                                         }
                                                      </div>
                                                   }
                                                }
                                                @if(check.SourceUrls.Count > 0)
                                                {
                                                   <details class="broadcast-ai-check-sources">
                                                      <summary>
                                                         <button type="button"
                                                                 class="broadcast-ai-check-participants-more"
                                                                 data-sources-toggle="true">
                                                            Sources (@(
                                                               check.SourceUrls.Count
                                                            ))
                                                         </button>
                                                      </summary>
                                                      <div class="broadcast-ai-check-sources-list">
                                                         @foreach(
                                                            var sourceUrl in check.SourceUrls
                                                         )
                                                         {
                                                            <a href="@sourceUrl"
                                                               target="_blank"
                                                               rel="noreferrer noopener"
                                                               title="@sourceUrl">
                                                               @sourceUrl
                                                            </a>
                                                         }
                                                      </div>
                                                   </details>
                                                }
                                             }
                                          </div>
                                       }
                                    </div>
                                 </details>
                              }
                           </td>
                        <td class="table-actions se-no-bottom-border">
                           <div class="table-actions-stack">
                              <a class="broadcast-activity-link"
                                 asp-page="/Admin/Activities/Edit"
                                 asp-all-route-data=
                                    "@Model.GetActivityRouteValues(
                                       broadcast.Id
                                    )">
                                 Activity
                              </a>
                              <form method="post"
                                    action="@hideBroadcastUrl"
                                    data-ajax-success="remove"
                                    data-ajax-remove-target="tr"
                                    data-ajax-decrement-target=
                                       "[data-broadcast-count]">
                                 @Html.AntiForgeryToken()
                                 <input type="hidden"
                                        name="id"
                                        value="@broadcast.Id" />
                                 <input type="hidden"
                                        name="@RouteKeys.Date"
                                        value="@Model.DateText" />
                                 <input type="hidden"
                                        name="isHidden"
                                        value="@broadcast.IsHidden.ToString()" />
                                 <input type="hidden"
                                        name="@RouteKeys.SortColumn"
                                        value="@Model.SortColumn" />
                                 <input type="hidden"
                                        name="@RouteKeys.SortAsc"
                                        value="@Model.SortAsc.ToString()" />
                                 @if(Model.HideReplays)
                                 {
                                    <input type="hidden"
                                           name="@RouteKeys.HideReplays"
                                           value="true" />
                                 }
                                 @foreach(var sport in Model.SelectedSports
                                    .Where(value =>
                                       !string.IsNullOrWhiteSpace(value)))
                                 {
                                    <input type="hidden"
                                           name="SelectedSports"
                                           value="@sport" />
                                 }
                                 <button type="submit">
                                    @(broadcast.IsHidden ? "Show" : "Hide")
                                 </button>
                              </form>
                           </div>
                           </td>
                        </tr>
                     }
               </tbody>
            </table>
         </div>
      </section>
   }
</div>
