@page
@model SESport.Web.Pages.Admin.Activities.ProposalsModel
@{
   ViewData["Title"] = "Activity Proposals";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Activity proposals</h1>
   </div>
   <a class="button" asp-page="/Admin/Activities/Index">Back</a>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<section class="form-section">
   <h2>Proposals</h2>
   <table class="admin-table">
      <thead>
         <tr>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Created"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Created")'>
                  Created @Model.GetSortIndicator("Created")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Time"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Time")'>
                  Time @Model.GetSortIndicator("Time")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Activity"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Activity")'>
                  Activity @Model.GetSortIndicator("Activity")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Producer"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Producer")'>
                  Producer @Model.GetSortIndicator("Producer")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Status"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Status")'>
                  Status @Model.GetSortIndicator("Status")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Type"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Type")'>
                  Type @Model.GetSortIndicator("Type")
               </a>
            </th>
            <th>
               <a asp-page="./Proposals"
                  asp-route-sortColumn="Sport"
                  asp-route-sortAsc='@Model.GetNextSortAsc("Sport")'>
                  Sport @Model.GetSortIndicator("Sport")
               </a>
            </th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach(var proposal in Model.Proposals)
         {
            <tr>
               <td>@proposal.CreatedOn</td>
               <td>@proposal.TimeText</td>
               <td>
                  <a asp-page="./Proposal" asp-route-id="@proposal.Id">
                     <strong>@proposal.Title</strong>
                  </a>
               </td>
               <td>@proposal.Producer</td>
               <td>@proposal.Status</td>
               <td>@proposal.ActivityType</td>
               <td>@proposal.Sport</td>
               <td class="table-actions">
                  <a asp-page="./Proposal" asp-route-id="@proposal.Id">
                     Review
                  </a>
               </td>
            </tr>
         }
      </tbody>
   </table>
</section>
