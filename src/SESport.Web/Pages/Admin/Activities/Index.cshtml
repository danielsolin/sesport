@page
@model SESport.Web.Pages.Admin.Activities.IndexModel
@{
   ViewData["Title"] = "Activities";
   var returnUrl = Model.GetReturnUrl();
   var searchUrlBase = ViewData["SearchUrl"] as string ?? string.Empty;
   var findFactsUrl = Url.Page(
      "/Admin/Ajax/Create/ActivityFacts"
   );
   var findStartUrl = Url.Page(
      "/Admin/Ajax/Create/ActivityParticipantFindStart"
   );
   var findResultUrl = Url.Page(
      "/Admin/Ajax/Create/ActivityParticipantFindResult"
   );
   var runStatusesUrl = Url.Page(
      "/Admin/Ajax/Poll/RunStatuses"
   );
   var todoReturnUrl = $"{Request.Path}{Request.QueryString}";
}

<section class="page-heading page-heading-row">
   <div class="page-heading-title-row">
      <h1>Activities</h1>
   </div>
   <div class="button-row">
      <a class="button button-primary"
         asp-page="./Edit"
         asp-route-returnUrl="@returnUrl">
         New activity
      </a>
      <details class="todo-composer">
         <summary class="button">Todo</summary>
         <form method="post"
               asp-page-handler="AddTodo"
               class="todo-composer-form">
            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="returnUrl"
                   value="@todoReturnUrl" />
            <label>
               <span>Todo</span>
               <textarea name="text"
                         rows="3"
                         maxlength="2000"
                         required></textarea>
            </label>
            <button class="button button-primary" type="submit">
               Save
            </button>
         </form>
      </details>
   </div>
</section>

<section class="form-section">
   <form method="get"
         class="filter-form"
         data-ajax-count-target="[data-activity-count]"
         data-ajax-replace-target="[data-activity-results]">
      <input type="hidden"
             name="@RouteKeys.SortColumn"
             value="@Model.SortColumn" />
      <input type="hidden"
             name="@RouteKeys.SortAsc"
             value="@Model.SortAsc.ToString()" />
      <label>
         <span>Date</span>
         <input type="date"
                name="@RouteKeys.Date"
                value="@Model.DateText"
                onchange="this.form.submit();" />
      </label>
      <div class="filter-sports">
         <label asp-for="SelectedSports">
            <span>Sporter</span>
            <select asp-for="SelectedSports"
                    asp-items="Model.SportOptions"
                    multiple="multiple"
                    size="1"
                    data-empty-option="exclusive"
               onchange="submitFilterForm(this);">
            </select>
         </label>
      </div>
      <label>
         <span>Status</span>
         <select name="@RouteKeys.Status"
                 onchange="this.form.submit();">
            <option value="@ActivityListStatusIds.All"
                    selected="@(Model.Status == ActivityListStatusIds.All)">
               All
            </option>
            <option value="@ActivityPublicationStatusIds.Draft"
                    selected="@(Model.Status ==
                       ActivityPublicationStatusIds.Draft)">
               Draft
            </option>
            <option value="@ActivityPublicationStatusIds.Published"
                    selected="@(Model.Status ==
                       ActivityPublicationStatusIds.Published)">
               Published
            </option>
         </select>
      </label>
      <span class="entity-filter-count filter-form-count">
         Activities:
         <strong data-activity-count>@Model.Activities.Count</strong>
      </span>
   </form>
</section>

<div data-activity-results
     data-ajax-count-value="@Model.Activities.Count"
     data-run-statuses-url="@runStatusesUrl">
   @if(Model.LoadError is not null)
   {
      <div class="notice notice-warning">
         @Model.LoadError
      </div>
   }
   else if(Model.Activities.Count == 0)
   {
      <div class="notice">
         No activities to show.
      </div>
   }
   else
   {
      <div class="admin-table-wrap">
         <table class="admin-table admin-table-hover">
            <thead>
               <tr>
                  <th>Date</th>
                  <th>
                     <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Time")'>
                        Time @Model.GetSortIndicator("Time")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Entities")'>
                        <span title="Participants">
                           # @Model.GetSortIndicator("Entities")
                        </span>
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Activity")'>
                        Activity @Model.GetSortIndicator("Activity")
                     </a>
                  </th>
                  <th>
                     <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Group")'>
                        Group @Model.GetSortIndicator("Group")
                     </a>
                  </th>
                  <th>Description</th>
                  <th>
                     <a asp-page="./Index"
                           asp-all-route-data=
                              '@Model.GetSortRouteValues("Status")'>
                        Status @Model.GetSortIndicator("Status")
                     </a>
                  </th>
                  <th></th>
               </tr>
            </thead>
            <tbody>
               @foreach(var activity in Model.Activities)
               {
                  var missingDescription = string.IsNullOrWhiteSpace(
                     activity.Description
                  );
                  var noParticipants =
                     activity.RelatedPersonEntityIds.Length < 1;
                  var highlightRow = missingDescription || noParticipants;
                  var activitySearchUrl =
                     $"{searchUrlBase}{System.Uri.EscapeDataString(
                        activity.Title
                     )}";
                  var startTime = activity.LocalStartTime?.ToString(
                     DateDisplay.TimeOnlyMinutesFormat
                  )
                     ?? "?";
                  var endTime = activity.LocalEndTime?.ToString(
                     DateDisplay.TimeOnlyMinutesFormat
                  )
                     ?? "?";
                  <tr class="@(highlightRow
                     ? "activity-description-missing"
                     : string.Empty)">
                     <td>
                        @activity.ActivityDate.ToString(
                           DateDisplay.MonthDayFormat
                        )
                     </td>
                     <td>@startTime–@endTime</td>
                     <td>@activity.RelatedPersonEntityIds.Length</td>
                     <td>
                        <a asp-page="./Edit"
                           asp-route-id="@activity.Id"
                           asp-route-returnUrl="@returnUrl">
                           @if(string.IsNullOrWhiteSpace(
                                 activity.RelatedOrganizationEntities))
                           {
                              <strong>@activity.Title</strong>
                           }
                           else
                           {
                              <span>
                                 @activity.RelatedOrganizationEntities:
                              </span>
                              <strong>@activity.Title</strong>
                           }
                        </a>
                        <a class="ses-entity-search-link"
                           href="@activitySearchUrl"
                           target="_blank">
                           <span class="ses-icon-search"></span>
                        </a>
                     </td>
                     <td>
                        @if(activity.ActivityGroupId is not null)
                        {
                           <a asp-page="/Admin/ActivityGroups/Edit"
                              asp-route-id="@activity.ActivityGroupId"
                              asp-route-returnUrl="@returnUrl">
                              @activity.ActivityGroupTitle
                           </a>
                        }
                     </td>
                     <td>
                        @if(!string.IsNullOrEmpty(activity.Description))
                        {
                           @activity.Description
                        }
                     </td>
                     <td>
                        <span class="status-pill">
                           @activity.PublicationStatus
                        </span>
                     </td>
                     <td class="table-actions activities-table-actions">
                        <div class="table-actions-stack">
                           <form method="post"
                                 data-activity-facts-check>
                              @Html.AntiForgeryToken()
                              <input type="hidden"
                                     name="Activity.Id"
                                     value="@activity.Id" />
                              <input type="hidden"
                                     name="Activity.Title"
                                     value="@activity.Title" />
                              <button class="broadcast-participation-check-link"
                                 type="submit"
                                 data-facts-url="@findFactsUrl">
                                 Group facts
                              </button>
                              <span class="form-status"
                                    data-facts-check-status></span>
                           </form>
                           <form method="post"
                                 data-activity-start-check>
                              @Html.AntiForgeryToken()
                              <input type="hidden"
                                     name="Activity.Id"
                                     value="@activity.Id" />
                              <input type="hidden"
                                     name="Activity.Title"
                                     value="@activity.Title" />
                              <button class="broadcast-participation-check-link"
                                 type="submit"
                                 data-start-url="@findStartUrl">
                                 Start
                              </button>
                              <span class="form-status"
                                    data-start-check-status></span>
                           </form>
                           <form method="post"
                                 data-activity-result-check>
                              @Html.AntiForgeryToken()
                              <input type="hidden"
                                     name="Activity.Id"
                                     value="@activity.Id" />
                              <input type="hidden"
                                     name="Activity.Title"
                                     value="@activity.Title" />
                              <button class="broadcast-participation-check-link"
                                 type="submit"
                                 data-result-url="@findResultUrl">
                                 Result
                              </button>
                              <span class="form-status"
                                    data-result-check-status></span>
                           </form>
                           <form method="post"
                                 asp-page-handler="Delete"
                                 asp-route-id="@activity.Id"
                                 onsubmit="return confirm('Sure?');">
                              <input type="hidden"
                                     name="@RouteKeys.Date"
                                     value="@Model.DateText" />
                              <input type="hidden"
                                     name="@RouteKeys.Status"
                                     value="@Model.Status" />
                              <input type="hidden"
                                     name="@RouteKeys.SortColumn"
                                     value="@Model.SortColumn" />
                              <input type="hidden"
                                     name="@RouteKeys.SortAsc"
                                     value="@Model.SortAsc.ToString()" />
                              @foreach(var sport in Model.SelectedSports
                                 .Where(value =>
                                    !string.IsNullOrWhiteSpace(value)))
                              {
                                 <input type="hidden"
                                        name="@RouteKeys.SelectedSports"
                                        value="@sport" />
                              }
                              <button type="submit">Delete</button>
                           </form>
                        </div>
                     </td>
                  </tr>
               }
            </tbody>
         </table>
      </div>
   }
</div>
