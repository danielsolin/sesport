@page
@model SESport.Web.Pages.Admin.Activities.IndexModel
@{
   ViewData["Title"] = "Activities";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>Activities</h1>
   </div>
   <a class="button button-primary" asp-page="./Edit">New activity</a>
</section>

<form method="get">
   <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
   <input type="hidden" name="sortAsc" value="@Model.SortAsc" />
   <select id="activity_status"
           name="status"
           onchange="this.form.submit();">
      <option value="Today"
         selected="@(Model.Status == "Today")">
         Today
      </option>
      <option value="Draft"
              selected="@(Model.Status == "Draft")">
         Drafts
      </option>
      <option value="Published"
              selected="@(Model.Status == "Published")">
         Published
      </option>
      <option value="All"
              selected="@(Model.Status == "All")">
         All
      </option>
   </select>
</form>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      The activity database is not available right now.
   </div>
}
else if(Model.Activities.Count == 0)
{
   <div class="notice">
      No activities to show.
   </div>
}
else
{
   <div class="admin-table-wrap">
      <table class="admin-table">
         <thead>
            <tr>
               <th>
                  <a asp-page="./Index"
                     asp-all-route-data='@Model.GetSortRouteValues("Time")'>
                     Time @Model.GetSortIndicator("Time")
                  </a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-all-route-data='@Model.GetSortRouteValues("Activity")'>
                     Activity @Model.GetSortIndicator("Activity")
                  </a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-all-route-data='@Model.GetSortRouteValues("Entities")'>
                     Entities @Model.GetSortIndicator("Entities")
                  </a>
               </th>
               <th>
                  <a asp-page="./Index"
                     asp-all-route-data='@Model.GetSortRouteValues("Status")'>
                     Status @Model.GetSortIndicator("Status")
                  </a>
               </th>
               <th></th>
            </tr>
         </thead>
         <tbody>
            @foreach(var activity in Model.Activities)
            {
               <tr>
                  <td>@activity.TimeText</td>
                  <td>
                     <strong>@activity.Title</strong>
                     <span>@activity.SportName / @activity.ActivityType</span>
                  </td>
                  <td>@activity.EntitySummary</td>
                  <td>
                     <span class="status-pill">
                        @activity.PublicationStatus
                     </span>
                  </td>
                  <td class="table-actions">
                     <a asp-page="./Edit" asp-route-id="@activity.Id">Edit</a>
                     <form method="post"
                           asp-page-handler="Delete"
                           asp-route-id="@activity.Id"
                           asp-route-status="@Model.Status"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortAsc="@Model.SortAsc"
                           onsubmit="return confirm('Sure?');">
                        <button type="submit">Delete</button>
                     </form>
                  </td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}
