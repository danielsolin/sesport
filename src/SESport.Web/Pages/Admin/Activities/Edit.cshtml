@page "{id:guid?}"
@model SESport.Web.Pages.Admin.Activities.EditModel
@{
   ViewData["Title"] = Model.Activity.Id is null
      ? "New Activity"
      : "Edit Activity";
   var generateTeaserUrl = Url.Page(
      "/Admin/Ajax/Create/ActivityTeaser"
   );
   var participantSearchUrl = Url.Page(
      "/Admin/Ajax/Search/ActivityParticipant"
   );
   var activityGroupSearchUrl = Url.Page(
      "/Admin/Ajax/Search/ActivityGroup"
   );
   var aiResultValueUrl = Url.Page(
      "/Admin/Ajax/Update/ActivityParticipantAiResultValue"
   );
}

<section class="page-heading page-heading-row">
   <div>
      <h1>@ViewData["Title"]</h1>
   </div>
   @if(Model.Activity.Id is not null)
   {
      <form method="post"
            class="activity-ai-job-form"
            asp-page-handler="RunAiJob"
            asp-route-id="@Model.Activity.Id">
         <input type="hidden"
                name="returnUrl"
                value="@Model.ReturnUrl" />
         <label>
            <select asp-for="SelectedAiJobId"
                    aria-label="AI job"
                    asp-items="Model.ActivityAiJobOptions"></select>
         </label>
         <button class="button button-primary" type="submit">
            Run
         </button>
      </form>
   }
</section>

@if(Model.Activity.AutoMergeActivityTitle is not null)
{
   <div class="notice notice-success">
      Den här aktiviteten kommer att slås ihop med en befintlig aktivitet
      '@Model.Activity.AutoMergeActivityTitle'.
   </div>
}

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

@if(Model.AiJobError is not null)
{
   <div class="notice notice-error">@Model.AiJobError</div>
}
@if(Model.AiJobMessage is not null)
{
   <div class="notice">@Model.AiJobMessage</div>
}

@if(Model.Activity.Id is not null)
{
   <form id="add-activity-source-form"
         method="post"
         asp-page-handler="AddSource">
      <input type="hidden" name="id" value="@Model.Activity.Id" />
      <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
   </form>
}

<form method="post" class="edit-form">
   <input asp-for="Activity.Id" type="hidden" />
   <input asp-for="Activity.ParticipationRunId" type="hidden" />
   <input asp-for="Activity.TimeZoneId" type="hidden" />
   <input asp-for="Activity.AutoMergeActivityId" type="hidden" />
   <input asp-for="Activity.AutoMergeActivityTitle" type="hidden" />
   <input asp-for="ReturnUrl" type="hidden" />
   <div asp-validation-summary="ModelOnly" class="notice notice-error"></div>
   @if (Model.Activity.ActivityGroupCreationRequired)
   {
      <div class="notice notice-warning">
         A new activity group will be created when you save this activity.
      </div>
   }
   else if (Model.Activity.Id is null &&
            Model.Activity.BroadcastIds.Count > 0 &&
            Model.Activity.ActivityGroupId is not null)
   {
      <div class="notice notice-success">
         This activity will reuse the existing activity group
         "@Model.Activity.ActivityGroupTitle".
      </div>
   }
   @foreach (var broadcastId in Model.Activity.BroadcastIds)
   {
      <input type="hidden"
             name="Activity.BroadcastIds"
             value="@broadcastId" />
   }
   <section class="form-section"
            data-activity-ai-results>
      <h2>Activity</h2>
      <div class="form-grid">
         <label>
            <span>Organization</span>
            <select asp-for="Activity.OrganizationEntityId"
                    asp-items="Model.OrganizationEntities">
               <option value="">Select organization</option>
            </select>
         </label>
         <label>
            <span>Group</span>
            <div class="activity-group-picker"
                 data-activity-group-picker
                 data-activity-group-search-url=
                    "@activityGroupSearchUrl"
                 data-activity-group-sport-id="@Model.Activity.SportId">
               <input asp-for="Activity.ActivityGroupCreationRequired"
                      type="hidden"
                      data-activity-group-creation-required />
               <input class="broadcast-org-entity-input"
                      type="text"
                      aria-label="Group"
                      placeholder="Select or create group"
                      autocomplete="off"
                      spellcheck="false"
                      value="@Model.Activity.ActivityGroupTitle"
                      data-activity-group-input />
               <input asp-for="Activity.ActivityGroupId"
                      type="hidden"
                      data-activity-group-id />
               <input asp-for="Activity.ActivityGroupTitle"
                      type="hidden"
                      data-activity-group-title />
               <div class="broadcast-org-entity-suggestions"
                    data-activity-group-suggestions
                    hidden></div>
            </div>
         </label>
      </div>
      <div class="form-grid">
         <label>
            <span>Title</span>
            <input asp-for="Activity.Title" />
            <span asp-validation-for="Activity.Title"></span>
         </label>
         <label>
            <span>Activity type</span>
            <select asp-for="Activity.ActivityType">
               <option value="">Select activity type</option>
               @foreach (var type in Model.ActivityTypes)
               {
                  <option value="@type.Id">@type.Label</option>
               }
            </select>
            <span asp-validation-for="Activity.ActivityType"></span>
         </label>
         <label>
            <span>Date</span>
            <input asp-for="Activity.ActivityDate" type="date" />
            @await Html.PartialAsync("/Pages/Shared/_AdminDateStepper.cshtml")
            <span asp-validation-for="Activity.ActivityDate"></span>
         </label>
         <div class="activity-time-fields">
            <label>
               <span>Start</span>
               <input asp-for="Activity.LocalStartTime" type="time" />
               <span asp-validation-for="Activity.LocalStartTime"></span>
            </label>
            <label>
               <span>End</span>
               <input asp-for="Activity.LocalEndTime" type="time" />
               <span asp-validation-for="Activity.LocalEndTime"></span>
            </label>
         </div>
         <label>
            <span>Sport</span>
            <select asp-for="Activity.SportId">
               <option value="">Select sport</option>
               @foreach (var sport in Model.Sports)
               {
                  <option value="@sport.Id">@sport.Label</option>
               }
            </select>
            <span asp-validation-for="Activity.SportId"></span>
         </label>
         <label>
            <span>TV channel</span>
            <input asp-for="Activity.TvChannelName" />
            <span asp-validation-for="Activity.TvChannelName"></span>
         </label>
      </div>
      <label>
         <span>Description</span>
         <textarea asp-for="Activity.Description"
                   class="medium-textarea"
                   rows="3"></textarea>
      </label>
      @if(Model.OtherGroupDescriptions.Count > 0)
      {
         <div class="activity-group-description-options">
            @string.Join(", ", Model.OtherGroupDescriptions)
         </div>
      }
      <h3 class="subgrid-heading">Facts</h3>
      <div data-activity-facts-grid>
         @if(Model.Facts.Count == 0)
         {
            <div class="notice">No facts.</div>
         }
         else
         {
            <div class="admin-table-wrap">
               <table class="admin-table admin-table-compact
                             activity-facts-table">
                  <colgroup>
                     <col class="activity-facts-date-column" />
                     <col />
                     <col />
                     <col class="activity-facts-actions-column" />
                  </colgroup>
                  <thead>
                     <tr>
                        <th>Date</th>
                        <th>Fact</th>
                        <th>Source</th>
                        <th></th>
                     </tr>
                  </thead>
                  <tbody>
                     @foreach(var fact in Model.Facts)
                     {
                        var deleteFactFormId =
                           $"delete-fact-{fact.Id:N}";
                        <tr>
                           <td>
                              @fact.CreatedAt.ToString(
                                 DateDisplay.DateOnlyFormat
                              )
                           </td>
                           <td>@fact.Text</td>
                           <td>
                              @foreach(var sourceUrl in fact.SourceUrls)
                              {
                                 <a class="source-url"
                                    href="@sourceUrl"
                                    target="_blank"
                                    rel="noopener noreferrer">
                                    @sourceUrl
                                 </a>
                              }
                           </td>
                           <td class="table-actions">
                              <button type="submit"
                                      form="@deleteFactFormId">
                                 Delete
                              </button>
                           </td>
                        </tr>
                     }
                  </tbody>
               </table>
            </div>
         }
      </div>
      <label style="display: none;">
         <span>Teaser</span>
         <textarea asp-for="Activity.Teaser"
                   class="medium-textarea"
                   rows="3"
                   style="display: none;"
                   data-teaser-output></textarea>
      </label>
      <div class="button-row" style="display: none;">
         <button class="button"
                 type="button"
                 data-generate-teaser
                 data-teaser-url="@generateTeaserUrl">
            Generate Teaser
         </button>
         <span class="form-status" data-teaser-status></span>
      </div>
   </section>

   <section class="form-section">
      <h2>Participants</h2>
      <div class="activity-participant-picker"
           data-activity-participant-picker
           data-activity-participant-search-url="@participantSearchUrl"
           data-activity-id="@Model.Activity.Id"
           data-organization-entity-id=
              "@Model.Activity.OrganizationEntityId">
         <input class="broadcast-org-entity-input"
                type="text"
                aria-label="Participant"
                placeholder="Add participant"
                autocomplete="off"
                spellcheck="false"
                data-activity-participant-input />
         <input type="hidden"
                data-activity-participant-id />
         <div class="broadcast-org-entity-suggestions"
              data-activity-participant-suggestions
              hidden></div>
      </div>
      <span asp-validation-for="Activity.LinkedEntityIds"></span>
      @await Html.PartialAsync(
         "_ActivityParticipantSelection",
         new ActivityParticipantSelectionViewModel(
            Model.Participants,
            Model.Activity.Id
         )
      )
   </section>

   <section class="form-section"
            data-ai-result-edit-url="@aiResultValueUrl">
      <h2>AI results</h2>
      @if(Model.AiResults.Count == 0)
      {
         <div class="notice">
            No AI results yet.
         </div>
      }
      else
      {
         @foreach(var result in Model.AiResults)
         {
            <details class="activity-ai-result-details"
                     data-activity-ai-result-set
                     data-activity-ai-result-job-id="@result.JobId"
                     data-activity-ai-result-run-id="@result.RunId"
                     open>
               <summary class="activity-ai-result-summary">
                  <strong>@result.JobLabel</strong>
                  <span class="activity-ai-result-summary-meta">
                     @if(result.RunStatusId is not null)
                     {
                        <code>@result.RunStatusId</code>
                     }
                     @if(!string.IsNullOrWhiteSpace(result.ResultSummary))
                     {
                        <span>@result.ResultSummary</span>
                     }
                     @if(result.RunId is Guid runId)
                     {
                        var runDetailsUrl = Url.Page(
                           "/Admin/Runs/Details",
                           new { id = runId }
                        );
                        <a href="@runDetailsUrl">Run details</a>
                     }
                     <span>
                        @TimeDisplay.FormatLocalTimestamp(
                           result.UpdatedAt
                        )
                     </span>
                  </span>
               </summary>
               @if(result.Values.Count == 0)
               {
                  <div class="notice">
                     No structured values were saved.
                  </div>
               }
               else
               {
                  <div class="admin-table-wrap">
                     <table class="admin-table admin-table-compact
                                   activity-ai-result-table">
                        <colgroup>
                           <col class="activity-ai-result-entity-column" />
                           <col class="activity-ai-result-field-column" />
                           <col class="activity-ai-result-value-column" />
                        </colgroup>
                        <thead>
                           <tr>
                              <th>Participant</th>
                              <th>Field</th>
                              <th>Value</th>
                           </tr>
                        </thead>
                        <tbody>
                           @foreach(var value in result.Values)
                           {
                              var valueFieldLabel =
                                 string.IsNullOrWhiteSpace(value.FieldKey)
                                    ? "value"
                                    : value.FieldKey.Replace('_', ' ');
                              var valuePlaceholder =
                                 $"Add {valueFieldLabel}..";
                              var valueEmpty = string.IsNullOrWhiteSpace(
                                 value.ValueText
                              );
                              <tr>
                                 <td>
                                    <a asp-page="/Admin/Entities/Edit"
                                       asp-route-id="@value.EntityId">
                                       @value.EntityName
                                    </a>
                                 </td>
                                 <td><code>@value.FieldKey</code></td>
                                 <td class="activity-ai-result-inline-editable"
                                     data-ai-result-edit-field="value"
                                     data-ai-result-value-id=
                                        "@value.Id"
                                     data-ai-result-placeholder=
                                        "@valuePlaceholder"
                                     title="Double-click to edit">
                                    <div class="@(valueEmpty
                                       ? "inline-edit-placeholder"
                                       : null)"
                                       data-ai-result-edit-display>
                                       @(valueEmpty
                                          ? valuePlaceholder
                                          : value.ValueText)
                                    </div>
                                    <input
                                       class=
                                          "activity-ai-result-inline-edit-input"
                                       data-ai-result-edit-input
                                       type="text"
                                       value="@value.ValueText"
                                       autocomplete="off"
                                       spellcheck="false"
                                       aria-label="Edit AI result value"
                                       hidden />
                                 </td>
                              </tr>
                           }
                        </tbody>
                    </table>
                  </div>
               }
            </details>
         }
      }
   </section>

   <section class="form-section">
      <h2>Sources</h2>
      @if(Model.SourceError is not null)
      {
         <div class="notice notice-error">@Model.SourceError</div>
      }
      @if(Model.SourceMessage is not null)
      {
         <div class="notice">@Model.SourceMessage</div>
      }
      @if(Model.Activity.Sources.Count == 0)
      {
         <div class="notice">
            No related sources.
         </div>
      }
      else
      {
         <div class="admin-table-wrap">
            <table class="admin-table admin-table-compact
                          entity-sources-table">
               <colgroup>
                  <col class="source-observed-column" />
                  <col class="source-kind-column" />
                  <col class="source-url-column" />
                  <col class="source-title-column" />
               </colgroup>
               <thead>
                  <tr>
                     <th>Observed at</th>
                     <th>Kind</th>
                     <th>Source</th>
                     <th>Title</th>
                  </tr>
               </thead>
               <tbody>
                  @for(var index = 0;
                     index < Model.Activity.Sources.Count;
                     index++)
                  {
                     var source = Model.Activity.Sources[index];
                     <tr>
                        <td>
                           @if(source.Id is null)
                           {
                              <input
                                 asp-for="Activity.Sources[index].Kind"
                                 type="hidden" />
                              <input
                                 asp-for="Activity.Sources[index].Url"
                                 type="hidden" />
                              <input
                                 asp-for="Activity.Sources[index].Title"
                                 type="hidden" />
                              <input
                                 asp-for="Activity.Sources[index].Excerpt"
                                 type="hidden" />
                           }
                           @TimeDisplay.FormatLocalTimestamp(
                              source.ObservedAt
                           )
                        </td>
                        <td>@source.Kind</td>
                        <td>
                           <a class="source-url"
                              href="@source.Url"
                              target="_blank"
                              rel="noopener noreferrer">
                              @source.Url
                           </a>
                        </td>
                        <td>@source.Title</td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      }
      @if(Model.Activity.Id is not null)
      {
         <div class="activity-source-add-row">
            <label>
               <span>URL</span>
               <input type="url"
                      name="sourceUrl"
                      form="add-activity-source-form"
                      placeholder="https://"
                      required />
            </label>
            <button class="button"
                    type="submit"
                    form="add-activity-source-form">
               Add source
            </button>
         </div>
      }
   </section>

   <section class="form-actions">
      <label class="check-row">
         <input asp-for="Activity.IsPublished" type="checkbox" />
         <span>Published</span>
      </label>
      <button class="button button-primary"
              type="submit"
              asp-page-handler="Save">
         Save
      </button>
   </section>
</form>

@foreach(var fact in Model.Facts)
{
   var deleteFactFormId = $"delete-fact-{fact.Id:N}";
   <form id="@deleteFactFormId"
         method="post"
         asp-page-handler="DeleteFact"
         asp-route-id="@Model.Activity.Id"
         asp-route-factId="@fact.Id"
         onsubmit="return confirm('Are you sure?');">
      <input asp-for="ReturnUrl" type="hidden" />
   </form>
}

@if(Model.Activity.Id is not null)
{
   <form id="add-participant-form"
         method="post"
         asp-page-handler="AddParticipant"
         asp-route-id="@Model.Activity.Id">
      <input asp-for="ReturnUrl" type="hidden" />
      <input type="hidden"
             name="organizationEntityId"
             value="@Model.Activity.OrganizationEntityId" />
      <input type="hidden"
             name="entityId"
             data-add-participant-entity-id />
   </form>

   @foreach(var participant in Model.Participants)
   {
      var deleteFormId = $"delete-participant-{participant.Id:N}";
      var statusFormId = $"status-participant-{participant.Id:N}";
      <form id="@statusFormId"
            method="post"
            asp-page-handler="SetParticipantActive"
            asp-route-id="@Model.Activity.Id"
            asp-route-entityId="@participant.Id"
            asp-route-isActive="@(!participant.IsActive)">
         <input asp-for="ReturnUrl" type="hidden" />
      </form>
      <form id="@deleteFormId"
            method="post"
            asp-page-handler="DeleteParticipant"
            asp-route-id="@Model.Activity.Id"
            asp-route-entityId="@participant.Id"
            onsubmit="return confirm('Sure?');">
         <input asp-for="ReturnUrl" type="hidden" />
      </form>
   }
}

@section Scripts {
   <script src="~/Admin/js/activity-group-autocomplete.js"
           asp-append-version="true"></script>
   <script src="~/Admin/js/activity-participants.js"
           asp-append-version="true"></script>
}
