@page
@model SESport.Web.Pages.Admin.Runs.IndexModel
@{
   ViewData["Title"] = "Runs";
   var runStatusesUrl = Url.Page("/Admin/Ajax/Poll/RunStatuses");
   var runFieldUrl = Url.Page("/Admin/Ajax/Update/RunField");
}

<section class="page-heading page-heading-row">
   <div>
      <h1>Runs</h1>
   </div>
</section>

<form method="get" class="edit-form">
   <section class="form-section">
      <h2>Filters</h2>
      <div class="form-grid ai-runs-filter-grid">
         <label>
            <span>Date</span>
            <input type="date"
                   name="@RouteKeys.Date"
                   value="@Model.DateText"
                   onchange="submitFilterForm(this);" />
         </label>
         <label>
            <span>Job</span>
            <select name="@RouteKeys.JobId"
                    asp-items="Model.JobOptions"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
         <label>
            <span>Status</span>
            <select name="@RouteKeys.Status"
                    class="ai-runs-status-select"
                    multiple="multiple"
                    size="1"
                    onchange="submitFilterForm(this);"
                    asp-items="Model.StatusOptions">
            </select>
         </label>
      </div>
   </section>
</form>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<div class="admin-table-wrap"
     data-run-statuses-url="@runStatusesUrl"
     data-run-inline-edit-url="@runFieldUrl">
   <table class="admin-table admin-table-hover ai-runs-table">
      <colgroup>
         <col class="ai-runs-col-started" />
         <col class="ai-runs-col-env-job-prov" />
         <col class="ai-runs-col-event" />
         <col class="ai-runs-col-payload" />
         <col class="ai-runs-col-rounds" />
         <col class="ai-runs-col-duration" />
         <col class="ai-runs-col-status" />
         <col class="ai-runs-col-actions" />
      </colgroup>
      <thead>
         <tr>
            <th>Started</th>
            <th>ENV/JOB/PROV</th>
            <th>Event</th>
            <th>Max Payload</th>
            <th>Rounds</th>
            <th>Duration</th>
            <th>Status</th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach (var run in Model.Runs)
         {
            var canEditExecutionEnvironment = string.Equals(
               run.StatusId,
               "pending",
               StringComparison.Ordinal
            );
            <tr data-ai-run-id="@run.Id"
                data-ai-run-status="@run.StatusId">
               <td>
                  <div class="ai-runs-cell-stack">
                     <span>@TimeDisplay.FormatLocalDate(run.StartedAt)</span>
                     <span class="ai-runs-cell-secondary">
                        @TimeDisplay.FormatLocalTime(run.StartedAt)
                     </span>
                  </div>
               </td>
               <td class="ai-runs-inline-edit-cell"
                   data-run-inline-edit-field="execution-environment"
                   data-run-inline-edit-value="@run.ExecutionEnvironment"
                   title="@(canEditExecutionEnvironment
                              ? "Double-click to edit"
                              : null)">
                  <div class="ai-runs-cell-stack" data-run-inline-edit-display>
                     <span class="ai-runs-environment"
                           title="@run.ExecutionEnvironment">
                        @DetailsModel.FormatExecutionEnvironmentDisplayName(
                           run.ExecutionEnvironment
                        )
                     </span>
                     <span>@run.JobLabel</span>
                     <span class="ai-runs-cell-secondary">
                        @run.ProviderLabel
                        @if(!string.IsNullOrWhiteSpace(run.ProviderModel))
                        {
                           <span> (@run.ProviderModel)</span>
                        }
                     </span>
                  </div>
                  <select class="ai-runs-inline-edit-input"
                          data-run-inline-edit-input
                          asp-items=
                             "Model.GetExecutionEnvironmentOptions(
                                run.ExecutionEnvironment
                             )"
                          hidden>
                  </select>
               </td>
               <td>@run.EventName</td>
               <td data-ai-run-payload-cell>
                  @run.MaxPayloadCharacterCount
               </td>
               <td data-ai-run-rounds-cell>
                  @run.ToolRoundCount
               </td>
               <td data-ai-run-duration-cell>
                  @DetailsModel.FormatDuration(run)
               </td>
               <td data-ai-run-status-cell>
                  <code data-ai-run-status-text>@run.StatusId</code>
               </td>
               <td class="table-actions">
                  <div class="ai-runs-table-actions">
                     <a href="@Url.Page(
                              "/Admin/Runs/Details",
                              Model.GetDetailsRouteValues(run.Id)
                           )">
                        View
                     </a>
                     <form method="post"
                           action="@Url.Page(
                                 "/Admin/Runs/Index",
                                 "Delete",
                                 Model.GetDeleteRouteValues(run.Id)
                              )"
                           onsubmit="return confirm('Sure?');">
                        @Html.AntiForgeryToken()
                        <button type="submit">Delete</button>
                     </form>
                  </div>
               </td>
            </tr>
         }
      </tbody>
   </table>
</div>
