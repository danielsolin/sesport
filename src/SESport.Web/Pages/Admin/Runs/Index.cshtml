@page
@model SESport.Web.Pages.Admin.Runs.IndexModel
@using SESport.Core.AI
@{
   ViewData["Title"] = "Runs";
   var runStatusesUrl = Url.Page("/Admin/Ajax/Poll/RunStatuses");
}

<section class="page-heading page-heading-row">
   <div>
      <h1>Runs</h1>
   </div>
</section>

<form method="get" class="edit-form">
   <section class="form-section">
      <h2>Filters</h2>
      <div class="form-grid ai-runs-filter-grid">
         <label>
            <span>Date</span>
            <input type="date"
                   name="@RouteKeys.Date"
                   value="@Model.DateText"
                   onchange="submitFilterForm(this);" />
         </label>
         <label>
            <span>Job</span>
            <select name="@RouteKeys.JobId"
                    asp-items="Model.JobOptions"
                    onchange="submitFilterForm(this);">
            </select>
         </label>
         <label>
            <span>Status</span>
            <select name="@RouteKeys.Status"
                    class="ai-runs-status-select"
                    multiple="multiple"
                    size="1"
                    onchange="submitFilterForm(this);"
                    asp-items="Model.StatusOptions">
            </select>
         </label>
      </div>
   </section>
</form>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}

<div class="admin-table-wrap"
     data-run-statuses-url="@runStatusesUrl">
   <table class="admin-table admin-table-hover ai-runs-table">
      <colgroup>
         <col class="ai-runs-col-started" />
         <col class="ai-runs-col-job" />
         <col class="ai-runs-col-event" />
         <col class="ai-runs-col-payload" />
         <col class="ai-runs-col-rounds" />
         <col class="ai-runs-col-duration" />
         <col class="ai-runs-col-status" />
         <col class="ai-runs-col-actions" />
      </colgroup>
      <thead>
         <tr>
            <th>Started</th>
            <th>JOB</th>
            <th>For</th>
            <th>MAX-CHARS</th>
            <th>Rounds</th>
            <th>Duration</th>
            <th>Status</th>
            <th></th>
         </tr>
      </thead>
      <tbody>
         @foreach (var run in Model.Runs)
         {
            var jobCode = string.Concat(
               run.JobLabel
                  .Split('-', StringSplitOptions.RemoveEmptyEntries)
                  .Select(part => char.ToLowerInvariant(part[0]))
            );
            var runTarget = IndexModel.FormatRunTargetLabel(run);
            <tr data-ai-run-id="@run.Id"
                data-ai-run-status="@run.StatusId">
               <td class="ai-runs-started-cell">
                  @TimeDisplay.FormatLocalDate(run.StartedAt)
                  @TimeDisplay.FormatLocalTime(run.StartedAt)
               </td>
               <td class="ai-runs-job-cell"
                   title="@run.JobLabel">@jobCode</td>
               <td>
                  <strong>@runTarget:</strong> @run.EventName
               </td>
               <td data-ai-run-payload-cell>
                  @run.MaxPayloadCharacterCount
               </td>
               <td data-ai-run-rounds-cell>
                  @run.ToolRoundCount
               </td>
               <td data-ai-run-duration-cell>
                  @DetailsModel.FormatDuration(run)
               </td>
               <td data-ai-run-status-cell>
                  <code data-ai-run-status-text>@run.StatusId</code>
               </td>
               <td class="table-actions">
                  <div class="ai-runs-table-actions">
                     <a href="@Url.Page(
                              "/Admin/Runs/Details",
                              Model.GetDetailsRouteValues(run.Id)
                           )">
                        View
                     </a>
                     <form method="post"
                           action="@Url.Page(
                                 "/Admin/Runs/Index",
                                 "Delete",
                                 Model.GetDeleteRouteValues(run.Id)
                              )"
                           onsubmit="return confirm('Sure?');">
                        @Html.AntiForgeryToken()
                        <button type="submit">Delete</button>
                     </form>
                  </div>
               </td>
            </tr>
         }
      </tbody>
   </table>
</div>
