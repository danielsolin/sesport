@page "{id:guid}"
@model SESport.Web.Pages.Admin.Runs.DetailsModel
@{
   ViewData["Title"] = "Run";
}

<section class="page-heading page-heading-row">
   <div>
      <h1>Run</h1>
   </div>
   <a class="button"
      asp-page="./Index"
      asp-all-route-data="@Model.GetFilterRouteValues()">
      Back
   </a>
</section>

@if(Model.Run is not null)
{
   <section class="form-section">
      <h2>Summary</h2>
      <dl class="detail-grid">
         <div>
            <dt>Status</dt>
            <dd><code>@Model.Run.StatusId</code></dd>
         </div>
         <div>
            <dt>Execution Environment</dt>
            <dd>
               <form method="post"
                     asp-page-handler="UpdateExecutionEnvironment"
                     asp-route-id="@Model.Run.Id"
                     asp-all-route-data="@Model.GetFilterRouteValues()"
                     class="button-row run-execution-environment-form">
                  @if(Model.CanEditExecutionEnvironment)
                  {
                     <select asp-for="ExecutionEnvironment"
                             asp-items="Model.ExecutionEnvironmentOptions">
                     </select>
                     <button class="button button-primary" type="submit">
                        Save
                     </button>
                  }
                  else
               {
                  <select asp-for="ExecutionEnvironment"
                          asp-items="Model.ExecutionEnvironmentOptions"
                          disabled>
                  </select>
               }
               </form>
               @if(Model.LoadError is not null)
               {
                  <div class="notice notice-warning">
                     @Model.LoadError
                  </div>
               }
            </dd>
         </div>
         <div>
            <dt>Job</dt>
            <dd>@Model.Run.JobLabel</dd>
         </div>
         <div>
            <dt>Prompt version</dt>
            <dd>@Model.Run.PromptVersion</dd>
         </div>
         <div>
            <dt>Provider</dt>
            <dd>@Model.Run.ProviderLabel</dd>
         </div>
         <div>
            <dt>Model</dt>
            <dd>@Model.Run.ProviderModel</dd>
         </div>
         <div>
            <dt>Temperature</dt>
            <dd>@DetailsModel.FormatTemperature(Model.Run)</dd>
         </div>
         <div>
            <dt>Max output tokens</dt>
            <dd>@DetailsModel.FormatMaxOutputTokens(Model.Run)</dd>
         </div>
         <div>
            <dt>Max tool rounds</dt>
            <dd>@DetailsModel.FormatMaxToolRounds(Model.Run)</dd>
         </div>
         <div>
            <dt>Min tool rounds</dt>
            <dd>@DetailsModel.FormatMinToolRounds(Model.Run)</dd>
         </div>
         <div>
            <dt>Started</dt>
            <dd>@TimeDisplay.FormatLocalTimestamp(Model.Run.StartedAt)</dd>
         </div>
         <div>
            <dt>Completed</dt>
            <dd>
               @(
                  Model.Run.CompletedAt is null
                     ? ""
                     : TimeDisplay.FormatLocalTimestamp(
                        Model.Run.CompletedAt.Value
                     )
               )
            </dd>
         </div>
         <div>
            <dt>Duration</dt>
            <dd>
               @DetailsModel.FormatDuration(Model.Run)
            </dd>
         </div>
         <div>
            <dt>Tool rounds</dt>
            <dd>@DetailsModel.GetToolRoundCount(Model.Run)</dd>
         </div>
         <div>
            <dt>Final payload chars</dt>
            <dd>@Model.Run.ConversationCharacterCount</dd>
         </div>
         <div>
            <dt>Max payload chars</dt>
            <dd>@DetailsModel.GetMaxPayloadCharacterCount(Model.Run)</dd>
         </div>
         <div>
            <dt>Include Social Media</dt>
            <dd>@Model.Run.JobIncludeSocialMedia</dd>
         </div>
         @if(Model.Run.InputTokens is not null)
         {
            <div>
               <dt>Input tokens</dt>
               <dd>@Model.Run.InputTokens</dd>
            </div>
         }
         @if(Model.Run.OutputTokens is not null)
         {
            <div>
               <dt>Output tokens</dt>
               <dd>@Model.Run.OutputTokens</dd>
            </div>
         }
         @if(Model.Run.ReasoningTokens is not null)
         {
            <div>
               <dt>Reasoning tokens</dt>
               <dd>@Model.Run.ReasoningTokens</dd>
            </div>
         }
      </dl>
   </section>

   <div class="run-tool-trace-host"
        data-run-tool-trace
        data-run-status="@Model.Run.StatusId"
        data-url="@Url.Page(
           "/Admin/Ajax/Poll/RunToolTrace",
           new { id = Model.Run.Id }
        )">
      <section class="form-section">
         <div class="run-tool-trace-loading" role="status">
            <span class="run-tool-trace-spinner" aria-hidden="true"></span>
            <span data-run-tool-trace-status>
               Loading tool trace…
            </span>
         </div>
      </section>
   </div>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Conversation history summary</summary>
         <pre class="prompt-details-pre">
@((Model.ConversationHistorySummaryText ?? string.Empty).Trim())
            </pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Output</summary>
         <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.OutputText)
         </pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Raw final request</summary>
         <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.RawRequestJson)
         </pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Raw final response</summary>
         <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.RawResponseJson)
         </pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>System prompt</summary>
         <pre class="prompt-details-pre">@Model.SystemPromptText</pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Rendered prompt</summary>
         <pre class="prompt-details-pre">@Model.RenderedPromptText</pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>Input payload</summary>
         <pre class="prompt-details-pre">
@DetailsModel.FormatJson(Model.Run.InputPayloadJson)
         </pre>
      </details>
   </section>

   <section class="form-section">
      <details class="run-data-details">
         <summary>User prompt template</summary>
         <pre class="prompt-details-pre">@Model.UserPromptTemplateText</pre>
      </details>
   </section>

   @if(!string.IsNullOrWhiteSpace(Model.Run.ErrorMessage))
   {
      <section class="form-section">
         <h2>Error</h2>
         <pre class="prompt-details-pre">@Model.Run.ErrorMessage</pre>
      </section>
   }
}

@section Scripts {
   <script src="~/js/run-tool-trace.js"
           asp-append-version="true"></script>
}
