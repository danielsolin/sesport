@page
@model SESport.Web.Pages.Admin.Dashboard.IndexModel
@{
   ViewData["Title"] = "Dashboard";
}

<section class="page-heading">
   <h1>Dashboard</h1>
</section>

@if(Model.LoadError is not null)
{
   <div class="notice notice-warning">
      @Model.LoadError
   </div>
}
else if(Model.Dashboard is not null)
{
   var dashboard = Model.Dashboard;
   var dashboardReturnUrl = Url.Page(
      "/Admin/Dashboard/Index"
   ) ?? "/Admin/Dashboard";

   <section class="dashboard-section">
      <div class="dashboard-section-heading">
         <div>
            <h2>Activities needing attention</h2>
         </div>
      </div>
      @if(dashboard.ActivityIssues.Count == 0)
      {
         <div class="notice">
            No upcoming activity issues.
         </div>
      }
      else
      {
         <div class="admin-table-wrap">
            <table class="admin-table admin-table-hover">
               <thead>
                  <tr>
                     <th>Date</th>
                     <th>Activity</th>
                     <th>Needs attention</th>
                  </tr>
               </thead>
               <tbody>
                  @foreach(var issue in dashboard.ActivityIssues)
                  {
                     <tr>
                        <td>
                           @issue.Date.ToString(DateDisplay.DateOnlyFormat)
                        </td>
                        <td>
                           <a asp-page="/Admin/Activities/Edit"
                              asp-route-id="@issue.Id"
                              asp-route-returnUrl="@dashboardReturnUrl">
                              @issue.Title
                           </a>
                        </td>
                        <td>
                           <div class="dashboard-issue-list">
                              @foreach(
                                 var label in IndexModel.GetIssueLabels(issue)
                              )
                              {
                                 <span class="status-pill">@label</span>
                              }
                           </div>
                        </td>
                     </tr>
                  }
               </tbody>
            </table>
         </div>
      }
   </section>

   <section class="dashboard-section">
      <div class="dashboard-section-heading">
         <div>
            <h2>Upcoming coverage</h2>
         </div>
      </div>
      <div class="admin-table-wrap">
         <table class="admin-table admin-table-compact
                       admin-table-hover dashboard-date-table">
            <thead>
               <tr>
                  <th class="dashboard-date-label">Date</th>
                  <th>Broadcasts</th>
                  <th>Unreviewed</th>
                  <th>Published</th>
               </tr>
            </thead>
            <tbody>
               @foreach(var date in dashboard.Dates)
               {
                  <tr class="@(IndexModel.GetDateRowClass(date))">
                     <td class="dashboard-date-label">
                        <strong>
                           <a asp-page="/Admin/Broadcasts/Index"
                              asp-all-route-data=
                                 "@Model.GetBroadcastDateRouteValues(
                                    date.Date
                                 )">
                              @date.Date.ToString(
                                 DateDisplay.DateOnlyFormat
                              )
                           </a>
                        </strong>
                     </td>
                     <td>
                        <a asp-page="/Admin/Broadcasts/Index"
                           asp-all-route-data=
                              "@Model.GetBroadcastDateRouteValues(date.Date)">
                           @date.VisibleBroadcastCount
                        </a>
                     </td>
                     <td>
                        <a asp-page="/Admin/Broadcasts/Index"
                           asp-all-route-data=
                              "@Model.GetBroadcastDateRouteValues(date.Date)">
                           @date.UnreviewedBroadcastCount
                        </a>
                     </td>
                     <td>
                        <a asp-page="/Admin/Activities/Index"
                           asp-all-route-data=
                              "@Model.GetActivityDateRouteValues(date.Date)">
                           @date.PublishedActivityCount
                        </a>
                     </td>
                  </tr>
               }
            </tbody>
         </table>
      </div>
   </section>

   <section class="dashboard-section">
      <div class="dashboard-health-grid">
         <article class="dashboard-health-card">
            <h3>AI runs</h3>
            @if(!Model.AiNeedsAttention)
            {
               <p class="dashboard-health-ok">No current AI alerts.</p>
            }
            <dl class="dashboard-health-list">
               <div>
                  <dt>Pending</dt>
                  <dd>
                     <span class="dashboard-health-count
                                  dashboard-health-count-pending">
                        @dashboard.AiHealth.PendingCount
                     </span>
                  </dd>
               </div>
               <div>
                  <dt>Running</dt>
                  <dd>
                     <span class="dashboard-health-count
                                  dashboard-health-count-running">
                        @dashboard.AiHealth.RunningCount
                     </span>
                  </dd>
               </div>
               <div>
                  <dt>Failed, last 25 hours</dt>
                  <dd>
                     @if(dashboard.AiHealth.FailedLast25HoursCount > 0)
                     {
                        <a class="dashboard-health-count
                                 dashboard-health-count-failed"
                           asp-page="/Admin/Runs/Index"
                           asp-all-route-data=
                              "@Model.GetFailedRunRouteValues()">
                           @dashboard.AiHealth.FailedLast25HoursCount
                        </a>
                     }
                     else
                     {
                        @dashboard.AiHealth.FailedLast25HoursCount
                     }
                  </dd>
               </div>
            </dl>
         </article>
         <article class="dashboard-health-card">
            <h3>Broadcast imports</h3>
            @if(dashboard.ImportHealth is null)
            {
               <p class="notice notice-warning">
                  No broadcast import found.
               </p>
            }
            else
            {
               @if(!Model.ImportNeedsAttention)
               {
                  <p class="dashboard-health-ok">
                     Latest import completed.
                  </p>
               }
               <dl class="dashboard-health-list">
                  <div>
                     <dt>Status</dt>
                     <dd>@dashboard.ImportHealth.Status</dd>
                  </div>
                  <div>
                     <dt>Imported</dt>
                     <dd>@dashboard.ImportHealth.BroadcastCount</dd>
                  </div>
                  <div>
                     <dt>Started</dt>
                     <dd>
                        @TimeDisplay.FormatLocalTimestamp(
                           dashboard.ImportHealth.StartedAt
                        )
                     </dd>
                  </div>
               </dl>
            }
         </article>
      </div>
   </section>

}
