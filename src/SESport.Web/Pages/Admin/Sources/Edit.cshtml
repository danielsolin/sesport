@page "{id?}"
@model SESport.Web.Pages.Admin.Sources.EditModel
@{
   ViewData["Title"] = Model.Source.OriginalId is null
      ? "New Source"
      : "Edit Source";
}

<section class="page-heading page-heading-row">
   <div>
      <p class="eyebrow">Admin</p>
      <h1>@ViewData["Title"]</h1>
   </div>
   <a class="button" asp-page="./Index">Back</a>
</section>

@if (Model.LoadError is not null)
{
   <div class="notice notice-warning">@Model.LoadError</div>
}

<form method="post" class="edit-form">
   <input asp-for="Source.OriginalId" type="hidden" />
   <div asp-validation-summary="ModelOnly" class="notice notice-error"></div>

   <section class="form-section">
      <h2>Source</h2>
      <div class="form-grid">
         <label>
            <span>ID</span>
            <input asp-for="Source.Id"
                   readonly="@(Model.Source.OriginalId is not null)" />
            <span asp-validation-for="Source.Id"></span>
         </label>
         <label>
            <span>Name</span>
            <input asp-for="Source.Name" />
            <span asp-validation-for="Source.Name"></span>
         </label>
      </div>
   </section>

   <section class="form-actions">
      <button class="button button-primary" type="submit">Save</button>
   </section>
</form>
