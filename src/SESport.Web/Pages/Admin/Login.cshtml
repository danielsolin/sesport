@page
@model SESport.Web.Pages.Admin.LoginModel
@{
   ViewData["Title"] = "Admin Login";
}

<section class="login-panel">
   <p class="eyebrow">Admin</p>
   <h1>Sign in</h1>

   @if (Model.ErrorMessage is not null)
   {
      <div class="notice notice-warning">@Model.ErrorMessage</div>
   }

   <form method="post">
      <label>
         <span>Password</span>
         <input asp-for="Password" type="password" autofocus />
      </label>
      <button class="button button-primary" type="submit">Sign in</button>
   </form>
</section>
