{
   "type": "object",
   "title": "Participation",
   "required": [
      "Participation",
      "Participants",
      "Sources",
      "EvidenceType"
   ],
   "properties": {
      "Sources": {
         "type": "array",
         "items": {
            "type": "string",
            "format": "uri"
         },
         "minItems": 1,
         "description": "Source URLs that support the conclusion."
      },
      "Participants": {
         "type": "array",
         "items": { "type": "string" },
         "description": "The participant name or names."
      },
      "Participation": {
         "enum": [ "Yes", "No", "Unknown" ],
         "type": "string",
         "description": "Whether target-country participants are in the event."
      },
      "EvidenceType": {
         "enum": [
            "ParticipantList",
            "TeamRoster",
            "EventInfoOnly",
            "SearchOnly"
         ],
         "type": "string",
         "description": "The strongest evidence type behind the conclusion."
      }
   },
   "description": "Assessment of target-country event participation.",
   "additionalProperties": false
}
