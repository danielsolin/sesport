{
   "type": "object",
   "title": "Participation",
   "required": [
      "Participation",
      "Participants",
      "CheckedSources"
   ],
   "properties": {
      "Participants": {
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "Name",
               "Sources"
            ],
            "properties": {
               "Name": {
                  "type": "string",
                  "description": "The participant name only."
               },
               "Sources": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/SourceEvidence" },
                  "minItems": 1,
                  "description": "Sources that support this participant."
               }
            },
            "additionalProperties": false
         },
         "description": "The participant name or names with evidence."
      },
      "CheckedSources": {
         "type": "array",
         "items": { "$ref": "#/$defs/SourceEvidence" },
         "description": "Sources checked for the overall conclusion."
      },
      "Participation": {
         "enum": [ "Yes", "No", "Unknown" ],
         "type": "string",
         "description": "Whether target-country participants are in the event."
      }
   },
   "$defs": {
      "SourceEvidence": {
         "type": "object",
         "required": [
            "Url",
            "EvidenceType"
         ],
         "properties": {
            "Url": {
               "type": "string",
               "format": "uri"
            },
            "EvidenceType": {
               "enum": [
                  "ParticipantList",
                  "ParticipantMention",
                  "TeamRoster",
                  "EventInfoOnly",
                  "SearchOnly"
               ],
               "type": "string",
               "description": "The evidence type for this source."
            }
         },
         "additionalProperties": false
      }
   },
   "description": "Assessment of target-country event participation.",
   "additionalProperties": false
}
