{
   "type": "object",
   "title": "Participation",
   "required": [
      "Participation",
      "Participants",
      "CheckedSources"
   ],
   "properties": {
      "Participants": {
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "Name"
            ],
            "properties": {
               "Name": {
                  "type": "string",
                  "description": "The participant name only."
               }
            },
            "additionalProperties": false
         },
         "description": "The participant name or names only."
      },
      "CheckedSources": {
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "Url"
            ],
            "properties": {
               "Url": {
                  "type": "string",
                  "format": "uri"
               }
            },
            "additionalProperties": false
         },
         "description": "URL-only sources checked for the overall conclusion."
      },
      "Participation": {
         "enum": [ "Yes", "No", "Unknown" ],
         "type": "string",
         "description": "Whether target-country participants are in the event."
      }
   },
   "description": "Assessment of target-country event participation.",
   "additionalProperties": false
}
