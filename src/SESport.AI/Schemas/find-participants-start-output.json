{
   "type": "object",
   "title": "FindParticipantsStart",
   "required": [
      "status",
      "participants",
      "checked_sources"
   ],
   "properties": {
      "status": {
         "enum": [
            "Found",
            "Partial",
            "NotFound",
            "Unknown"
         ],
         "type": "string",
         "description": "Overall result for the participant start-time search."
      },
      "participants": {
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "name",
               "tee_time",
               "sources"
            ],
            "properties": {
               "name": {
                  "type": "string",
                  "description": "The participant name only."
               },
               "tee_time": {
                  "type": [
                     "string",
                     "null"
                  ],
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "The local tee time in HH:mm format."
               },
               "sources": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/SourceEvidence"
                  },
                  "description": "Sources for this participant's tee time."
               }
            },
            "additionalProperties": false
         },
         "description": "Participants in the same order as the activity input."
      },
      "checked_sources": {
         "type": "array",
         "items": {
            "$ref": "#/$defs/SourceEvidence"
         },
         "description": "Sources checked for the overall result."
      }
   },
   "$defs": {
      "SourceEvidence": {
         "type": "object",
         "required": [
            "url",
            "evidence_type"
         ],
         "properties": {
            "url": {
               "type": "string",
               "format": "uri"
            },
            "title": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "excerpt": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "evidence_type": {
               "enum": [
                  "StartList",
                  "ParticipantList",
                  "ParticipantMention",
                  "EventInfoOnly",
                  "SearchOnly"
               ],
               "type": "string",
               "description": "The evidence type for this source."
            }
         },
         "additionalProperties": false
      }
   },
   "description": "Assessment of participant start times for an activity.",
   "additionalProperties": false
}
