{
   "type": "object",
   "$defs": {
      "SourceEvidence": {
         "type": "object",
         "required": [
            "url"
         ],
         "properties": {
            "url": {
               "type": "string",
               "format": "uri"
            },
            "title": {
               "type": [
                  "string",
                  "null"
               ]
            },
            "excerpt": {
               "type": [
                  "string",
                  "null"
               ]
            }
         },
         "additionalProperties": false
      }
   },
   "title": "FindParticipantsStart",
   "required": [
      "participants",
      "checked_sources"
   ],
   "properties": {
      "participants": {
         "type": "array",
         "items": {
            "type": "object",
            "required": [
               "name",
               "start_time",
               "sources"
            ],
            "properties": {
               "name": {
                  "type": "string",
                  "description": "The participant name only."
               },
               "sources": {
                  "type": "array",
                  "items": {
                     "$ref": "#/$defs/SourceEvidence"
                  },
                  "description": "Sources for this participant\u0027s start time."
               },
               "start_time": {
                  "type": [
                     "string",
                     "null"
                  ],
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "The start time in HH:mm format."
               }
            },
            "additionalProperties": false
         },
         "description": "Participants in the same order as input."
      },
      "checked_sources": {
         "type": "array",
         "items": {
            "$ref": "#/$defs/SourceEvidence"
         },
         "description": "Sources checked for the overall result."
      }
   },
   "description": "Assessment of participant start times for an event.",
   "additionalProperties": false
}
