[Unit]
Description=SESport Unison two-way sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daniel
Group=daniel
Environment=HOME=/home/daniel
WorkingDirectory=/home/daniel/sesport
ExecStart=/usr/bin/unison sesport
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
