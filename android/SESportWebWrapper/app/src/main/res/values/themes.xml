<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SESportApp"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor"
            tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:navigationBarColor"
            tools:targetApi="l">?attr/colorSurface</item>
    </style>

    <style name="Theme.SESportApp.Splash"
        parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">
            @color/sesport_blue</item>
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">
            @color/sesport_blue</item>
        <item name="postSplashScreenTheme">
            @style/Theme.SESportApp</item>
    </style>
</resources>
