SESPORT_POSTGRES_HOST=<database_host>
SESPORT_POSTGRES_DB=<db_name>
SESPORT_POSTGRES_USER=<username>
SESPORT_POSTGRES_PASSWORD=<password>
SESPORT_POSTGRES_PORT=12345
SESPORT_AI_RUN_DIAGNOSTIC_RETENTION_DAYS=3

# Optional public source host blocklist. Repeat the indexed variable as needed.
# PublicSite__BlockedSourceHosts__0=<host>

PROXYING_ACCESS_URL=<proxying_access_url>

Admin__Password=<password>
MemberAuth__PublicBaseUrl=https://sesport.se
MemberPush__Subject=mailto:info@sesport.se
MemberPush__PublicKey=<vapid_public_key>
MemberPush__PrivateKey=<vapid_private_key>
Smtp__Host=
Smtp__Port=587
Smtp__UseSsl=true
Smtp__FromAddress=info@sesport.se
Smtp__FromName=sesport
SearXNG__BaseUrl=http://127.0.0.1:8088/
SESPORT_BRAVE_API_KEY=<brave_api_key>
